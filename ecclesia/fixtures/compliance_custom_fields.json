[
  {
    "doctype": "Custom Field",
    "name": "Payments-compliance_section",
    "dt": "Payments",
    "fieldname": "compliance_section",
    "fieldtype": "Section Break",
    "label": "Compliance & AML",
    "insert_after": "cashflow_type",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-compliance_obligation_type",
    "dt": "Payments",
    "fieldname": "compliance_obligation_type",
    "fieldtype": "Select",
    "label": "Obligation Type",
    "insert_after": "compliance_section",
    "options": "\nVAT\nWHT\nPAYE\nPension\nNHF\nNSITF\nITF\nCIT\nStamp Duty\nCapital Gains Tax\nCAC Annual Return\nRegulatory Return\nWork Permit\nEnvironmental Permit\nAML/KYC\nContractual Obligation\nTraining Levy\nOther",
    "description": "Set when making a compliance/statutory payment to enable CLL allocation"
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-compliance_fiscal_month",
    "dt": "Payments",
    "fieldname": "compliance_fiscal_month",
    "fieldtype": "Data",
    "label": "Compliance Period (MM-YYYY)",
    "insert_after": "compliance_obligation_type",
    "description": "Leave blank for auto FIFO allocation; set for exact-period payment"
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-col_break_compliance",
    "dt": "Payments",
    "fieldname": "col_break_compliance",
    "fieldtype": "Column Break",
    "insert_after": "compliance_fiscal_month"
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-compliance_allocated_amount",
    "dt": "Payments",
    "fieldname": "compliance_allocated_amount",
    "fieldtype": "Currency",
    "label": "Compliance Allocated Amount (₦)",
    "insert_after": "col_break_compliance",
    "description": "Amount to route to CLL. Defaults to amount_paid if blank."
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-compliance_cll_link",
    "dt": "Payments",
    "fieldname": "compliance_cll_link",
    "fieldtype": "Link",
    "label": "CLL Entry (auto-linked)",
    "options": "Compliance Liability Ledger",
    "insert_after": "compliance_allocated_amount",
    "read_only": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-aml_kyc_section",
    "dt": "Payments",
    "fieldname": "aml_kyc_section",
    "fieldtype": "Section Break",
    "label": "AML / KYC",
    "insert_after": "compliance_cll_link",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-aml_kyc_cleared",
    "dt": "Payments",
    "fieldname": "aml_kyc_cleared",
    "fieldtype": "Check",
    "label": "AML / KYC Cleared",
    "insert_after": "aml_kyc_section",
    "default": "0",
    "description": "Tick once KYC check is confirmed for this payment"
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-aml_kyc_record",
    "dt": "Payments",
    "fieldname": "aml_kyc_record",
    "fieldtype": "Link",
    "label": "AML KYC Record",
    "options": "AML KYC Record",
    "insert_after": "aml_kyc_cleared"
  },
  {
    "doctype": "Custom Field",
    "name": "Payments-aml_risk_flag",
    "dt": "Payments",
    "fieldname": "aml_risk_flag",
    "fieldtype": "Check",
    "label": "AML Risk Flagged",
    "insert_after": "aml_kyc_record",
    "default": "0",
    "description": "Set by system if transaction matches suspicious activity criteria"
  },
  {
    "doctype": "Custom Field",
    "name": "Receipts-aml_kyc_section",
    "dt": "Receipts",
    "fieldname": "aml_kyc_section",
    "fieldtype": "Section Break",
    "label": "AML / KYC",
    "insert_after": "deduct_wht",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Receipts-aml_kyc_cleared",
    "dt": "Receipts",
    "fieldname": "aml_kyc_cleared",
    "fieldtype": "Check",
    "label": "AML / KYC Cleared",
    "insert_after": "aml_kyc_section",
    "default": "0"
  },
  {
    "doctype": "Custom Field",
    "name": "Receipts-aml_kyc_record",
    "dt": "Receipts",
    "fieldname": "aml_kyc_record",
    "fieldtype": "Link",
    "label": "AML KYC Record",
    "options": "AML KYC Record",
    "insert_after": "aml_kyc_cleared"
  },
  {
    "doctype": "Custom Field",
    "name": "Receipts-aml_risk_flag",
    "dt": "Receipts",
    "fieldname": "aml_risk_flag",
    "fieldtype": "Check",
    "label": "AML Risk Flagged",
    "insert_after": "aml_kyc_record",
    "default": "0"
  },
  {
    "doctype": "Custom Field",
