    "description": "Link to the CLL entry if this finding relates to a statutory obligation"
  },
  {
    "doctype": "Custom Field",
    "name": "Audit Finding-compliance_incident_ref",
    "dt": "Audit Finding",
    "fieldname": "compliance_incident_ref",
    "fieldtype": "Link",
    "label": "Compliance Incident",
    "options": "Compliance Incident",
    "insert_after": "compliance_obligation_ref"
  },
  {
    "doctype": "Custom Field",
    "name": "Fixed Asset Maintenance-compliance_section",
