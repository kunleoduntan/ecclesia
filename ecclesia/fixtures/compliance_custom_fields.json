    "options": "\nStatutory Tax\nStatutory Payroll\nCorporate Governance\nContract Compliance\nData Protection\nAML & KYC\nLabour & Employment\nEnvironmental & HSE\nIndustry Regulatory\nAnti-Fraud & Integrity\nTraining & Competency\nGeneral",
    "insert_after": "category",
    "description": "Maps this policy to a GRC compliance domain for the ComplianceHQ dashboard"
  },
  {
    "doctype": "Custom Field",
    "name": "Company Policy-compliance_rule_ref",
    "dt": "Company Policy",
    "fieldname": "compliance_rule_ref",
