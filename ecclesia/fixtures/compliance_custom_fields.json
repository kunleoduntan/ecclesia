  },
  {
    "doctype": "Custom Field",
    "name": "Audit Finding-compliance_obligation_ref",
    "dt": "Audit Finding",
    "fieldname": "compliance_obligation_ref",
    "fieldtype": "Link",
    "label": "Compliance Liability Ledger",
    "options": "Compliance Liability Ledger",
