 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #7c3aed; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #7c3aed; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #7c3aed; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #7c3aed; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Reported { background: #fef9c3; color: #854d0e; }\n  .status-Investigating { background: #dbeafe; color: #1e40af; }\n  .status-Contained { background: #fef3c7; color: #92400e; }\n  .status-Remediated { background: #dcfce7; color: #166534; }\n  .status-Closed { background: #e2e8f0; color: #475569; }\n  .severity-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .sev-Critical { background: #fee2e2; color: #991b1b; }\n  .sev-High { background: #fef3c7; color: #92400e; }\n  .sev-Medium { background: #fef9c3; color: #854d0e; }\n  .sev-Low { background: #dcfce7; color: #166534; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .note-box { padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 10.5px; color: #475569; border-left: 3px solid #7c3aed; margin-top: 8px; }\n  .alert-box { background: #fef2f2; border-left: 3px solid #dc2626; padding: 8px 12px; border-radius: 6px; font-size: 10.5px; color: #991b1b; margin-top: 8px; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udd10 Data Breach Register</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">DBR #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Title:</span> <span class=\"value\">{{ doc.breach_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Severity:</span> <span class=\"value\"><span class=\"severity-badge sev-{{ doc.severity }}\">{{ doc.severity }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status }}\">{{ doc.status }}</span></span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Breach Date</span><span class=\"val\">{{ frappe.format_date(doc.breach_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Breach Type</span><span class=\"val\">{{ doc.breach_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Data Subjects Affected</span><span class=\"val\">{{ doc.data_subjects_affected or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Severity</span><span class=\"val\"><span class=\"severity-badge sev-{{ doc.severity }}\">{{ doc.severity }}</span></span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Data Categories</span><span class=\"val\">{{ doc.data_categories_breached or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">DPO Sign-off</span><span class=\"val\">{{ doc.dpo_sign_off or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Compliance Incident</span><span class=\"val\">{{ doc.compliance_incident_ref or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udccb NITDA Notification (72-hour rule)</div>\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Notification Required</span><span class=\"val\">{% if doc.nitda_notification_required %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">NITDA Notified</span><span class=\"val\">{% if doc.nitda_notified %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Notification Date</span><span class=\"val\">{{ frappe.format_date(doc.nitda_notification_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Hours to Notification</span><span class=\"val\">{{ doc.hours_to_notification or '\u2014' }}</span></div>\n    </div>\n  </div>\n  {% if doc.late_notification_flag %}\n  <div class=\"alert-box\">\u26a0\ufe0f <strong>LATE NOTIFICATION:</strong> Notification exceeded the 72-hour statutory requirement.</div>\n  {% endif %}\n\n  <div class=\"section-title\">\ud83d\udee0\ufe0f Remediation</div>\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Root Cause</span><span class=\"val\">{{ doc.root_cause or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Immediate Action</span><span class=\"val\">{{ doc.immediate_action_taken or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Corrective Measures</span><span class=\"val\">{{ doc.corrective_measures or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Subjects Notified</span><span class=\"val\">{% if doc.data_subjects_notified %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n  </div>\n\n  {% if doc.likely_consequences %}\n  <div class=\"note-box\"><strong>\u26a0\ufe0f Likely Consequences:</strong> {{ doc.likely_consequences }}</div>\n  {% endif %}\n\n  <div>\n    <div class=\"signature-box\">DPO Sign-off<br><strong>{{ doc.dpo_sign_off or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udd10 Confidential \u2014 Data Breach</span>\n  </div>\n</div>",
