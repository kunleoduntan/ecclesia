{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-13 13:45:11.362561",
 "css": "",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\r\n        \r\n        @media print {\r\n            @page {\r\n                margin: 12mm 8mm 12mm 8mm;\r\n                size: A4 portrait;\r\n            }\r\n            \r\n            body { \r\n                margin: 0;\r\n                padding: 0;\r\n                -webkit-print-color-adjust: exact;\r\n            }\r\n            \r\n            .no-print { display: none !important; }\r\n            .page-break { page-break-after: always; break-after: page; }\r\n        }\r\n        \r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: 'Inter', sans-serif;\r\n            background: white;\r\n            color: #1e293b;\r\n            line-height: 1.4;\r\n            font-size: 10px;\r\n        }\r\n\r\n        .po-container {\r\n            width: 100%;\r\n            max-width: 794px;\r\n            margin: 0 auto;\r\n            background: white;\r\n            padding: 15px;\r\n        }\r\n\r\n        /* Letterhead space - ERPNext will inject letterhead here */\r\n        .letter-head {\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        /* Header - Conditional display */\r\n        .header-section {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 12px;\r\n            padding-bottom: 8px;\r\n            border-bottom: 2px solid #000;\r\n        }\r\n\r\n        /* Only show company info if letterhead is not used */\r\n        .show-without-letterhead {\r\n            display: {% if print_settings and print_settings.with_letterhead %}none{% else %}block{% endif %};\r\n        }\r\n\r\n        .company-info {\r\n            flex: 1;\r\n        }\r\n\r\n        .company-name {\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            margin-bottom: 3px;\r\n        }\r\n\r\n        .company-details {\r\n            color: #4b5563;\r\n            font-size: 9px;\r\n            line-height: 1.4;\r\n        }\r\n\r\n        .po-title {\r\n            text-align: right;\r\n        }\r\n\r\n        .po-type {\r\n            font-size: 22px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .po-badge {\r\n            background: #000;\r\n            color: white;\r\n            padding: 3px 10px;\r\n            border-radius: 4px;\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            margin-top: 4px;\r\n            display: inline-block;\r\n        }\r\n\r\n        /* Status Badges */\r\n        .status-badge {\r\n            display: inline-block;\r\n            padding: 3px 8px;\r\n            border-radius: 4px;\r\n            font-size: 8px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .status-draft {\r\n            background: #f3f4f6;\r\n            color: #6b7280;\r\n        }\r\n\r\n        .status-submitted {\r\n            background: #dbeafe;\r\n            color: #1e40af;\r\n        }\r\n\r\n        .status-approved {\r\n            background: #dcfce7;\r\n            color: #166534;\r\n        }\r\n\r\n        .status-rejected {\r\n            background: #fee2e2;\r\n            color: #991b1b;\r\n        }\r\n\r\n        .status-ordered {\r\n            background: #fef3c7;\r\n            color: #92400e;\r\n        }\r\n\r\n        .status-received {\r\n            background: #dcfce7;\r\n            color: #166534;\r\n        }\r\n\r\n        /* PO Info Grid - Compact */\r\n        .info-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 8px;\r\n            margin-bottom: 12px;\r\n            background: #f9fafb;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .info-box {\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .info-label {\r\n            font-size: 8px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.3px;\r\n            color: #6b7280;\r\n            margin-bottom: 2px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .info-value {\r\n            font-size: 11px;\r\n            color: #111827;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .info-value-small {\r\n            font-size: 9px;\r\n            color: #4b5563;\r\n        }\r\n\r\n        /* Party Details - Compact */\r\n        .party-section {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 12px;\r\n            margin-bottom: 12px;\r\n        }\r\n\r\n        .party-card {\r\n            background: white;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .party-header {\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n            color: #000;\r\n            margin-bottom: 6px;\r\n            padding-bottom: 3px;\r\n            border-bottom: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .party-detail {\r\n            margin-bottom: 3px;\r\n            font-size: 9px;\r\n            color: #4b5563;\r\n        }\r\n\r\n        .party-detail strong {\r\n            color: #111827;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Supplier Details */\r\n        .supplier-details {\r\n            background: #f0f9ff;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            border: 1px solid #bae6fd;\r\n            margin-bottom: 12px;\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 10px;\r\n        }\r\n\r\n        .supplier-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .supplier-label {\r\n            font-size: 7px;\r\n            color: #6b7280;\r\n            margin-bottom: 2px;\r\n            font-weight: 500;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .supplier-value {\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n            color: #111827;\r\n        }\r\n\r\n        /* Items Table - Black Headers */\r\n        .items-section {\r\n            margin: 12px 0;\r\n        }\r\n\r\n        .items-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n\r\n        .items-table thead {\r\n            background: #000;\r\n        }\r\n\r\n        .items-table th {\r\n            padding: 8px 5px;\r\n            text-align: left;\r\n            font-weight: 600;\r\n            color: white;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.3px;\r\n            border: none;\r\n            font-size: 8px;\r\n        }\r\n\r\n        .items-table td {\r\n            padding: 6px 5px;\r\n            border-bottom: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .items-table tbody tr:nth-child(even) {\r\n            background-color: #f9fafb;\r\n        }\r\n\r\n        .amount-cell {\r\n            text-align: right;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n            font-weight: 500;\r\n        }\r\n\r\n        /* Tax Table */\r\n        .tax-section {\r\n            margin-top: 12px;\r\n            display: grid;\r\n            grid-template-columns: 1fr 250px;\r\n            gap: 12px;\r\n        }\r\n\r\n        .tax-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n\r\n        .tax-table td {\r\n            padding: 5px 8px;\r\n            border-bottom: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .tax-table tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .totals-box {\r\n            background: #f9fafb;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .total-row {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 5px 0;\r\n            border-bottom: 1px dashed #e5e7eb;\r\n            font-size: 9px;\r\n        }\r\n\r\n        .total-row:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .total-label {\r\n            color: #6b7280;\r\n        }\r\n\r\n        .total-value {\r\n            font-weight: 600;\r\n            color: #111827;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        .grand-total {\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            padding: 8px 0 0 0;\r\n            margin-top: 5px;\r\n            border-top: 2px solid #000;\r\n        }\r\n\r\n        .grand-total .total-label {\r\n            color: #000;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .grand-total .total-value {\r\n            color: #000;\r\n            font-size: 14px;\r\n        }\r\n\r\n        /* Delivery Schedule */\r\n        .delivery-section {\r\n            margin: 12px 0;\r\n            padding: 10px;\r\n            background: #f9fafb;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .delivery-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 8px;\r\n        }\r\n\r\n        .delivery-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .delivery-label {\r\n            font-size: 7px;\r\n            color: #6b7280;\r\n            margin-bottom: 2px;\r\n            font-weight: 500;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .delivery-value {\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n            color: #111827;\r\n        }\r\n\r\n        /* Notes & Terms - Compact */\r\n        .terms-section {\r\n            margin: 12px 0;\r\n            padding: 10px;\r\n            background: #f9fafb;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .terms-title {\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n            color: #000;\r\n            margin-bottom: 5px;\r\n        }\r\n\r\n        .terms-content {\r\n            font-size: 8px;\r\n            color: #4b5563;\r\n            line-height: 1.5;\r\n        }\r\n\r\n        /* Footer - Compact */\r\n        .footer-section {\r\n            margin-top: 15px;\r\n            padding-top: 12px;\r\n            border-top: 2px solid #e5e7eb;\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 30px;\r\n        }\r\n\r\n        .signature-box {\r\n            text-align: center;\r\n        }\r\n\r\n        .signature-line {\r\n            border-top: 1px solid #9ca3af;\r\n            padding-top: 6px;\r\n            margin-top: 20px;\r\n            position: relative;\r\n        }\r\n\r\n        .signature-label {\r\n            position: absolute;\r\n            top: -8px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            background: white;\r\n            padding: 0 6px;\r\n            font-size: 7px;\r\n            color: #6b7280;\r\n            font-weight: 500;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .print-info {\r\n            text-align: center;\r\n            color: #9ca3af;\r\n            font-size: 7px;\r\n            margin-top: 12px;\r\n            padding-top: 8px;\r\n            border-top: 1px solid #e5e7eb;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        /* In Words - Compact */\r\n        .in-words {\r\n            margin-top: 8px;\r\n            padding: 8px;\r\n            background: #fff8e1;\r\n            border-radius: 4px;\r\n            font-size: 8px;\r\n            color: #92400e;\r\n            font-style: italic;\r\n            border-left: 3px solid #f59e0b;\r\n        }\r\n\r\n        /* Tax ID Badge */\r\n        .tax-id-badge {\r\n            margin-top: 3px;\r\n            font-size: 8px;\r\n            color: #4b5563;\r\n        }\r\n        \r\n        .tax-id-badge strong {\r\n            color: #000;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Utility */\r\n        .text-right { text-align: right; }\r\n        .text-center { text-align: center; }\r\n        .text-mono { font-family: 'SF Mono', 'Monaco', 'Consolas', monospace; }\r\n        \r\n        .empty-state {\r\n            text-align: center;\r\n            color: #9ca3af;\r\n            font-style: italic;\r\n            padding: 20px;\r\n            background: #f9fafb;\r\n            border-radius: 6px;\r\n            margin: 15px 0;\r\n        }\r\n\r\n        /* Column widths */\r\n        .col-sn { width: 30px; text-align: center; }\r\n        .col-code { width: 70px; }\r\n        .col-item { width: 200px; }\r\n        .col-qty { width: 45px; text-align: center; }\r\n        .col-uom { width: 45px; text-align: center; }\r\n        .col-rate { width: 80px; text-align: right; }\r\n        .col-amount { width: 90px; text-align: right; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"po-container\">\r\n        <!-- ERPNext Letterhead will be automatically injected here -->\r\n        {{ letter_head }}\r\n        \r\n        <!-- Header - Only shows company info if no letterhead is selected -->\r\n        <div class=\"header-section\">\r\n            <div class=\"company-info show-without-letterhead\">\r\n                <div class=\"company-name\">{{ doc.company }}</div>\r\n                <div class=\"company-details\">\r\n                    {{ doc.company_address_display or \"\" | replace('\\n', '<br>') | safe }}\r\n                </div>\r\n                <!-- Company Tax ID -->\r\n                {% if doc.company_tax_id %}\r\n                <div class=\"tax-id-badge\">\r\n                    <strong>Tax ID:</strong> {{ doc.company_tax_id }}\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"po-title\">\r\n                <div class=\"po-type\">PURCHASE ORDER</div>\r\n                <div class=\"po-badge\">{{ doc.name }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- PO Info - Compact Grid (4 columns) -->\r\n        <div class=\"info-grid\">\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">PO Date</span>\r\n                <span class=\"info-value\">{{ frappe.format(doc.transaction_date, {'fieldtype': 'Date'}) }}</span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Schedule Date</span>\r\n                <span class=\"info-value\">{{ frappe.format(doc.schedule_date, {'fieldtype': 'Date'}) if doc.schedule_date else \"N/A\" }}</span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Status</span>\r\n                <span class=\"info-value\">\r\n                    {% if doc.status == 'Draft' %}\r\n                        <span class=\"status-badge status-draft\">{{ doc.status }}</span>\r\n                    {% elif doc.status == 'Submitted' %}\r\n                        <span class=\"status-badge status-submitted\">{{ doc.status }}</span>\r\n                    {% elif doc.status == 'Approved' %}\r\n                        <span class=\"status-badge status-approved\">{{ doc.status }}</span>\r\n                    {% elif doc.status == 'Rejected' %}\r\n                        <span class=\"status-badge status-rejected\">{{ doc.status }}</span>\r\n                    {% elif doc.status == 'Ordered' %}\r\n                        <span class=\"status-badge status-ordered\">{{ doc.status }}</span>\r\n                    {% elif doc.status == 'Received' %}\r\n                        <span class=\"status-badge status-received\">{{ doc.status }}</span>\r\n                    {% elif doc.docstatus == 0 %}\r\n                        <span class=\"status-badge status-draft\">Draft</span>\r\n                    {% else %}\r\n                        <span class=\"status-badge status-draft\">{{ doc.status }}</span>\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Currency</span>\r\n                <span class=\"info-value\">{{ doc.currency }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Supplier Details -->\r\n        <div class=\"party-section\">\r\n            <!-- Supplier Details -->\r\n            <div class=\"party-card\">\r\n                <div class=\"party-header\">SUPPLIER</div>\r\n                <div class=\"party-detail\"><strong>{{ doc.supplier_name or doc.supplier }}</strong></div>\r\n                {% if doc.supplier.tax_id %}\r\n                <div class=\"party-detail\"><strong>Tax ID:</strong> {{ doc.supplier.tax_id }}</div>\r\n                {% endif %}\r\n                <div class=\"party-detail\">{{ doc.address_display or \"\" | replace('\\n', '<br>') | safe }}</div>\r\n                {% if doc.contact_display %}\r\n                <div class=\"party-detail\"><strong>Contact:</strong> {{ doc.contact_display }}</div>\r\n                {% endif %}\r\n                {% if doc.contact_mobile %}\r\n                <div class=\"party-detail\"><strong>Phone:</strong> {{ doc.contact_mobile }}</div>\r\n                {% endif %}\r\n                {% if doc.contact_email %}\r\n                <div class=\"party-detail\"><strong>Email:</strong> {{ doc.contact_email }}</div>\r\n                {% endif %}\r\n            </div>\r\n\r\n            <!-- Ship To Address -->\r\n            <div class=\"party-card\">\r\n                <div class=\"party-header\">SHIP TO</div>\r\n                {% if doc.shipping_address_name %}\r\n                <div class=\"party-detail\">{{ doc.shipping_address or \"Same as Company Address\" | replace('\\n', '<br>') | safe }}</div>\r\n                {% else %}\r\n                <div class=\"party-detail\" style=\"color: #9ca3af;\">Same as Company Address</div>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Additional Supplier Info -->\r\n        <div class=\"supplier-details\">\r\n            <div class=\"supplier-item\">\r\n                <div class=\"supplier-label\">Supplier ID</div>\r\n                <div class=\"supplier-value\">{{ doc.supplier }}</div>\r\n            </div>\r\n            <div class=\"supplier-item\">\r\n                <div class=\"supplier-label\">Payment Terms</div>\r\n                <div class=\"supplier-value\">{{ doc.payment_terms_template or \"Standard\" }}</div>\r\n            </div>\r\n            <div class=\"supplier-item\">\r\n                <div class=\"supplier-label\">Tax Category</div>\r\n                <div class=\"supplier-value\">{{ doc.tax_category or \"Regular\" }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Items Table - Black Headers -->\r\n        <div class=\"items-section\">\r\n            <table class=\"items-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th class=\"col-sn\">#</th>\r\n                        <th class=\"col-code\">Code</th>\r\n                        <th class=\"col-item\">Description</th>\r\n                        <th class=\"col-qty\">Qty</th>\r\n                        <th class=\"col-uom\">UOM</th>\r\n                        <th class=\"col-rate\">Rate</th>\r\n                        <th class=\"col-amount\">Amount</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for item in doc.items %}\r\n                    <tr>\r\n                        <td style=\"text-align: center;\">{{ loop.index }}</td>\r\n                        <td>{{ item.item_code or \"\" }}</td>\r\n                        <td>{{ item.description or item.item_name or \"\" }}</td>\r\n                        <td style=\"text-align: center;\">{{ item.qty }}</td>\r\n                        <td style=\"text-align: center;\">{{ item.uom or \"Nos\" }}</td>\r\n                        <td class=\"amount-cell\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\r\n                        <td class=\"amount-cell\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n\r\n        <!-- Totals and Taxes - Compact -->\r\n        <div class=\"tax-section\">\r\n            <!-- Tax Table -->\r\n            <div>\r\n                <table class=\"tax-table\">\r\n                    {% for tax in doc.taxes %}\r\n                    <tr>\r\n                        <td>{{ tax.description or tax.charge_type or \"\" }}</td>\r\n                        <td class=\"amount-cell\">{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </table>\r\n            </div>\r\n\r\n            <!-- Totals Box -->\r\n            <div class=\"totals-box\">\r\n                <div class=\"total-row\">\r\n                    <span class=\"total-label\">Net Total:</span>\r\n                    <span class=\"total-value\">{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</span>\r\n                </div>\r\n                {% if doc.discount_amount %}\r\n                <div class=\"total-row\">\r\n                    <span class=\"total-label\">Discount:</span>\r\n                    <span class=\"total-value\">- {{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}</span>\r\n                </div>\r\n                {% endif %}\r\n                <div class=\"total-row\">\r\n                    <span class=\"total-label\">Total Tax:</span>\r\n                    <span class=\"total-value\">{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}</span>\r\n                </div>\r\n                <div class=\"total-row grand-total\">\r\n                    <span class=\"total-label\">Grand Total:</span>\r\n                    <span class=\"total-value\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</span>\r\n                </div>\r\n                {% if doc.rounded_total and doc.rounded_total != doc.grand_total %}\r\n                <div class=\"total-row\">\r\n                    <span class=\"total-label\">Rounded Total:</span>\r\n                    <span class=\"total-value\">{{ frappe.utils.fmt_money(doc.rounded_total, currency=doc.currency) }}</span>\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Amount in Words -->\r\n        {% if doc.in_words %}\r\n        <div class=\"in-words\">\r\n            <strong>Amount in Words:</strong> {{ doc.in_words }}\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Delivery Information -->\r\n        <div class=\"delivery-section\">\r\n            <div class=\"delivery-grid\">\r\n                {% if doc.shipping_address %}\r\n                <div class=\"delivery-item\" style=\"grid-column: span 2;\">\r\n                    <div class=\"delivery-label\">Delivery Address</div>\r\n                    <div class=\"delivery-value\">{{ doc.shipping_address|replace('\\n', ', ') }}</div>\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Terms and Conditions -->\r\n        {% if doc.terms %}\r\n        <div class=\"terms-section\">\r\n            <div class=\"terms-title\">Terms & Conditions</div>\r\n            <div class=\"terms-content\">{{ doc.terms | safe }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Remarks -->\r\n        {% if doc.remarks %}\r\n        <div class=\"terms-section\" style=\"background: #fff8e1; border-color: #f59e0b;\">\r\n            <div class=\"terms-title\">Remarks</div>\r\n            <div class=\"terms-content\">{{ doc.remarks }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Footer with Signatures - Compact -->\r\n        <div class=\"footer-section\">\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">PREPARED BY</span>\r\n                </div>\r\n                <div class=\"signature-name\" style=\"margin-top: 3px; font-size: 8px; color: #4b5563;\">{{ doc.owner }}</div>\r\n            </div>\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">AUTHORIZED SIGNATURE</span>\r\n                </div>\r\n                <div class=\"signature-name\" style=\"margin-top: 3px; font-size: 8px; color: #4b5563;\">For {{ doc.company }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Print Info -->\r\n        <div class=\"print-info\">\r\n            Generated \u2022 {{ doc.name }} \u2022 {{ frappe.utils.now_datetime().strftime('%Y-%m-%d %H:%M') }}\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>",
