{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-18 09:12:02.640108",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Cash Purchase Sale",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Cash Purchase/Sale \u00b7 Professional Print</title>\r\n    <style>\r\n        /* ---- reset & base ---- */\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n        body {\r\n            font-family: 'Segoe UI', 'Roboto', 'Calibri', Arial, sans-serif;\r\n            font-size: 10px;\r\n            color: #1e2b3c;\r\n            background: #f4f7fc;\r\n            padding: 12px 16px;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n        }\r\n        .voucher-wrapper {\r\n            max-width: 1100px;\r\n            width: 100%;\r\n            background: #ffffff;\r\n            border-radius: 10px;\r\n            box-shadow: 0 8px 24px rgba(0,20,40,0.08);\r\n            padding: 18px 24px 14px 24px;\r\n        }\r\n\r\n        /* ---- letterhead wrapper ---- */\r\n        .letterhead-wrapper {\r\n            margin-bottom: 10px;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback {\r\n            border-bottom: 2px solid #1a3b5d;\r\n            padding-bottom: 6px;\r\n            margin-bottom: 10px;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback h2 {\r\n            font-size: 20px;\r\n            color: #0a2647;\r\n            margin: 0;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback p {\r\n            font-size: 10px;\r\n            color: #4a5b6e;\r\n            margin: 2px 0 0 0;\r\n        }\r\n\r\n        /* ---- title ---- */\r\n        .voucher-title {\r\n            text-align: center;\r\n            font-size: 20px;\r\n            font-weight: 700;\r\n            letter-spacing: 3px;\r\n            color: #1a3b5d;\r\n            text-transform: uppercase;\r\n            margin: 0 0 10px 0;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 4px;\r\n        }\r\n\r\n        /* ---- info grid ---- */\r\n        .info-grid {\r\n            display: flex;\r\n            gap: 16px;\r\n            margin-bottom: 10px;\r\n            flex-wrap: wrap;\r\n        }\r\n        .party-details {\r\n            flex: 1.2;\r\n            min-width: 200px;\r\n        }\r\n        .party-details .label {\r\n            font-weight: 700;\r\n            font-size: 10px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #1a3b5d;\r\n            padding-bottom: 2px;\r\n            margin-bottom: 4px;\r\n            display: inline-block;\r\n        }\r\n        .party-name {\r\n            font-size: 14px;\r\n            font-weight: 700;\r\n            color: #00337a;\r\n            margin: 3px 0 1px 0;\r\n        }\r\n        .party-phone {\r\n            font-size: 9px;\r\n            color: #4a5b6e;\r\n            margin-top: 2px;\r\n        }\r\n\r\n        .info-panel {\r\n            flex: 0.9;\r\n            min-width: 200px;\r\n            background: #f8fafc;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 12px 3px 12px;\r\n        }\r\n        .info-row {\r\n            display: flex;\r\n            justify-content: flex-start;\r\n            padding: 1px 0;\r\n            border-bottom: 1px dashed #dce4ed;\r\n            gap: 6px;\r\n            align-items: baseline;\r\n        }\r\n        .info-row:last-child { border-bottom: none; }\r\n        .info-row .ilabel {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            min-width: 85px;\r\n            font-size: 9px;\r\n        }\r\n        .info-row .ivalue {\r\n            font-weight: 500;\r\n            color: #00337a;\r\n            font-size: 9px;\r\n        }\r\n\r\n        /* ---- type badge ---- */\r\n        .type-badge {\r\n            display: inline-block;\r\n            padding: 2px 16px;\r\n            border-radius: 30px;\r\n            font-weight: 700;\r\n            font-size: 11px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n        }\r\n        .type-purchase { background: #dbeafe; color: #1e40af; }\r\n        .type-sale { background: #d1fae5; color: #065f46; }\r\n\r\n        /* ---- section headers ---- */\r\n        .section-header {\r\n            font-weight: 700;\r\n            font-size: 11px;\r\n            color: #1a3b5d;\r\n            background: #e3eaf2;\r\n            padding: 3px 12px;\r\n            margin: 8px 0 4px 0;\r\n            border-radius: 3px;\r\n            border-left: 3px solid #1a3b5d;\r\n        }\r\n\r\n        /* ---- table ---- */\r\n        .table-wrap {\r\n            margin: 6px 0 4px 0;\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            overflow: hidden;\r\n        }\r\n        .items-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .items-table th {\r\n            background: #e3eaf2;\r\n            color: #0a2647;\r\n            font-weight: 700;\r\n            padding: 3px 4px;\r\n            border: 1px solid #1f2e42;\r\n            text-align: center;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table td {\r\n            padding: 2px 4px;\r\n            border: 1px solid #1f2e42;\r\n            vertical-align: middle;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table .alt-row td { background: #f6f9fd; }\r\n        .text-center { text-align: center; }\r\n        .text-right { text-align: right; }\r\n        .text-left { text-align: left; }\r\n        .font-bold { font-weight: 700; }\r\n\r\n        /* ---- totals ---- */\r\n        .totals-section {\r\n            display: flex;\r\n            justify-content: flex-end;\r\n            margin-top: 4px;\r\n            padding: 0 2px;\r\n        }\r\n        .totals-box {\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            background: #f8fafc;\r\n            padding: 2px 14px 2px 14px;\r\n            width: 45%;\r\n            min-width: 280px;\r\n        }\r\n        .totals-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table td {\r\n            padding: 1px 3px;\r\n            border: none;\r\n            vertical-align: middle;\r\n            line-height: 1.2;\r\n        }\r\n        .totals-table .label {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            padding-right: 14px;\r\n            width: 60%;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .amount {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #00337a;\r\n            width: 40%;\r\n            padding-right: 2px;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .total-row td {\r\n            border-top: 1px solid #d0dbe8;\r\n            padding-top: 2px;\r\n        }\r\n        .totals-table .grand-total td {\r\n            font-size: 11px;\r\n            font-weight: 700;\r\n            color: #0a2647;\r\n            border-top: 2px solid #1a3b5d;\r\n            padding-top: 2px;\r\n        }\r\n        .totals-table .grand-total .amount {\r\n            font-size: 12px;\r\n            color: #00337a;\r\n        }\r\n        .totals-table .tax-row td {\r\n            border-bottom: 1px dashed #dce4ed;\r\n            padding-bottom: 1px;\r\n        }\r\n        .totals-table .tax-row .amount {\r\n            color: #dc2626;\r\n        }\r\n\r\n        /* ---- in words ---- */\r\n        .in-words {\r\n            background: #f2f7ff;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 3px 14px;\r\n            margin: 4px 0 8px 0;\r\n            display: flex;\r\n            gap: 10px;\r\n            font-size: 9.5px;\r\n            align-items: center;\r\n            flex-wrap: wrap;\r\n        }\r\n        .in-words strong { color: #1a3b5d; }\r\n\r\n        /* ---- signatures ---- */\r\n        .signature-grid {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin: 12px 0 4px 0;\r\n            flex-wrap: wrap;\r\n        }\r\n        .sig-card {\r\n            flex: 1;\r\n            min-width: 120px;\r\n            border: 1px solid #1a3b5d;\r\n            border-radius: 5px;\r\n            padding: 4px 8px 3px 8px;\r\n            background: #fafdff;\r\n        }\r\n        .sig-card .sig-head {\r\n            font-weight: 700;\r\n            font-size: 8.5px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 1px;\r\n            margin-bottom: 3px;\r\n        }\r\n        .sig-card .sig-field {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            font-size: 8px;\r\n            margin: 1px 0;\r\n            color: #1e2b3c;\r\n        }\r\n        .sig-card .sig-field strong {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n        }\r\n        .sig-card .dash-line {\r\n            color: #7a8a9e;\r\n            letter-spacing: 0.5px;\r\n            font-weight: 300;\r\n        }\r\n        .sig-card .line-space {\r\n            height: 12px;\r\n            border-bottom: 1px dashed #b9cfe5;\r\n            margin: 1px 0 3px 0;\r\n        }\r\n\r\n        .footer-thank {\r\n            text-align: center;\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n            color: #1a3b5d;\r\n            padding: 6px 0 2px 0;\r\n            margin-top: 6px;\r\n            border-top: 2px solid #1a3b5d;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        /* ---- linked docs ---- */\r\n        .linked-docs {\r\n            display: flex;\r\n            gap: 20px;\r\n            flex-wrap: wrap;\r\n            background: #f8fafc;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 14px;\r\n            margin: 4px 0 6px 0;\r\n            font-size: 9px;\r\n        }\r\n        .linked-docs .ld-item {\r\n            display: flex;\r\n            align-items: baseline;\r\n            gap: 4px;\r\n        }\r\n        .linked-docs .ld-label {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n        }\r\n        .linked-docs .ld-value {\r\n            font-weight: 500;\r\n            color: #00337a;\r\n        }\r\n\r\n        /* ---- print ---- */\r\n        @media print {\r\n            body {\r\n                background: #fff;\r\n                padding: 4px 8px;\r\n                display: block;\r\n                min-height: auto;\r\n            }\r\n            .voucher-wrapper {\r\n                max-width: 100%;\r\n                box-shadow: none;\r\n                border-radius: 0;\r\n                padding: 6px 10px;\r\n            }\r\n            .sig-card { min-height: 38px; }\r\n            .items-table th { background: #e3eaf2 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\r\n            .in-words, .info-panel, .totals-box, .linked-docs {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n            .items-table th, .items-table td {\r\n                padding: 1px 3px;\r\n                line-height: 1.1;\r\n            }\r\n            .type-badge {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .info-grid { flex-direction: column; gap: 8px; }\r\n            .signature-grid { flex-direction: column; }\r\n            .sig-card { min-width: auto; }\r\n            .voucher-wrapper { padding: 12px 10px; }\r\n            .totals-box { width: 100%; min-width: auto; }\r\n            .linked-docs { flex-direction: column; gap: 4px; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"voucher-wrapper\">\r\n\r\n    <!-- ===== LETTERHEAD WRAPPER ===== -->\r\n    <div class=\"letterhead-wrapper\">\r\n        {% if doc.letter_head %}\r\n            {{ frappe.db.get_value(\"Letter Head\", doc.letter_head, \"content\") }}\r\n        {% else %}\r\n            <!-- Fallback if no letterhead is set on the document -->\r\n            <div class=\"letterhead-fallback\">\r\n                <h2>{{ doc.company or 'Company Name' }}</h2>\r\n                <p>{{ doc.company_address or '' }}</p>\r\n            </div>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- ===== TITLE ===== -->\r\n    <div class=\"voucher-title\">\r\n        <span class=\"type-badge type-{{ 'purchase' if doc.transaction_type == 'Cash Purchase' else 'sale' }}\">\r\n            {{ doc.transaction_type or 'Cash Transaction' }}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- ===== INFO GRID ===== -->\r\n    <div class=\"info-grid\">\r\n        <div class=\"party-details\">\r\n            <div class=\"label\">\r\n                {% if doc.transaction_type == 'Cash Purchase' %}\ud83e\uddfe Supplier{% else %}\ud83d\udc64 Customer{% endif %}\r\n            </div>\r\n            <div class=\"party-name\">\r\n                {% if doc.transaction_type == 'Cash Purchase' %}\r\n                    {{ doc.actual_supplier_name or doc.walk_in_supplier or 'Walk-in Supplier' }}\r\n                {% else %}\r\n                    {{ doc.actual_customer_name or doc.walk_in_customer or 'Walk-in Customer' }}\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"party-phone\">\r\n                {% if doc.transaction_type == 'Cash Purchase' %}\r\n                    \ud83d\udcde {{ doc.actual_supplier_phone or 'N/A' }}\r\n                {% else %}\r\n                    \ud83d\udcde {{ doc.actual_customer_phone or 'N/A' }}\r\n                {% endif %}\r\n            </div>\r\n            <div style=\"font-size:8px;color:#64748B;margin-top:4px;\">\r\n                {% if doc.transaction_type == 'Cash Purchase' %}\r\n                    Master: {{ doc.walk_in_supplier or 'N/A' }}\r\n                {% else %}\r\n                    Master: {{ doc.walk_in_customer or 'N/A' }}\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"info-panel\">\r\n            <div class=\"info-row\"><span class=\"ilabel\">Voucher #</span><span class=\"ivalue\">{{ doc.name or 'CPS-2026-001' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Date</span><span class=\"ivalue\">{{ doc.transaction_date or frappe.utils.get_today() }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Company</span><span class=\"ivalue\">{{ doc.company or 'N/A' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Warehouse</span>\r\n                <span class=\"ivalue\">\r\n                    {% if doc.transaction_type == 'Cash Purchase' %}\r\n                        {{ doc.purchase_warehouse or 'N/A' }}\r\n                    {% else %}\r\n                        {{ doc.sales_warehouse or 'N/A' }}\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Mode of Payment</span>\r\n                <span class=\"ivalue\">\r\n                    {% if doc.transaction_type == 'Cash Purchase' %}\r\n                        {{ doc.mode_of_payment_purchase or 'N/A' }}\r\n                    {% else %}\r\n                        {{ doc.mode_of_payment_sales or 'N/A' }}\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Cash/Bank Account</span>\r\n                <span class=\"ivalue\">\r\n                    {% if doc.transaction_type == 'Cash Purchase' %}\r\n                        {{ doc.cash_bank_account_purchase or 'N/A' }}\r\n                    {% else %}\r\n                        {{ doc.cash_bank_account_sales or 'N/A' }}\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== ITEMS TABLE ===== -->\r\n    <div class=\"section-header\">\ud83d\udccb Items</div>\r\n    <div class=\"table-wrap\">\r\n        <table class=\"items-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width:15%;\">Code</th>\r\n                    <th style=\"width:28%;\">Item Name</th>\r\n                    <th style=\"width:8%;\">Qty</th>\r\n                    <th style=\"width:9%;\">UOM</th>\r\n                    <th style=\"width:18%;\">Rate</th>\r\n                    <th style=\"width:22%;\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% if doc.transaction_type == 'Cash Purchase' %}\r\n                    {%- for row in doc.purchase_items -%}\r\n                    <tr class=\"{{ 'alt-row' if loop.index % 2 == 0 else '' }}\">\r\n                        <td class=\"text-center\">{{ row.item_code }}</td>\r\n                        <td class=\"text-left\">{{ row.item_name or row.item_code }}</td>\r\n                        <td class=\"text-center\">{{ row.qty }}</td>\r\n                        <td class=\"text-center\">{{ row.uom }}</td>\r\n                        <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\r\n                        <td class=\"text-right font-bold\">{{ row.get_formatted(\"amount\") }}</td>\r\n                    </tr>\r\n                    {%- else -%}\r\n                    <tr><td class=\"text-center\" colspan=\"6\">No items recorded</td></tr>\r\n                    {%- endfor -%}\r\n                {% else %}\r\n                    {%- for row in doc.sales_items -%}\r\n                    <tr class=\"{{ 'alt-row' if loop.index % 2 == 0 else '' }}\">\r\n                        <td class=\"text-center\">{{ row.item_code }}</td>\r\n                        <td class=\"text-left\">{{ row.item_name or row.item_code }}</td>\r\n                        <td class=\"text-center\">{{ row.qty }}</td>\r\n                        <td class=\"text-center\">{{ row.uom }}</td>\r\n                        <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\r\n                        <td class=\"text-right font-bold\">{{ row.get_formatted(\"amount\") }}</td>\r\n                    </tr>\r\n                    {%- else -%}\r\n                    <tr><td class=\"text-center\" colspan=\"6\">No items recorded</td></tr>\r\n                    {%- endfor -%}\r\n                {% endif %}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===== TOTALS ===== -->\r\n    <div class=\"totals-section\">\r\n        <div class=\"totals-box\">\r\n            <table class=\"totals-table\">\r\n                <tbody>\r\n                    <tr>\r\n                        <td class=\"label\">Total</td>\r\n                        <td class=\"amount\">\r\n                            {% if doc.transaction_type == 'Cash Purchase' %}\r\n                                {{ doc.get_formatted(\"purchase_total\") or '\u20a6 0.00' }}\r\n                            {% else %}\r\n                                {{ doc.get_formatted(\"sales_total\") or '\u20a6 0.00' }}\r\n                            {% endif %}\r\n                        </td>\r\n                    </tr>\r\n\r\n                    {% if doc.transaction_type == 'Cash Purchase' and doc.apply_withholding_tax_purchase %}\r\n                    <tr class=\"tax-row\">\r\n                        <td class=\"label\">WHT ({{ doc.wht_rate_purchase or '0' }}%)</td>\r\n                        <td class=\"amount\">- {{ doc.get_formatted(\"wht_amount_purchase\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n\r\n                    {% if doc.transaction_type == 'Cash Sale' and doc.apply_withholding_tax_sales %}\r\n                    <tr class=\"tax-row\">\r\n                        <td class=\"label\">WHT Withheld ({{ doc.wht_rate_sales or '0' }}%)</td>\r\n                        <td class=\"amount\">- {{ doc.get_formatted(\"wht_amount_sales\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n\r\n                    {% if doc.transaction_type == 'Cash Purchase' and doc.apply_vat_deduction_purchase %}\r\n                    <tr class=\"tax-row\">\r\n                        <td class=\"label\">VAT ({{ doc.vat_rate_purchase or '0' }}%)</td>\r\n                        <td class=\"amount\">- {{ doc.get_formatted(\"vat_amount_purchase\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n\r\n                    {% if doc.transaction_type == 'Cash Sale' and doc.apply_vat_deduction_sales %}\r\n                    <tr class=\"tax-row\">\r\n                        <td class=\"label\">VAT Withheld ({{ doc.vat_rate_sales or '0' }}%)</td>\r\n                        <td class=\"amount\">- {{ doc.get_formatted(\"vat_amount_sales\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n\r\n                    <tr class=\"grand-total\">\r\n                        <td class=\"label\">\r\n                            {% if doc.transaction_type == 'Cash Purchase' %}\r\n                                Net Payable\r\n                            {% else %}\r\n                                Net Receivable\r\n                            {% endif %}\r\n                        </td>\r\n                        <td class=\"amount\">\r\n                            {% if doc.transaction_type == 'Cash Purchase' %}\r\n                                {{ doc.get_formatted(\"net_payable\") or '\u20a6 0.00' }}\r\n                            {% else %}\r\n                                {{ doc.get_formatted(\"net_receivable\") or '\u20a6 0.00' }}\r\n                            {% endif %}\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== IN WORDS ===== -->\r\n    <div class=\"in-words\">\r\n        <strong>In Words:</strong>\r\n        <span>\r\n            {% if doc.transaction_type == 'Cash Purchase' %}\r\n                {{ doc.net_payable_in_words or doc.net_payable or 'Zero' }}\r\n            {% else %}\r\n                {{ doc.net_receivable_in_words or doc.net_receivable or 'Zero' }}\r\n            {% endif %}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- ===== TAX NOTES ===== -->\r\n    {% if doc.transaction_type == 'Cash Purchase' and (doc.apply_withholding_tax_purchase or doc.apply_vat_deduction_purchase) %}\r\n    <div style=\"background:#fefce8;border:1px solid #fde68a;border-radius:5px;padding:4px 14px;margin:4px 0 6px 0;font-size:9px;\">\r\n        <strong>\ud83d\udccc Tax Note:</strong>\r\n        {% if doc.apply_withholding_tax_purchase %}WHT of {{ doc.get_formatted(\"wht_amount_purchase\") }} withheld @ {{ doc.wht_rate_purchase }}%{% endif %}\r\n        {% if doc.apply_withholding_tax_purchase and doc.apply_vat_deduction_purchase %} and {% endif %}\r\n        {% if doc.apply_vat_deduction_purchase %}VAT of {{ doc.get_formatted(\"vat_amount_purchase\") }} deducted @ {{ doc.vat_rate_purchase }}%{% endif %}\r\n        \u2014 booked as liability (payable to FIRS).\r\n    </div>\r\n    {% endif %}\r\n\r\n    {% if doc.transaction_type == 'Cash Sale' and (doc.apply_withholding_tax_sales or doc.apply_vat_deduction_sales) %}\r\n    <div style=\"background:#f0fdf4;border:1px solid #86efac;border-radius:5px;padding:4px 14px;margin:4px 0 6px 0;font-size:9px;\">\r\n        <strong>\ud83d\udccc Tax Note:</strong>\r\n        {% if doc.apply_withholding_tax_sales %}WHT of {{ doc.get_formatted(\"wht_amount_sales\") }} withheld by customer @ {{ doc.wht_rate_sales }}%{% endif %}\r\n        {% if doc.apply_withholding_tax_sales and doc.apply_vat_deduction_sales %} and {% endif %}\r\n        {% if doc.apply_vat_deduction_sales %}VAT of {{ doc.get_formatted(\"vat_amount_sales\") }} withheld by customer @ {{ doc.vat_rate_sales }}%{% endif %}\r\n        \u2014 booked as recoverable asset (tax credit).\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===== LINKED DOCUMENTS ===== -->\r\n    {% if doc.purchase_invoice or doc.purchase_payment_entry or doc.purchase_tax_journal_entry or doc.sales_invoice or doc.sales_payment_entry or doc.sales_tax_journal_entry %}\r\n    <div class=\"section-header\">\ud83d\udd17 Linked Documents</div>\r\n    <div class=\"linked-docs\">\r\n        {% if doc.transaction_type == 'Cash Purchase' %}\r\n            {% if doc.purchase_invoice %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Purchase Invoice:</span>\r\n                <span class=\"ld-value\">{{ doc.purchase_invoice }}</span>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.purchase_payment_entry %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Payment Entry:</span>\r\n                <span class=\"ld-value\">{{ doc.purchase_payment_entry }}</span>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.purchase_tax_journal_entry %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Tax JE:</span>\r\n                <span class=\"ld-value\">{{ doc.purchase_tax_journal_entry }}</span>\r\n            </div>\r\n            {% endif %}\r\n        {% else %}\r\n            {% if doc.sales_invoice %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Sales Invoice:</span>\r\n                <span class=\"ld-value\">{{ doc.sales_invoice }}</span>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.sales_payment_entry %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Payment Entry:</span>\r\n                <span class=\"ld-value\">{{ doc.sales_payment_entry }}</span>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.sales_tax_journal_entry %}\r\n            <div class=\"ld-item\">\r\n                <span class=\"ld-label\">Tax JE:</span>\r\n                <span class=\"ld-value\">{{ doc.sales_tax_journal_entry }}</span>\r\n            </div>\r\n            {% endif %}\r\n        {% endif %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===== SIGNATURES ===== -->\r\n    <div class=\"signature-grid\">\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\u270d\ufe0f Prepared By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\u2705 Approved By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\ud83d\udce6 Received By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== FOOTER ===== -->\r\n    <div class=\"footer-thank\">\r\n        \u2b50 Thank You For Your Business! \u2b50\r\n    </div>\r\n\r\n</div>\r\n</body>\r\n</html>",
