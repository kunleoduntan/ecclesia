{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-13 11:11:42.320877",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Staff Loan Payment",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\r\n        \r\n        @media print {\r\n            @page {\r\n                margin: 15mm 10mm 15mm 10mm;\r\n                size: A4 portrait;\r\n            }\r\n            \r\n            body { \r\n                margin: 0;\r\n                padding: 0;\r\n                -webkit-print-color-adjust: exact;\r\n            }\r\n            \r\n            .no-print { display: none !important; }\r\n            .page-break { page-break-after: always; break-after: page; }\r\n        }\r\n        \r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: 'Inter', sans-serif;\r\n            background: white;\r\n            color: #1e293b;\r\n            line-height: 1.5;\r\n            font-size: 12px;\r\n        }\r\n\r\n        .report-container {\r\n            width: 100%;\r\n            max-width: 794px;\r\n            margin: 0 auto;\r\n            background: white;\r\n        }\r\n\r\n        /* Header */\r\n        .header-section {\r\n            margin-bottom: 20px;\r\n            border-bottom: 3px solid #2c3e50;\r\n            padding-bottom: 15px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n        }\r\n\r\n        .company-logo {\r\n            width: 80px;\r\n            height: 80px;\r\n            background: #f8fafc;\r\n            border-radius: 8px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            border: 1px solid #e2e8f0;\r\n        }\r\n\r\n        .company-logo svg {\r\n            width: 50px;\r\n            height: 50px;\r\n            fill: #2c3e50;\r\n        }\r\n\r\n        .title-section {\r\n            text-align: center;\r\n            flex-grow: 1;\r\n        }\r\n\r\n        .report-title {\r\n            font-size: 24px;\r\n            font-weight: 700;\r\n            color: #2c3e50;\r\n            margin-bottom: 5px;\r\n            letter-spacing: -0.5px;\r\n        }\r\n\r\n        .report-subtitle {\r\n            color: #64748b;\r\n            font-size: 13px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .loan-badge {\r\n            background: #3498db;\r\n            color: white;\r\n            padding: 8px 15px;\r\n            border-radius: 6px;\r\n            font-size: 11px;\r\n            font-weight: 600;\r\n            text-align: center;\r\n        }\r\n\r\n        .loan-badge span {\r\n            display: block;\r\n            font-size: 9px;\r\n            color: rgba(255, 255, 255, 0.9);\r\n            margin-bottom: 2px;\r\n        }\r\n\r\n        /* Status Badges */\r\n        .status-badge {\r\n            display: inline-block;\r\n            padding: 4px 10px;\r\n            border-radius: 20px;\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .status-active {\r\n            background: #dbeafe;\r\n            color: #1e40af;\r\n        }\r\n\r\n        .status-completed {\r\n            background: #dcfce7;\r\n            color: #166534;\r\n        }\r\n\r\n        .status-draft {\r\n            background: #f3f4f6;\r\n            color: #6b7280;\r\n        }\r\n\r\n        .status-cancelled {\r\n            background: #fee2e2;\r\n            color: #991b1b;\r\n        }\r\n\r\n        /* Section Titles */\r\n        .section-title {\r\n            font-size: 16px;\r\n            font-weight: 600;\r\n            color: #2c3e50;\r\n            margin: 20px 0 10px 0;\r\n            padding-bottom: 6px;\r\n            border-bottom: 2px solid #3498db;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n        }\r\n\r\n        .section-title i {\r\n            font-size: 14px;\r\n            color: #3498db;\r\n        }\r\n\r\n        /* Info Grid */\r\n        .info-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 12px;\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .info-card {\r\n            background: #f8fafc;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border: 1px solid #e2e8f0;\r\n        }\r\n\r\n        .info-row {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 8px 0;\r\n            border-bottom: 1px dashed #e2e8f0;\r\n        }\r\n\r\n        .info-row:last-child {\r\n            border-bottom: none;\r\n        }\r\n\r\n        .info-label {\r\n            color: #64748b;\r\n            font-size: 11px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .info-value {\r\n            color: #1e293b;\r\n            font-weight: 600;\r\n            font-size: 12px;\r\n        }\r\n\r\n        .info-highlight {\r\n            color: #3498db;\r\n            font-weight: 700;\r\n        }\r\n\r\n        /* Loan Summary Cards */\r\n        .summary-cards {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 12px;\r\n            margin: 15px 0;\r\n        }\r\n\r\n        .summary-card {\r\n            background: white;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border: 1px solid #e2e8f0;\r\n            text-align: center;\r\n            border-top: 3px solid #3498db;\r\n        }\r\n\r\n        .summary-label {\r\n            font-size: 10px;\r\n            color: #64748b;\r\n            margin-bottom: 6px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .summary-value {\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n            color: #2c3e50;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        .summary-value.positive {\r\n            color: #27ae60;\r\n        }\r\n\r\n        .summary-value.warning {\r\n            color: #e67e22;\r\n        }\r\n\r\n        .summary-value.danger {\r\n            color: #e74c3c;\r\n        }\r\n\r\n        /* Interest Card */\r\n        .interest-card {\r\n            background: #f0f9ff;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border: 1px solid #bae6fd;\r\n            margin: 15px 0;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n        }\r\n\r\n        .interest-info {\r\n            display: flex;\r\n            gap: 30px;\r\n        }\r\n\r\n        .interest-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .interest-label {\r\n            font-size: 10px;\r\n            color: #64748b;\r\n            margin-bottom: 4px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .interest-value {\r\n            font-size: 14px;\r\n            font-weight: 700;\r\n            color: #2c3e50;\r\n        }\r\n\r\n        .interest-badge {\r\n            background: #3498db;\r\n            color: white;\r\n            padding: 5px 15px;\r\n            border-radius: 20px;\r\n            font-size: 11px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Payment Schedule Table */\r\n        .schedule-section {\r\n            margin: 20px 0;\r\n        }\r\n\r\n        .schedule-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-top: 10px;\r\n            font-size: 11px;\r\n        }\r\n\r\n        .schedule-table thead {\r\n            background: linear-gradient(to right, #2c3e50, #34495e);\r\n        }\r\n\r\n        .schedule-table th {\r\n            padding: 12px 8px;\r\n            text-align: left;\r\n            font-weight: 600;\r\n            color: white;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n            border: none;\r\n            font-size: 10px;\r\n        }\r\n\r\n        .schedule-table td {\r\n            padding: 10px 8px;\r\n            border-bottom: 1px solid #e2e8f0;\r\n        }\r\n\r\n        .schedule-table tbody tr:nth-child(even) {\r\n            background-color: #f8fafc;\r\n        }\r\n\r\n        .schedule-table tbody tr:hover {\r\n            background-color: #f1f5f9;\r\n        }\r\n\r\n        .paid-badge {\r\n            background: #27ae60;\r\n            color: white;\r\n            padding: 3px 8px;\r\n            border-radius: 4px;\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .pending-badge {\r\n            background: #f39c12;\r\n            color: white;\r\n            padding: 3px 8px;\r\n            border-radius: 4px;\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Payment Details */\r\n        .payment-details {\r\n            background: #f8fafc;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border: 1px solid #e2e8f0;\r\n            margin: 15px 0;\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 15px;\r\n        }\r\n\r\n        .payment-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .payment-label {\r\n            font-size: 10px;\r\n            color: #64748b;\r\n            margin-bottom: 4px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .payment-value {\r\n            font-size: 13px;\r\n            font-weight: 600;\r\n            color: #2c3e50;\r\n        }\r\n\r\n        /* Progress Bar */\r\n        .progress-section {\r\n            margin: 15px 0;\r\n        }\r\n\r\n        .progress-info {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            margin-bottom: 5px;\r\n            font-size: 11px;\r\n        }\r\n\r\n        .progress-bar {\r\n            height: 20px;\r\n            background: #edf2f7;\r\n            border-radius: 10px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .progress-fill {\r\n            height: 100%;\r\n            background: linear-gradient(to right, #3498db, #2c3e50);\r\n            color: white;\r\n            font-size: 10px;\r\n            line-height: 20px;\r\n            padding-left: 10px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Footer */\r\n        .footer-section {\r\n            margin-top: 30px;\r\n            padding-top: 20px;\r\n            border-top: 2px solid #e2e8f0;\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 40px;\r\n        }\r\n\r\n        .signature-box {\r\n            text-align: center;\r\n        }\r\n\r\n        .signature-line {\r\n            border-top: 1px solid #94a3b8;\r\n            padding-top: 10px;\r\n            margin-top: 30px;\r\n            position: relative;\r\n        }\r\n\r\n        .signature-label {\r\n            position: absolute;\r\n            top: -8px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            background: white;\r\n            padding: 0 10px;\r\n            font-size: 10px;\r\n            color: #64748b;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .signature-name {\r\n            margin-top: 5px;\r\n            font-size: 11px;\r\n            color: #2c3e50;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .print-info {\r\n            text-align: center;\r\n            color: #94a3b8;\r\n            font-size: 9px;\r\n            margin-top: 20px;\r\n            padding-top: 10px;\r\n            border-top: 1px solid #e2e8f0;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        /* Utility */\r\n        .text-right { text-align: right; }\r\n        .text-center { text-align: center; }\r\n        .text-mono { font-family: 'SF Mono', 'Monaco', 'Consolas', monospace; }\r\n        .mb-10 { margin-bottom: 10px; }\r\n        .mt-20 { margin-top: 20px; }\r\n        \r\n        .empty-state {\r\n            text-align: center;\r\n            color: #94a3b8;\r\n            font-style: italic;\r\n            padding: 30px;\r\n            background: #f8fafc;\r\n            border-radius: 8px;\r\n            margin: 20px 0;\r\n        }\r\n\r\n        /* Column widths */\r\n        .col-sn { width: 40px; text-align: center; }\r\n        .col-date { width: 90px; }\r\n        .col-principal { width: 90px; text-align: right; }\r\n        .col-interest { width: 80px; text-align: right; }\r\n        .col-total { width: 90px; text-align: right; }\r\n        .col-status { width: 70px; text-align: center; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"report-container\">\r\n        <!-- Header -->\r\n        <div class=\"header-section\">\r\n            <div class=\"company-logo\">\r\n                <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                    <path d=\"M12 2L4 7v6.5C4 19 8 22 12 22s8-3 8-8.5V7l-8-5zm0 2.18l6 3.75v5.57c0 3.9-3.13 6.5-6 6.5s-6-2.6-6-6.5V7.93l6-3.75z\"/>\r\n                </svg>\r\n            </div>\r\n            <div class=\"title-section\">\r\n                <div class=\"report-title\">STAFF LOAN PAYMENT</div>\r\n                <div class=\"report-subtitle\">Loan Repayment Schedule & Statement</div>\r\n            </div>\r\n            <div class=\"loan-badge\">\r\n                <span>LOAN ID</span>\r\n                {{ doc.name }}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Basic Information -->\r\n        <div class=\"info-grid\">\r\n            <div class=\"info-card\">\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Employee</span>\r\n                    <span class=\"info-value info-highlight\">{{ doc.employee_name }}</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Employee ID</span>\r\n                    <span class=\"info-value\">{{ doc.employee }}</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Company</span>\r\n                    <span class=\"info-value\">{{ doc.company }}</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Posting Date</span>\r\n                    <span class=\"info-value\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"info-card\">\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Loan Type</span>\r\n                    <span class=\"info-value info-highlight\">{{ doc.loan_type }}</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Status</span>\r\n                    <span class=\"info-value\">\r\n                        {% if doc.status == 'Active' %}\r\n                            <span class=\"status-badge status-active\">{{ doc.status }}</span>\r\n                        {% elif doc.status == 'Completed' %}\r\n                            <span class=\"status-badge status-completed\">{{ doc.status }}</span>\r\n                        {% elif doc.docstatus == 0 %}\r\n                            <span class=\"status-badge status-draft\">Draft</span>\r\n                        {% elif doc.status == 'Cancelled' %}\r\n                            <span class=\"status-badge status-cancelled\">{{ doc.status }}</span>\r\n                        {% endif %}\r\n                    </span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Repayment Period</span>\r\n                    <span class=\"info-value\">{{ frappe.format(doc.start_date, {'fieldtype': 'Date'}) }} - {{ frappe.format(doc.end_date, {'fieldtype': 'Date'}) }}</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Installments</span>\r\n                    <span class=\"info-value\">{{ doc.number_of_installments }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Loan Summary Cards -->\r\n        <div class=\"summary-cards\">\r\n            <div class=\"summary-card\">\r\n                <div class=\"summary-label\">Total Loan</div>\r\n                <div class=\"summary-value\">{{ frappe.utils.fmt_money(doc.total_loan_amount) }}</div>\r\n            </div>\r\n            <div class=\"summary-card\">\r\n                <div class=\"summary-label\">Monthly Deduction</div>\r\n                <div class=\"summary-value\">{{ frappe.utils.fmt_money(doc.monthly_deduction_amount) }}</div>\r\n            </div>\r\n            <div class=\"summary-card\">\r\n                <div class=\"summary-label\">Total Deducted</div>\r\n                <div class=\"summary-value positive\">{{ frappe.utils.fmt_money(doc.total_deducted_amount or 0) }}</div>\r\n            </div>\r\n            <div class=\"summary-card\">\r\n                <div class=\"summary-label\">Outstanding</div>\r\n                <div class=\"summary-value {% if doc.outstanding_amount > 0 %}danger{% else %}positive{% endif %}\">\r\n                    {{ frappe.utils.fmt_money(doc.outstanding_amount or 0) }}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Interest Information -->\r\n        {% if doc.apply_interest %}\r\n        <div class=\"interest-card\">\r\n            <div class=\"interest-info\">\r\n                <div class=\"interest-item\">\r\n                    <div class=\"interest-label\">Interest Rate</div>\r\n                    <div class=\"interest-value\">{{ doc.interest_rate }}% p.a.</div>\r\n                </div>\r\n                <div class=\"interest-item\">\r\n                    <div class=\"interest-label\">Calculation Method</div>\r\n                    <div class=\"interest-value\">{{ doc.interest_calculation_method }}</div>\r\n                </div>\r\n                <div class=\"interest-item\">\r\n                    <div class=\"interest-label\">Total Interest</div>\r\n                    <div class=\"interest-value\">{{ frappe.utils.fmt_money(doc.total_interest or 0) }}</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"interest-badge\">INTEREST BEARING LOAN</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Payment Details -->\r\n        <div class=\"section-title\">\ud83d\udcb3 Payment Details</div>\r\n        <div class=\"payment-details\">\r\n            <div class=\"payment-item\">\r\n                <div class=\"payment-label\">Mode of Payment</div>\r\n                <div class=\"payment-value\">{{ doc.mode_of_payment or \"Not specified\" }}</div>\r\n            </div>\r\n            <div class=\"payment-item\">\r\n                <div class=\"payment-label\">Payment Account</div>\r\n                <div class=\"payment-value\">{{ doc.payment_account or \"Not specified\" }}</div>\r\n            </div>\r\n            <div class=\"payment-item\">\r\n                <div class=\"payment-label\">Loan Account</div>\r\n                <div class=\"payment-value\">{{ doc.loan_account or \"Not specified\" }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        {% if doc.payment_entry %}\r\n        <div class=\"payment-details\" style=\"background: #f0fdf4; border-color: #86efac;\">\r\n            <div class=\"payment-item\" style=\"grid-column: span 3;\">\r\n                <div class=\"payment-label\">Disbursement Payment Entry</div>\r\n                <div class=\"payment-value info-highlight\">{{ doc.payment_entry }}</div>\r\n            </div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Repayment Schedule -->\r\n        <div class=\"section-title\">\ud83d\udcc5 Repayment Schedule</div>\r\n        <div class=\"schedule-section\">\r\n            {% if doc.loan_deduction_schedule and doc.loan_deduction_schedule|length > 0 %}\r\n            \r\n            <!-- Progress Bar -->\r\n            <div class=\"progress-section\">\r\n                {% set total_paid = doc.total_deducted_amount or 0 %}\r\n                {% set total_loan = doc.total_loan_amount %}\r\n                {% set progress = (total_paid / total_loan * 100) if total_loan > 0 else 0 %}\r\n                \r\n                <div class=\"progress-info\">\r\n                    <span>Repayment Progress</span>\r\n                    <span>{{ \"%.1f\"|format(progress) }}% Complete</span>\r\n                </div>\r\n                <div class=\"progress-bar\">\r\n                    <div class=\"progress-fill\" style=\"width: {{ progress }}%;\">\r\n                        {% if progress > 15 %}{{ \"%.1f\"|format(progress) }}%{% endif %}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <table class=\"schedule-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th class=\"col-sn\">#</th>\r\n                        <th class=\"col-date\">Payment Date</th>\r\n                        <th class=\"col-principal\">Principal</th>\r\n                        <th class=\"col-interest\">Interest</th>\r\n                        <th class=\"col-total\">Total Amount</th>\r\n                        <th class=\"col-status\">Status</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for row in doc.loan_deduction_schedule %}\r\n                    <tr>\r\n                        <td style=\"text-align: center;\">{{ loop.index }}</td>\r\n                        <td>{{ frappe.format(row.payment_date, {'fieldtype': 'Date'}) }}</td>\r\n                        <td style=\"text-align: right; font-family: 'SF Mono', monospace;\">\r\n                            {{ frappe.utils.fmt_money(row.principal_amount or 0) }}\r\n                        </td>\r\n                        <td style=\"text-align: right; font-family: 'SF Mono', monospace; color: #e67e22;\">\r\n                            {{ frappe.utils.fmt_money(row.interest_amount or 0) }}\r\n                        </td>\r\n                        <td style=\"text-align: right; font-family: 'SF Mono', monospace; font-weight: 700;\">\r\n                            {{ frappe.utils.fmt_money(row.deduction_amount or 0) }}\r\n                        </td>\r\n                        <td style=\"text-align: center;\">\r\n                            {% if row.is_paid %}\r\n                                <span class=\"paid-badge\">PAID</span>\r\n                            {% else %}\r\n                                <span class=\"pending-badge\">PENDING</span>\r\n                            {% endif %}\r\n                        </td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n\r\n            <!-- Schedule Summary -->\r\n            <div style=\"margin-top: 15px; padding: 12px; background: #f8fafc; border-radius: 6px; font-size: 11px; display: flex; justify-content: space-between;\">\r\n                <span>\r\n                    <strong>Total Installments:</strong> {{ doc.loan_deduction_schedule|length }}\r\n                </span>\r\n                <span>\r\n                    <strong>Paid:</strong> \r\n                    {% set paid_count = doc.loan_deduction_schedule|selectattr('is_paid')|list|length %}\r\n                    {{ paid_count }} ({{ frappe.utils.fmt_money(doc.total_deducted_amount or 0) }})\r\n                </span>\r\n                <span>\r\n                    <strong>Pending:</strong> \r\n                    {% set pending_count = doc.loan_deduction_schedule|rejectattr('is_paid')|list|length %}\r\n                    {{ pending_count }} ({{ frappe.utils.fmt_money(doc.outstanding_amount or 0) }})\r\n                </span>\r\n            </div>\r\n\r\n            {% else %}\r\n            <div class=\"empty-state\">\r\n                No repayment schedule has been generated yet.\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n\r\n        <!-- Additional Information -->\r\n        {% if doc.create_all_at_once %}\r\n        <div class=\"info-card\" style=\"background: #fef3c7; border-color: #f59e0b;\">\r\n            <div class=\"info-row\">\r\n                <span class=\"info-label\">Repayment Method</span>\r\n                <span class=\"info-value\">All deductions created at once (recurring)</span>\r\n            </div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Footer with Signatures -->\r\n        <div class=\"footer-section\">\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">PREPARED BY</span>\r\n                </div>\r\n                <div class=\"signature-name\">{{ doc.prepared_by or \"Human Resources\" }}</div>\r\n            </div>\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">AUTHORIZED BY</span>\r\n                </div>\r\n                <div class=\"signature-name\">{{ doc.authorized_by or \"Finance Department\" }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Print Info -->\r\n        <div class=\"print-info\">\r\n            Generated by Church Management System \u2022 {{ doc.name }} \u2022 Printed on: {{ frappe.utils.now_datetime().strftime('%Y-%m-%d %H:%M') }}\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>",
