 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #dc2626; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #dc2626; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #dc2626; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .confidential-box { background: #fef2f2; border: 1.5px solid #fca5a5; padding: 6px 12px; border-radius: 6px; font-size: 10px; color: #991b1b; text-align: center; margin-bottom: 10px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #dc2626; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Received { background: #fef9c3; color: #854d0e; }\n  .status-Under { background: #dbeafe; color: #1e40af; }\n  .status-Escalated { background: #fef3c7; color: #92400e; }\n  .status-Closed { background: #dcfce7; color: #166534; }\n  .status-Substantiated { background: #fee2e2; color: #991b1b; }\n  .severity-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .sev-Critical { background: #fee2e2; color: #991b1b; }\n  .sev-High { background: #fef3c7; color: #92400e; }\n  .sev-Medium { background: #fef9c3; color: #854d0e; }\n  .sev-Low { background: #dcfce7; color: #166534; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .description-box { padding: 10px 12px; background: #f8fafc; border-radius: 6px; font-size: 11px; color: #1e293b; border: 1px solid #e2e8f0; margin-bottom: 10px; line-height: 1.5; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udd0d Whistleblower Report</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"confidential-box\">\ud83d\udd12 STRICTLY CONFIDENTIAL \u2014 Victimisation of whistleblowers is prohibited</div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">Report #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Code:</span> <span class=\"value\">{{ doc.report_code }}</span></span>\n    <span class=\"item\"><span class=\"label\">Category:</span> <span class=\"value\">{{ doc.report_category }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status.replace(' ', '') }}\">{{ doc.status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">Anonymous:</span> <span class=\"value\">{% if doc.is_anonymous %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Received Date</span><span class=\"val\">{{ frappe.format_date(doc.received_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Channel</span><span class=\"val\">{{ doc.channel }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Severity</span><span class=\"val\"><span class=\"severity-badge sev-{{ doc.severity }}\">{{ doc.severity }}</span></span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Alleged Department</span><span class=\"val\">{{ doc.alleged_department or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Assigned Investigator</span><span class=\"val\">{{ doc.assigned_investigator or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Investigation Start</span><span class=\"val\">{{ frappe.format_date(doc.investigation_start) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Financial Impact</span><span class=\"val\">\u20a6{{ frappe.format_currency(doc.estimated_financial_impact) or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udcdd Description of Allegation</div>\n  <div class=\"description-box\">{{ doc.description or 'No description provided.' }}</div>\n\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Period Occurred</span><span class=\"val\">{{ doc.incident_period or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Escalated to Board</span><span class=\"val\">{% if doc.escalated_to_board %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">External Authority</span><span class=\"val\">{% if doc.external_authority_notified %}\u2705 {{ doc.authority_notified or 'Notified' }}{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Outcome</span><span class=\"val\">{{ doc.outcome or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div>\n    <div class=\"signature-box\">Assigned Investigator<br><strong>{{ doc.assigned_investigator or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udd12 Confidential \u2014 Whistleblower</span>\n  </div>\n</div>",
