 "font_size": 14,
 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #f59e0b; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #f59e0b; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #f59e0b; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #f59e0b; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }\n  .section-title .count { font-size: 10px; font-weight: 400; color: #94a3b8; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Active { background: #dcfce7; color: #166534; }\n  .status-Expiring { background: #fef9c3; color: #854d0e; }\n  .status-Expired { background: #fee2e2; color: #991b1b; }\n  .status-Renewal { background: #dbeafe; color: #1e40af; }\n  .status-Suspended { background: #e2e8f0; color: #475569; }\n  table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin: 4px 0 8px 0; }\n  table th { background: #f1f5f9; color: #1e3a5f; font-weight: 600; text-align: left; padding: 5px 8px; border: 1px solid #e2e8f0; }\n  table td { padding: 4px 8px; border: 1px solid #e2e8f0; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .note-box { padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 10.5px; color: #475569; border-left: 3px solid #f59e0b; margin-top: 8px; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udcdc License Management</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">License #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Name:</span> <span class=\"value\">{{ doc.license_name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status.replace(' ', '') }}\">{{ doc.status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">Days to Expiry:</span> <span class=\"value\">{{ doc.days_to_expiry or '\u2014' }}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">License Number</span><span class=\"val\">{{ doc.license_number }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">License Type</span><span class=\"val\">{{ doc.license_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Issuing Authority</span><span class=\"val\">{{ doc.issuing_authority }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Initial Issue Date</span><span class=\"val\">{{ frappe.format_date(doc.initial_issue_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Current Expiry</span><span class=\"val\">{{ frappe.format_date(doc.current_expiry_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Renewal Cycle</span><span class=\"val\">{{ doc.renewal_cycle_months or '12' }} months</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Renewal Cost</span><span class=\"val\">\u20a6{{ frappe.format_currency(doc.renewal_cost) or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Responsible Person</span><span class=\"val\">{{ doc.assigned_to or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Alert Email</span><span class=\"val\">{{ doc.alert_email or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Alert 90 Days</span><span class=\"val\">{% if doc.alert_90_days %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Alert 30 Days</span><span class=\"val\">{% if doc.alert_30_days %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n  </div>\n\n  {% if doc.renewal_history %}\n  <div class=\"section-title\">\ud83d\udd04 Renewal History <span class=\"count\">({{ doc.renewal_history|length }} renewals)</span></div>\n  <table>\n    <tr>\n      <th style=\"width:20%;\">Renewal Date</th>\n      <th style=\"width:20%;\">Previous Expiry</th>\n      <th style=\"width:20%;\">New Expiry</th>\n      <th style=\"width:20%;\">Cost (\u20a6)</th>\n      <th style=\"width:20%;\">Payment Ref</th>\n    </tr>\n    {% for row in doc.renewal_history[:3] %}\n    <tr>\n      <td>{{ frappe.format_date(row.renewal_date) }}</td>\n      <td>{{ frappe.format_date(row.previous_expiry) or '\u2014' }}</td>\n      <td>{{ frappe.format_date(row.new_expiry_date) }}</td>\n      <td style=\"text-align:right;\">{{ frappe.format_currency(row.renewal_cost) or '\u2014' }}</td>\n      <td>{{ row.payment_reference or '\u2014' }}</td>\n    </tr>\n    {% endfor %}\n    {% if doc.renewal_history|length > 3 %}\n    <tr><td colspan=\"5\" style=\"text-align:center;color:#94a3b8;font-size:10px;\">+ {{ doc.renewal_history|length - 3 }} more renewals</td></tr>\n    {% endif %}\n  </table>\n  {% endif %}\n\n  {% if doc.notes %}\n  <div class=\"note-box\"><strong>\ud83d\udcdd Notes:</strong> {{ doc.notes }}</div>\n  {% endif %}\n\n  <div>\n    <div class=\"signature-box\">Responsible Person<br><strong>{{ doc.assigned_to or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udcdc License Management</span>\n  </div>\n</div>",
