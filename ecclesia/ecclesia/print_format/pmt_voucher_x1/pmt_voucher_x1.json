border: 1px solid #e2e8f0;\r\n    border-radius: 8px;\r\n    padding: 15px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.purpose-header {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.purpose-icon {\r\n    font-size: 14px;\r\n}\r\n\r\n.purpose-title {\r\n    font-weight: 700;\r\n    font-size: 11px;\r\n    color: #0f172a;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.purpose-content {\r\n    padding: 10px;\r\n    background: white;\r\n    border-radius: 6px;\r\n    border: 1px solid #e2e8f0;\r\n    font-size: 11px;\r\n    line-height: 1.6;\r\n    color: #334155;\r\n}\r\n\r\n/* Allocation Table */\r\n.invoices-section {\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.invoices-header {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.invoices-icon {\r\n    font-size: 14px;\r\n}\r\n\r\n.invoices-title {\r\n    font-weight: 700;\r\n    font-size: 11px;\r\n    color: #0f172a;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.allocation-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 10px;\r\n}\r\n\r\n.allocation-table thead {\r\n    background: #000;\r\n}\r\n\r\n.allocation-table th {\r\n    padding: 8px 6px;\r\n    color: white;\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n    font-size: 8px;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.allocation-table td {\r\n    padding: 6px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.allocation-table tbody tr:nth-child(even) {\r\n    background-color: #f8fafc;\r\n}\r\n\r\n.allocation-table tfoot td {\r\n    background: #f1f5f9;\r\n    padding: 8px 6px;\r\n    font-weight: 600;\r\n}\r\n\r\n.allocated {\r\n    font-weight: 700;\r\n    color: #000;\r\n}\r\n\r\n.total-allocated {\r\n    font-size: 11px;\r\n    color: #000;\r\n}\r\n\r\n/* Invoice Details (simple) */\r\n.invoice-details {\r\n    background: white;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 8px;\r\n    pa