 "font_size": 14,
 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #0d9488; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #0d9488; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #0d9488; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 35%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 65%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #0d9488; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Compliant { background: #dcfce7; color: #166534; }\n  .status-Minor { background: #fef9c3; color: #854d0e; }\n  .status-Material { background: #fee2e2; color: #991b1b; }\n  .status-Termination { background: #fecaca; color: #991b1b; }\n  .status-Expired { background: #e2e8f0; color: #475569; }\n  table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin: 4px 0 8px 0; }\n  table th { background: #f1f5f9; color: #1e3a5f; font-weight: 600; text-align: left; padding: 5px 8px; border: 1px solid #e2e8f0; }\n  table td { padding: 4px 8px; border: 1px solid #e2e8f0; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .note-box { padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 10.5px; color: #475569; border-left: 3px solid #0d9488; margin-top: 8px; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udcc4 Contract Compliance Record</h1>\n    <span class=\"badge\">{{ doc.compliance_status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">CCR #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Title:</span> <span class=\"value\">{{ doc.compliance_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.compliance_status.replace(' ', '') }}\">{{ doc.compliance_status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">SLA:</span> <span class=\"value\">{{ doc.sla_compliance_pct or '\u2014' }}%</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Service Contract</span><span class=\"val\">{{ doc.service_contract }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Vendor</span><span class=\"val\">{{ doc.vendor or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Contract Type</span><span class=\"val\">{{ doc.contract_type or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Contract Start</span><span class=\"val\">{{ frappe.format_date(doc.contract_start) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Contract End</span><span class=\"val\">{{ frappe.format_date(doc.contract_end) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Contract Value</span><span class=\"val\">\u20a6{{ frappe.format_currency(doc.contract_value) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">SLA Compliance</span><span class=\"val\">{{ doc.sla_compliance_pct or '\u2014' }}%</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udcca Compliance Monitoring</div>\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Last Review</span><span class=\"val\">{{ frappe.format_date(doc.last_review_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Next Review</span><span class=\"val\">{{ frappe.format_date(doc.next_review_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Review Frequency</span><span class=\"val\">{{ doc.review_frequency or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Open SLA Breaches</span><span class=\"val\">{{ doc.open_breaches or '0' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">All Obligations Met</span><span class=\"val\">{% if doc.obligations_met %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Vendor Insurance</span><span class=\"val\">{% if doc.insurance_current %}\u2705 Current{% else %}\u26a0\ufe0f Expired{% endif %}</span></div>\n    </div>\n  </div>\n\n  {% if doc.unmet_obligations %}\n  <div class=\"note-box\" style=\"border-left-color:#dc2626;\"><strong>\u26a0\ufe0f Unmet Obligations:</strong> {{ doc.unmet_obligations }}</div>\n  {% endif %}\n\n  {% if doc.key_obligations %}\n  <div class=\"section-title\">\ud83d\udccb Key Contract Obligations</div>\n  <div style=\"padding:8px 12px;background:#f8fafc;border-radius:6px;font-size:10.5px;color:#1e293b;border:1px solid #e2e8f0;margin-bottom:10px;\">{{ doc.key_obligations }}</div>\n  {% endif %}\n\n  {% if doc.compliance_notes %}\n  <div class=\"note-box\"><strong>\ud83d\udcdd Notes:</strong> {{ doc.compliance_notes }}</div>\n  {% endif %}\n\n  <div>\n    <div class=\"signature-box\">Responsible Officer<br><strong>{{ doc.responsible_officer or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n  </div>\n</div>",
