{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-18 18:08:56.906372",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Fixed Asset",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"fixed-asset\">\r\n    <!-- LETTERHEAD SUPPORT -->\r\n    {{ letter_head }}\r\n    \r\n    <!-- ASSET HEADER -->\r\n    <div class=\"asset-header\">\r\n        <div class=\"header-top\">\r\n            <div class=\"header-left\">\r\n                <h1>FIXED ASSET REGISTER</h1>\r\n                <div class=\"asset-ref\">\r\n                    <span class=\"ref-label\">Asset Code:</span> \r\n                    <span class=\"ref-value\">{{ doc.asset_code or doc.name }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"header-right\">\r\n                <div class=\"status-badge status-{{ doc.asset_status|lower|replace(' ', '-') if doc.asset_status else 'draft' }}\">\r\n                    {{ doc.asset_status or \"DRAFT\" }}\r\n                </div>\r\n                <div class=\"asset-date\">Created: {{ frappe.utils.formatdate(doc.creation, \"dd MMM yyyy\") }}</div>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- ASSET CATEGORY & TYPE -->\r\n        <div class=\"asset-type-row\">\r\n            <div class=\"category-badge\">{{ doc.asset_category or \"Category\" }}</div>\r\n            {% if doc.is_depreciable_asset %}\r\n            <div class=\"depreciable-badge\">Depreciable Asset</div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- KEY ASSET IDENTIFIERS - COMPACT -->\r\n    <div class=\"identifiers-grid\">\r\n        <div class=\"identifier-item\">\r\n            <div class=\"identifier-label\">Asset Name</div>\r\n            <div class=\"identifier-value\">{{ doc.asset_name or \"\u2014\" }}</div>\r\n        </div>\r\n        <div class=\"identifier-item\">\r\n            <div class=\"identifier-label\">Serial No</div>\r\n            <div class=\"identifier-value\">{{ doc.serial_number or \"\u2014\" }}</div>\r\n        </div>\r\n        <div class=\"identifier-item\">\r\n            <div class=\"identifier-label\">Location</div>\r\n            <div class=\"identifier-value\">{{ doc.current_location or \"\u2014\" }}</div>\r\n        </div>\r\n        <div class=\"identifier-item\">\r\n            <div class=\"identifier-label\">Custodian</div>\r\n            <div class=\"identifier-value\">{{ doc.custodian or \"\u2014\" }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- KEY METRICS CARDS -->\r\n    <div class=\"metrics-cards\">\r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Purchase Amount</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.gross_purchase_amount, currency=doc.currency or 'NGN') }}</div>\r\n            <div class=\"metric-sub\">Date: {{ frappe.utils.formatdate(doc.purchase_date, \"dd MMM yyyy\") if doc.purchase_date else \"\u2014\" }}</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Current Value</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.current_net_book_value, currency=doc.currency or 'NGN') }}</div>\r\n            <div class=\"metric-sub\">Gross: {{ frappe.utils.fmt_money(doc.current_gross_value, currency=doc.currency) }}</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Accum. Dep'n</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.current_accumulated_depreciation or 0, currency=doc.currency or 'NGN') }}</div>\r\n            <div class=\"metric-sub\">Salvage: {{ frappe.utils.fmt_money(doc.salvage_value or 0, currency=doc.currency) }}</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card highlight\">\r\n            <div class=\"metric-label\">Dep'n Progress</div>\r\n            <div class=\"metric-value {% if doc.depreciation_percentage_complete and doc.depreciation_percentage_complete > 90 %}negative{% elif doc.depreciation_percentage_complete and doc.depreciation_percentage_complete < 30 %}positive{% endif %}\">\r\n                {{ doc.depreciation_percentage_complete or \"0\" }}%\r\n            </div>\r\n            <div class=\"metric-sub\">Rate: {{ doc.depreciation_rate or \"0\" }}%</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ASSET DETAILS SECTION -->\r\n    <div class=\"details-section\">\r\n        <div class=\"section-header\">ASSET DETAILS</div>\r\n        <div class=\"details-grid\">\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Company:</span>\r\n                <span class=\"detail-value\">{{ doc.company or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Department:</span>\r\n                <span class=\"detail-value\">{{ doc.department or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Cost Center:</span>\r\n                <span class=\"detail-value\">{{ doc.cost_center or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Asset Account:</span>\r\n                <span class=\"detail-value\">{{ doc.asset_account or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Available for Use:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.available_for_use_date, \"dd MMM yyyy\") if doc.available_for_use_date else \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Quantity:</span>\r\n                <span class=\"detail-value\">{{ doc.asset_quantity or \"1\" }}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- DEPRECIATION DETAILS SECTION -->\r\n    {% if doc.is_depreciable_asset and doc.calculate_depreciation %}\r\n    <div class=\"details-section\">\r\n        <div class=\"section-header\">DEPRECIATION PARAMETERS</div>\r\n        <div class=\"details-grid\">\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Method:</span>\r\n                <span class=\"detail-value\">{{ doc.depreciation_method or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Frequency:</span>\r\n                <span class=\"detail-value\">{{ doc.depreciation_frequency or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Total Periods:</span>\r\n                <span class=\"detail-value\">{{ doc.total_number_of_depreciations or \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Useful Life:</span>\r\n                <span class=\"detail-value\">{{ doc.useful_life_months or \"\u2014\" }} months</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Start Date:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.depreciation_start_date, \"dd MMM yyyy\") if doc.depreciation_start_date else \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Next Dep'n Date:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.next_depreciation_date, \"dd MMM yyyy\") if doc.next_depreciation_date else \"\u2014\" }}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- DEPRECIATION SCHEDULE TABLE - ONLY IMPORTANT COLUMNS -->\r\n    {% if doc.depreciation_schedules and doc.depreciation_schedules|length > 0 %}\r\n    <div class=\"table-section\">\r\n        <div class=\"section-header\">DEPRECIATION SCHEDULE</div>\r\n        \r\n        <table class=\"compact-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>#</th>\r\n                    <th>Date</th>\r\n                    <th class=\"text-right\">Opening</th>\r\n                    <th class=\"text-right\">Dep'n</th>\r\n                    <th class=\"text-right\">Closing</th>\r\n                    <th class=\"text-right\">Accum</th>\r\n                    <th class=\"text-center\">Status</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set posted_count = 0 %}\r\n                {% set pending_count = 0 %}\r\n                {% set total_depreciation = 0 %}\r\n                \r\n                {% for row in doc.depreciation_schedules %}\r\n                    {% if row.journal_entry %}\r\n                        {% set posted_count = posted_count + 1 %}\r\n                    {% else %}\r\n                        {% set pending_count = pending_count + 1 %}\r\n                    {% endif %}\r\n                    {% set total_depreciation = total_depreciation + row.depreciation_amount|float %}\r\n                <tr>\r\n                    <td>{{ loop.index }}</td>\r\n                    <td>{{ frappe.utils.formatdate(row.schedule_date, \"dd MMM yyyy\") }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.opening_balance or 0, currency=doc.currency) }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.depreciation_amount, currency=doc.currency) }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.closing_balance or 0, currency=doc.currency) }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.accumulated_depreciation or 0, currency=doc.currency) }}</td>\r\n                    <td class=\"text-center\">\r\n                        {% if row.journal_entry %}\r\n                        <span class=\"status-indicator success\">Posted</span>\r\n                        {% else %}\r\n                        <span class=\"status-indicator pending\">Scheduled</span>\r\n                        {% endif %}\r\n                    </td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n            <tfoot>\r\n                <tr>\r\n                    <td colspan=\"3\"><strong>SUMMARY</strong></td>\r\n                    <td class=\"text-right\"><strong>{{ frappe.utils.fmt_money(total_depreciation, currency=doc.currency) }}</strong></td>\r\n                    <td colspan=\"3\" class=\"text-right\">\r\n                        <span class=\"summary-badge\">Posted: {{ posted_count }}</span>\r\n                        <span class=\"summary-badge pending\">Pending: {{ pending_count }}</span>\r\n                    </td>\r\n                </tr>\r\n            </tfoot>\r\n        </table>\r\n        \r\n        {% if doc.last_depreciation_date %}\r\n        <div class=\"schedule-footer\">\r\n            Last Depreciation: {{ frappe.utils.formatdate(doc.last_depreciation_date, \"dd MMM yyyy\") }}\r\n            {% if doc.next_depreciation_date %}\r\n            | Next: {{ frappe.utils.formatdate(doc.next_depreciation_date, \"dd MMM yyyy\") }}\r\n            {% endif %}\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- WARRANTY & INSURANCE SECTION -->\r\n    <div class=\"clauses-section\">\r\n        <div class=\"section-header\">WARRANTY & INSURANCE</div>\r\n        <div class=\"clauses-grid\">\r\n            {% if doc.warranty_expiry_date %}\r\n            <div class=\"clause-item\">\r\n                <span class=\"clause-name\">Warranty Expires:</span>\r\n                <span class=\"clause-value {% if getdate(doc.warranty_expiry_date) < getdate(nowdate()) %}expired{% endif %}\">\r\n                    {{ frappe.utils.formatdate(doc.warranty_expiry_date, \"dd MMM yyyy\") }}\r\n                </span>\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.insurance_expiry_date %}\r\n            <div class=\"clause-item\">\r\n                <span class=\"clause-name\">Insurance Expires:</span>\r\n                <span class=\"clause-value {% if getdate(doc.insurance_expiry_date) < getdate(nowdate()) %}expired{% endif %}\">\r\n                    {{ frappe.utils.formatdate(doc.insurance_expiry_date, \"dd MMM yyyy\") }}\r\n                </span>\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.insurance_value %}\r\n            <div class=\"clause-item\">\r\n                <span class=\"clause-name\">Insured Value:</span>\r\n                <span class=\"clause-value\">{{ frappe.utils.fmt_money(doc.insurance_value, currency=doc.currency) }}</span>\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.insurance_policy_no %}\r\n            <div class=\"clause-item\">\r\n                <span class=\"clause-name\">Policy No:</span>\r\n                <span class=\"clause-value\">{{ doc.insurance_policy_no }}</span>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MANUFACTURER DETAILS -->\r\n    {% if doc.manufacturer or doc.model_number %}\r\n    <div class=\"details-section\">\r\n        <div class=\"section-header\">MANUFACTURER DETAILS</div>\r\n        <div class=\"details-grid\">\r\n            {% if doc.manufacturer %}\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Manufacturer:</span>\r\n                <span class=\"detail-value\">{{ doc.manufacturer }}</span>\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.model_number %}\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Model:</span>\r\n                <span class=\"detail-value\">{{ doc.model_number }}</span>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- NOTES -->\r\n    {% if doc.asset_description %}\r\n    <div class=\"notes-section\">\r\n        <div class=\"notes-title\">Description</div>\r\n        <div class=\"notes-content\">{{ doc.asset_description|striptags|truncate(200) }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- QR CODE SECTION (if available) -->\r\n    {% if doc.qr_code_image %}\r\n    <div class=\"qr-section\">\r\n        <div class=\"qr-label\">QR Code</div>\r\n        <div class=\"qr-container\">\r\n            <img src=\"{{ doc.qr_code_image }}\" alt=\"QR Code\" class=\"qr-image\">\r\n            <div class=\"qr-text\">{{ doc.asset_code }}</div>\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- SIGNATURES -->\r\n    <div class=\"signatures-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"sig-line\"></div>\r\n            <div class=\"sig-label\">Prepared By</div>\r\n            <div class=\"sig-name\">{{ doc.owner or \"____________________\" }}</div>\r\n            <div class=\"sig-date\">{{ frappe.utils.formatdate(doc.creation, \"dd MMM yyyy\") }}</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"sig-line\"></div>\r\n            <div class=\"sig-label\">Authorized By</div>\r\n            <div class=\"sig-name\">{{ doc.modified_by or \"____________________\" }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n    <div class=\"footer\">\r\n        <span>Generated: {{ frappe.utils.now_datetime().strftime(\"%d %b %Y %H:%M\") }}</span>\r\n        <span> | Asset: {{ doc.asset_code }}</span>\r\n        <span> | Company: {{ doc.company }}</span>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n.fixed-asset {\r\n    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;\r\n    max-width: 780px;\r\n    margin: 0 auto;\r\n    color: #1e293b;\r\n    font-size: 10px;\r\n    padding: 12px;\r\n}\r\n\r\n/* Asset Header */\r\n.asset-header {\r\n    margin-bottom: 12px;\r\n    padding-bottom: 8px;\r\n    border-bottom: 2px solid #0f3b5e;\r\n}\r\n\r\n.header-top {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.header-left h1 {\r\n    margin: 0;\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    color: #0f3b5e;\r\n}\r\n\r\n.asset-ref {\r\n    font-size: 10px;\r\n    color: #4b5563;\r\n    margin-top: 2px;\r\n}\r\n\r\n.ref-label {\r\n    font-weight: 500;\r\n    color: #6b7280;\r\n}\r\n\r\n.ref-value {\r\n    font-weight: 600;\r\n    color: #0f3b5e;\r\n}\r\n\r\n.header-right {\r\n    text-align: right;\r\n}\r\n\r\n.status-badge {\r\n    display: inline-block;\r\n    padding: 4px 12px;\r\n    border-radius: 20px;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.status-draft { background: #f3f4f6; color: #6b7280; }\r\n.status-active { background: #10b981; color: white; }\r\n.status-under-maintenance { background: #f59e0b; color: white; }\r\n.status-disposed { background: #ef4444; color: white; }\r\n.status-fully-depreciated { background: #3b82f6; color: white; }\r\n.status-transferred { background: #8b5cf6; color: white; }\r\n.status-scrapped { background: #6b7280; color: white; }\r\n.status-cancelled { background: #6b7280; color: white; }\r\n\r\n.asset-date {\r\n    font-size: 9px;\r\n    color: #4b5563;\r\n    margin-top: 2px;\r\n}\r\n\r\n.asset-type-row {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin-top: 5px;\r\n}\r\n\r\n.category-badge {\r\n    display: inline-block;\r\n    padding: 4px 12px;\r\n    border-radius: 16px;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    background: white;\r\n    border: 1px solid #0f3b5e;\r\n    color: #0f3b5e;\r\n}\r\n\r\n.depreciable-badge {\r\n    display: inline-block;\r\n    padding: 4px 12px;\r\n    border-radius: 16px;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    background: #e0f2fe;\r\n    color: #0369a1;\r\n    border: 1px solid #7dd3fc;\r\n}\r\n\r\n/* Identifiers Grid */\r\n.identifiers-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 8px;\r\n    margin-bottom: 15px;\r\n    background: #f8fafc;\r\n    padding: 8px 10px;\r\n    border-radius: 6px;\r\n    border: 1px solid #e2e8f0;\r\n}\r\n\r\n.identifier-item {\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.identifier-label {\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    color: #64748b;\r\n    font-weight: 600;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.identifier-value {\r\n    font-size: 10px;\r\n    font-weight: 600;\r\n    color: #0f172a;\r\n}\r\n\r\n/* Metrics Cards */\r\n.metrics-cards {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 8px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.metric-card {\r\n    background: white;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 8px;\r\n    text-align: center;\r\n}\r\n\r\n.metric-card.highlight {\r\n    background: #f0f7ff;\r\n    border-color: #0f3b5e;\r\n}\r\n\r\n.metric-label {\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    color: #64748b;\r\n    font-weight: 600;\r\n    margin-bottom: 2px;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.metric-value {\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    color: #0f172a;\r\n}\r\n\r\n.metric-value.positive { color: #059669; }\r\n.metric-value.negative { color: #dc2626; }\r\n\r\n.metric-sub {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n    margin-top: 2px;\r\n}\r\n\r\n/* Details Section */\r\n.details-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.section-header {\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    color: #0f3b5e;\r\n    margin-bottom: 8px;\r\n    padding-bottom: 3px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.details-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 6px;\r\n}\r\n\r\n.detail-item {\r\n    display: flex;\r\n    padding: 3px 0;\r\n    border-bottom: 1px dashed #e2e8f0;\r\n}\r\n\r\n.detail-label {\r\n    width: 100px;\r\n    color: #64748b;\r\n    font-weight: 500;\r\n    font-size: 9px;\r\n}\r\n\r\n.detail-value {\r\n    flex: 1;\r\n    text-align: right;\r\n    font-weight: 600;\r\n    font-size: 9px;\r\n    color: #0f172a;\r\n}\r\n\r\n/* Tables */\r\n.table-section {\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.compact-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 8px;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    overflow: hidden;\r\n}\r\n\r\n.compact-table thead {\r\n    background: #0f3b5e;\r\n}\r\n\r\n.compact-table th {\r\n    padding: 5px 4px;\r\n    color: white;\r\n    font-weight: 600;\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.compact-table td {\r\n    padding: 4px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.compact-table tbody tr:nth-child(even) {\r\n    background-color: #f8fafc;\r\n}\r\n\r\n.compact-table tfoot {\r\n    background: #f1f5f9;\r\n    font-weight: 600;\r\n}\r\n\r\n.compact-table tfoot td {\r\n    padding: 5px 4px;\r\n}\r\n\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\n.status-indicator {\r\n    display: inline-block;\r\n    padding: 2px 6px;\r\n    border-radius: 10px;\r\n    font-size: 7px;\r\n    font-weight: 600;\r\n}\r\n\r\n.status-indicator.success {\r\n    background: #dcfce7;\r\n    color: #166534;\r\n}\r\n\r\n.status-indicator.pending {\r\n    background: #fef3c7;\r\n    color: #92400e;\r\n}\r\n\r\n.summary-badge {\r\n    display: inline-block;\r\n    padding: 2px 6px;\r\n    border-radius: 10px;\r\n    background: #e2e8f0;\r\n    color: #334155;\r\n    font-size: 7px;\r\n    margin-left: 5px;\r\n}\r\n\r\n.summary-badge.pending {\r\n    background: #fef3c7;\r\n    color: #92400e;\r\n}\r\n\r\n.schedule-footer {\r\n    margin-top: 5px;\r\n    font-size: 8px;\r\n    color: #64748b;\r\n    text-align: right;\r\n}\r\n\r\n/* Clauses Section */\r\n.clauses-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.clauses-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 6px;\r\n}\r\n\r\n.clause-item {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    padding: 3px 0;\r\n    border-bottom: 1px dashed #e2e8f0;\r\n}\r\n\r\n.clause-name {\r\n    color: #64748b;\r\n    font-weight: 500;\r\n    font-size: 9px;\r\n}\r\n\r\n.clause-value {\r\n    font-weight: 600;\r\n    font-size: 9px;\r\n    color: #0f172a;\r\n}\r\n\r\n.clause-value.expired {\r\n    color: #dc2626;\r\n}\r\n\r\n/* Notes Section */\r\n.notes-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.notes-title {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #0f3b5e;\r\n    margin-bottom: 4px;\r\n    padding-bottom: 2px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.notes-content {\r\n    font-size: 9px;\r\n    color: #4b5563;\r\n    line-height: 1.4;\r\n}\r\n\r\n/* QR Code Section */\r\n.qr-section {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 15px;\r\n    margin-bottom: 15px;\r\n    padding: 10px;\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n}\r\n\r\n.qr-label {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #0f3b5e;\r\n    width: 60px;\r\n}\r\n\r\n.qr-container {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n}\r\n\r\n.qr-image {\r\n    width: 60px;\r\n    height: 60px;\r\n    border: 1px solid #e2e8f0;\r\n    padding: 2px;\r\n}\r\n\r\n.qr-text {\r\n    font-size: 9px;\r\n    color: #4b5563;\r\n    font-weight: 500;\r\n}\r\n\r\n/* Signatures */\r\n.signatures-section {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 20px;\r\n    margin: 15px 0 8px;\r\n}\r\n\r\n.signature-box {\r\n    text-align: center;\r\n}\r\n\r\n.sig-line {\r\n    border-top: 1px solid #94a3b8;\r\n    width: 100%;\r\n    margin-bottom: 4px;\r\n    padding-top: 15px;\r\n}\r\n\r\n.sig-label {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n    font-weight: 500;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n.sig-name {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #0f172a;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n.sig-date {\r\n    font-size: 7px;\r\n    color: #94a3b8;\r\n}\r\n\r\n/* Footer */\r\n.footer {\r\n    border-top: 1px solid #e2e8f0;\r\n    margin-top: 10px;\r\n    padding-top: 5px;\r\n    text-align: center;\r\n    color: #64748b;\r\n    font-size: 7px;\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: 10px;\r\n}\r\n\r\n/* Print Styles */\r\n@media print {\r\n    .fixed-asset {\r\n        max-width: 100%;\r\n        padding: 0;\r\n    }\r\n    \r\n    @page {\r\n        size: A4;\r\n        margin: 10mm 8mm;\r\n    }\r\n}\r\n</style>",
