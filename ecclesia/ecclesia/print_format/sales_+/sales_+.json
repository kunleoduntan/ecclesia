 "css": "/* Style for integer input fields */\r\n[data-fieldtype=\"Int\"] .value {\r\n    text-align: left;\r\n    padding: 4px;\r\n    border: 2px solid #aaa; /* Thinner border */\r\n    border-radius: 8px;\r\n    background-color: #f9f9f9;\r\n    font-family: 'Calibri', sans-serif;\r\n    font-size: 14px;\r\n    line-height: 1.0; /* Reduces the space between lines within the field */\r\n    margin-bottom: 0px; /* Removes the gap between text elements */\r\n    transition: border-color 0.3s ease;\r\n}\r\n\r\n[data-fieldtype=\"Int\"] .value:focus {\r\n    border-color: #4CAF50; /* Green color for focused fields */\r\n    background-color: #e8f5e9;\r\n    outline: none;\r\n}\r\n\r\n/* Style for section breaks */\r\n.section-break {\r\n    padding: 0px 0px; /* Further reduced padding for a tighter look */\r\n    border-bottom: 0px solid #ddd; /* Thinner border */\r\n    margin-bottom: 0px; /* Reduced margin between sections */\r\n}\r\n\r\n.section-break:last-child {\r\n    padding-bottom: 0px;\r\n    border-bottom: 2px;\r\n    margin-bottom: 0;\r\n}\r\n\r\n/* Adding a subtle shadow to the sections */\r\n.section-break {\r\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); /* Light shadow for subtle depth */\r\n}\r\n\r\n/* Table styling */\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse; /* Removes space between table cells */\r\n    border-spacing: 0; /* Closes any gaps between rows */\r\n}\r\n\r\ntable th, table td {\r\n    padding: 2px 2px; /* Further reduced padding in table cells */\r\n    text-align: left; /* Align text to the left */\r\n    border: 1px solid #ddd; /* Light border for table cells */\r\n    margin: 0; /* Ensures no extra margin between rows */\r\n}\r\n\r\ntable th {\r\n    background-color: #e0f2f1; /* Light green color for table header */\r\n    color: #333; /* Darker text color for contrast */\r\n    font-weight: bold;\r\n}\r\n\r\ntable td {\r\n    background-color: #f9f9f9; /* Light background for table cells */\r\n}\r\n\r\n/* Optional: Adding a hover effect for table rows */\r\ntable tr:hover {\r\n    background-color: #f1f8e9; /* Light green background on hover */\r\n}\r\n",
 "custom_format": 1,
 "default_print_language": "en",
