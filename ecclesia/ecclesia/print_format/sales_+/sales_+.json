 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"print-format\" style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 210mm; margin: 0 auto; padding: 20px; color: #333;\">\r\n    <!-- Header Section -->\r\n    <div style=\"border-bottom: 3px solid #4A90E2; padding-bottom: 20px; margin-bottom: 30px;\">\r\n        <div style=\"display: flex; justify-content: space-between; align-items: start;\">\r\n            <div>\r\n                {% if letter_head and doc.letter_head %}\r\n                    {{ letter_head }}\r\n                {% else %}\r\n                    <h1 style=\"margin: 0; color: #4A90E2; font-size: 28px;\">{{ doc.company }}</h1>\r\n                    <p style=\"margin: 5px 0; color: #666;\">{{ doc.company_address_display or \"\" }}</p>\r\n                {% endif %}\r\n            </div>\r\n            <div style=\"text-align: right;\">\r\n                <h2 style=\"margin: 0; color: #4A90E2; font-size: 24px;\">Sales Invoice</h2>\r\n                <p style=\"margin: 5px 0; font-size: 14px; color: #666;\">{{ doc.name }}</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Info Grid -->\r\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px;\">\r\n        <!-- Customer Info -->\r\n        <div style=\"background: #F8F9FA; padding: 15px; border-radius: 8px; border-left: 4px solid #4A90E2;\">\r\n            <h3 style=\"margin: 0 0 10px 0; color: #4A90E2; font-size: 16px;\">\r\n                <span style=\"margin-right: 8px;\">\ud83d\udc64</span>Customer Details\r\n            </h3>\r\n            <p style=\"margin: 5px 0; font-weight: bold; font-size: 15px;\">{{ doc.customer_name }}</p>\r\n            <p style=\"margin: 5px 0; color: #666; font-size: 13px; line-height: 1.6;\">\r\n                {{ doc.customer_address or doc.address_display or \"\" }}\r\n            </p>\r\n            {% if doc.contact_person %}\r\n            <p style=\"margin: 8px 0 0 0; color: #666; font-size: 13px;\">\r\n                <strong>Contact:</strong> {{ doc.contact_person }}\r\n            </p>\r\n            {% endif %}\r\n            {% if doc.contact_mobile %}\r\n            <p style=\"margin: 4px 0 0 0; color: #666; font-size: 13px;\">\r\n                <strong>Phone:</strong> {{ doc.contact_mobile }}\r\n            </p>\r\n            {% endif %}\r\n        </div>\r\n\r\n        <!-- Order Info -->\r\n        <div style=\"background: #F8F9FA; padding: 15px; border-radius: 8px; border-left: 4px solid #28A745;\">\r\n            <h3 style=\"margin: 0 0 10px 0; color: #28A745; font-size: 16px;\">\r\n                <span style=\"margin-right: 8px;\">\ud83d\udccb</span>Order Information\r\n            </h3>\r\n            <table style=\"width: 100%; font-size: 13px;\">\r\n                <tr>\r\n                    <td style=\"padding: 4px 0; color: #666;\"><strong>Date:</strong></td>\r\n                    <td style=\"padding: 4px 0;\">{{ doc.get_formatted(\"transaction_date\") }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td style=\"padding: 4px 0; color: #666;\"><strong>Start Date:</strong></td>\r\n                    <td style=\"padding: 4px 0;\">{{ doc.get_formatted(\"delivery_date\") }}</td>\r\n                </tr>\r\n                {% if doc.po_no %}\r\n                <tr>\r\n                    <td style=\"padding: 4px 0; color: #666;\"><strong>PO No:</strong></td>\r\n                    <td style=\"padding: 4px 0;\">{{ doc.po_no }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                {% if doc.tax_id %}\r\n                <tr>\r\n                    <td style=\"padding: 4px 0; color: #666;\"><strong>Tax ID:</strong></td>\r\n                    <td style=\"padding: 4px 0;\">{{ doc.tax_id }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                <tr>\r\n                    <td style=\"padding: 4px 0; color: #666;\"><strong>Status:</strong></td>\r\n                    <td style=\"padding: 4px 0;\">\r\n                        <span style=\"background: #28A745; color: white; padding: 2px 10px; border-radius: 12px; font-size: 11px;\">\r\n                            {{ doc.status }}\r\n                        </span>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Items Table -->\r\n    <div style=\"margin-bottom: 30px;\">\r\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\r\n            <thead>\r\n                <tr style=\"background: #4A90E2; color: white;\">\r\n                    <th style=\"padding: 12px 8px; text-align: left; border: none;\">#</th>\r\n                    <th style=\"padding: 12px 8px; text-align: left; border: none;\">Item</th>\r\n                    <th style=\"padding: 12px 8px; text-align: center; border: none;\">Qty</th>\r\n                    <th style=\"padding: 12px 8px; text-align: right; border: none;\">Rate</th>\r\n                    <th style=\"padding: 12px 8px; text-align: right; border: none;\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.items %}\r\n                <tr style=\"border-bottom: 1px solid #E0E0E0;\">\r\n                    <td style=\"padding: 12px 8px;\">{{ loop.index }}</td>\r\n                    <td style=\"padding: 12px 8px;\">\r\n                        <strong>{{ item.item_name }}</strong>\r\n                        {% if item.description and item.description != item.item_name %}\r\n                        <br><span style=\"color: #666; font-size: 12px;\">{{ item.description }}</span>\r\n                        {% endif %}\r\n                        {% if item.item_code %}\r\n                        <br><span style=\"color: #999; font-size: 11px;\">Code: {{ item.item_code }}</span>\r\n                        {% endif %}\r\n                    </td>\r\n                    <td style=\"padding: 12px 8px; text-align: center;\">\r\n                        {{ item.get_formatted(\"qty\") }} {{ item.uom or item.stock_uom }}\r\n                    </td>\r\n                    <td style=\"padding: 12px 8px; text-align: right;\">\r\n                        {{ item.get_formatted(\"rate\") }}\r\n                    </td>\r\n                    <td style=\"padding: 12px 8px; text-align: right; font-weight: bold;\">\r\n                        {{ item.get_formatted(\"amount\") }}\r\n                    </td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Totals Section -->\r\n    <div style=\"display: flex; justify-content: flex-end; margin-bottom: 30px;\">\r\n        <div style=\"min-width: 300px; background: #F8F9FA; padding: 15px; border-radius: 8px;\">\r\n            <table style=\"width: 100%; font-size: 13px;\">\r\n                <tr>\r\n                    <td style=\"padding: 6px 0; color: #666;\">Subtotal:</td>\r\n                    <td style=\"padding: 6px 0; text-align: right;\">{{ doc.get_formatted(\"total\") }}</td>\r\n                </tr>\r\n                {% if doc.total_taxes_and_charges %}\r\n                <tr>\r\n                    <td style=\"padding: 6px 0; color: #666;\">Tax:</td>\r\n                    <td style=\"padding: 6px 0; text-align: right;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                {% if doc.discount_amount %}\r\n                <tr>\r\n                    <td style=\"padding: 6px 0; color: #DC3545;\">Discount:</td>\r\n                    <td style=\"padding: 6px 0; text-align: right; color: #DC3545;\">-{{ doc.get_formatted(\"discount_amount\") }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                <tr style=\"border-top: 2px solid #4A90E2;\">\r\n                    <td style=\"padding: 12px 0 6px 0; font-weight: bold; font-size: 16px; color: #4A90E2;\">Grand Total:</td>\r\n                    <td style=\"padding: 12px 0 6px 0; text-align: right; font-weight: bold; font-size: 16px; color: #4A90E2;\">\r\n                        {{ doc.get_formatted(\"grand_total\") }}\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Shipping Info -->\r\n    {% if doc.shipping_address_name %}\r\n    <div style=\"margin-bottom: 20px; padding: 15px; background: #E8F4FD; border-left: 4px solid #4A90E2; border-radius: 8px;\">\r\n        <h3 style=\"margin: 0 0 10px 0; color: #4A90E2; font-size: 14px;\">\ud83d\ude9a Shipping Address</h3>\r\n        <div style=\"color: #666; font-size: 12px; line-height: 1.6;\">\r\n            {{ doc.shipping_address or doc.customer_address or \"\" }}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Terms and Notes -->\r\n    {% if doc.terms %}\r\n    <div style=\"margin-bottom: 20px; padding: 15px; background: #FFF9E6; border-left: 4px solid #FFC107; border-radius: 8px;\">\r\n        <h3 style=\"margin: 0 0 10px 0; color: #F57C00; font-size: 14px;\">\ud83d\udcdd Terms & Conditions</h3>\r\n        <div style=\"color: #666; font-size: 12px; line-height: 1.6;\">\r\n            {{ doc.terms }}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer -->\r\n    <div style=\"margin-top: 50px; padding-top: 20px; border-top: 2px solid #E0E0E0; text-align: center;\">\r\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 20px;\">\r\n            <div>\r\n                <div style=\"border-top: 1px solid #999; display: inline-block; min-width: 200px; padding-top: 5px;\">\r\n                    <p style=\"margin: 0; font-size: 12px; color: #666;\">Authorized Signature</p>\r\n                </div>\r\n            </div>\r\n            <div>\r\n                <div style=\"border-top: 1px solid #999; display: inline-block; min-width: 200px; padding-top: 5px;\">\r\n                    <p style=\"margin: 0; font-size: 12px; color: #666;\">Customer Signature</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <p style=\"margin: 10px 0 0 0; color: #999; font-size: 11px;\">\r\n            This is a computer-generated document. No signature required.\r\n        </p>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n@media print {\r\n    body { margin: 0; }\r\n    .print-format { padding: 10mm; }\r\n}\r\n</style>",
