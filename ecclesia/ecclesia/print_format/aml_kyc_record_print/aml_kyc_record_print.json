 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #1e3a5f; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #1e3a5f; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #1e3a5f; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 35%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 65%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #1e3a5f; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }\n  .section-title .count { font-size: 10px; font-weight: 400; color: #94a3b8; }\n  table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin: 4px 0 8px 0; }\n  table th { background: #f1f5f9; color: #1e3a5f; font-weight: 600; text-align: left; padding: 5px 8px; border: 1px solid #e2e8f0; }\n  table td { padding: 4px 8px; border: 1px solid #e2e8f0; }\n  .badge-risk { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .risk-Low { background: #dcfce7; color: #166534; }\n  .risk-Medium { background: #fef9c3; color: #854d0e; }\n  .risk-High { background: #fee2e2; color: #991b1b; }\n  .risk-PEP { background: #fef3c7; color: #92400e; }\n  .risk-Sanctioned { background: #fee2e2; color: #991b1b; }\n  .check-yes { color: #16a34a; font-weight: 600; }\n  .check-no { color: #94a3b8; }\n  .signature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 14px; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 80%; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .note-box { padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 10.5px; color: #475569; border-left: 3px solid #1e3a5f; margin-top: 8px; }\n  @media print { .no-print { display: none; } }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udd12 AML / KYC Record</h1>\n    <span class=\"badge\">{{ doc.risk_rating or '\u2014' }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">Record:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Party:</span> <span class=\"value\">{{ doc.party_name_display }}</span></span>\n    <span class=\"item\"><span class=\"label\">Type:</span> <span class=\"value\">{{ doc.party_type }}</span></span>\n    <span class=\"item\"><span class=\"label\">KYC Level:</span> <span class=\"value\">{{ doc.kyc_level }}</span></span>\n    <span class=\"item\"><span class=\"label\">Risk:</span> <span class=\"value\"><span class=\"badge-risk risk-{{ doc.risk_rating }}\">{{ doc.risk_rating }}</span></span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Party Name</span><span class=\"val\">{{ doc.party_name_display }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Party Type</span><span class=\"val\">{{ doc.party_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">KYC Date</span><span class=\"val\">{{ frappe.format_date(doc.kyc_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">KYC Level</span><span class=\"val\">{{ doc.kyc_level }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Risk Rating</span><span class=\"val\"><span class=\"badge-risk risk-{{ doc.risk_rating }}\">{{ doc.risk_rating }}</span></span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Expiry / Review</span><span class=\"val\">{{ frappe.format_date(doc.kyc_expiry_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Responsible Officer</span><span class=\"val\">{{ doc.responsible_officer or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Approved By</span><span class=\"val\">{{ doc.approval_officer or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">ID Document</span><span class=\"val\">{{ doc.identity_document_type or '\u2014' }} {{ doc.identity_document_ref or '' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\u2705 Verification Checklist</div>\n  <table>\n    <tr>\n      <th style=\"width:30%;\">Check</th>\n      <th style=\"width:15%;\">Status</th>\n      <th style=\"width:55%;\">Details</th>\n    </tr>\n    <tr>\n      <td><strong>Identity Verified</strong></td>\n      <td>{% if doc.identity_verified %}\u2705 Yes{% else %}\u2b1c No{% endif %}</td>\n      <td>{{ doc.identity_document_type or '\u2014' }} {% if doc.identity_document_ref %}({{ doc.identity_document_ref }}){% endif %}</td>\n    </tr>\n    <tr>\n      <td><strong>Address Verified</strong></td>\n      <td>{% if doc.address_verified %}\u2705 Yes{% else %}\u2b1c No{% endif %}</td>\n      <td>\u2014</td>\n    </tr>\n    <tr>\n      <td><strong>Beneficial Owner</strong></td>\n      <td>{% if doc.beneficial_owner_identified %}\u2705 Yes{% else %}\u2b1c No{% endif %}</td>\n      <td>{{ doc.beneficial_owner_detail or '\u2014' }}</td>\n    </tr>\n    <tr>\n      <td><strong>PEP Check</strong></td>\n      <td>{% if doc.pep_check_done %}\u2705 Done{% else %}\u2b1c No{% endif %}</td>\n      <td>{% if doc.is_pep %}\u26a0\ufe0f <strong>PEP Identified</strong>{% else %}\u2713 Clear{% endif %}</td>\n    </tr>\n    <tr>\n      <td><strong>Sanctions Screening</strong></td>\n      <td>{% if doc.sanctions_check_done %}\u2705 Done{% else %}\u2b1c No{% endif %}</td>\n      <td>{% if doc.sanctions_match %}\ud83d\udeab <strong>Match Found</strong>{% else %}\u2713 Clear{% endif %}</td>\n    </tr>\n  </table>\n\n  {% if doc.screening_results %}\n  <div class=\"section-title\">\ud83d\udccb Screening History <span class=\"count\">({{ doc.screening_results|length }} records)</span></div>\n  <table>\n    <tr>\n      <th style=\"width:15%;\">Date</th>\n      <th style=\"width:20%;\">Type</th>\n      <th style=\"width:30%;\">Source</th>\n      <th style=\"width:15%;\">Result</th>\n      <th style=\"width:20%;\">Actioned By</th>\n    </tr>\n    {% for row in doc.screening_results[:4] %}\n    <tr>\n      <td>{{ frappe.format_date(row.screen_date) }}</td>\n      <td>{{ row.screening_type }}</td>\n      <td>{{ row.source_checked or '\u2014' }}</td>\n      <td>{% if row.result == 'Clear' %}\u2705 {{ row.result }}{% else %}\u26a0\ufe0f {{ row.result }}{% endif %}</td>\n      <td>{{ row.actioned_by or '\u2014' }}</td>\n    </tr>\n    {% endfor %}\n    {% if doc.screening_results|length > 4 %}\n    <tr><td colspan=\"5\" style=\"text-align:center;color:#94a3b8;font-size:10px;\">+ {{ doc.screening_results|length - 4 }} more records</td></tr>\n    {% endif %}\n  </table>\n  {% endif %}\n\n  {% if doc.notes %}\n  <div class=\"note-box\"><strong>\ud83d\udcdd Notes:</strong> {{ doc.notes }}</div>\n  {% endif %}\n\n  <div class=\"signature-grid\">\n    <div><div class=\"signature-box\">Responsible Officer<br><strong>{{ doc.responsible_officer or '________________________' }}</strong></div></div>\n    <div><div class=\"signature-box\">Approved By<br><strong>{{ doc.approval_officer or '________________________' }}</strong></div></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>Confidential \u2014 AML/KYC Record</span>\n  </div>\n</div>",
