 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #16a34a; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #16a34a; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #16a34a; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #16a34a; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Active { background: #dcfce7; color: #166534; }\n  .status-Expiring { background: #fef9c3; color: #854d0e; }\n  .status-Expired { background: #fee2e2; color: #991b1b; }\n  .status-Renewal { background: #dbeafe; color: #1e40af; }\n  .status-Suspended { background: #e2e8f0; color: #475569; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n  .note-box { padding: 8px 12px; background: #f8fafc; border-radius: 6px; font-size: 10.5px; color: #475569; border-left: 3px solid #16a34a; margin-top: 8px; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83c\udf3f Environmental Compliance Record</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">ECR #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Permit:</span> <span class=\"value\">{{ doc.permit_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status.replace(' ', '') }}\">{{ doc.status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">Days to Expiry:</span> <span class=\"value\">{{ doc.days_to_expiry or '\u2014' }}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Facility</span><span class=\"val\">{{ doc.facility or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Permit Type</span><span class=\"val\">{{ doc.permit_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Permit Number</span><span class=\"val\">{{ doc.permit_number or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Issuing Authority</span><span class=\"val\">{{ doc.issuing_authority }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Issue Date</span><span class=\"val\">{{ frappe.format_date(doc.issue_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Expiry Date</span><span class=\"val\">{{ frappe.format_date(doc.expiry_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Renewal Cost</span><span class=\"val\">\u20a6{{ frappe.format_currency(doc.renewal_cost) or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udd0d Inspection & Monitoring</div>\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Last Inspection</span><span class=\"val\">{{ frappe.format_date(doc.last_inspection_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Inspection Result</span><span class=\"val\">{{ doc.last_inspection_result or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Next Inspection</span><span class=\"val\">{{ frappe.format_date(doc.next_inspection_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Corrective Actions</span><span class=\"val\">{{ doc.corrective_actions_pending or '0' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udccb Reporting Obligations</div>\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Annual Report Required</span><span class=\"val\">{% if doc.annual_report_required %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Report Due</span><span class=\"val\">{{ frappe.format_date(doc.annual_report_due_date) or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Report Filed</span><span class=\"val\">{% if doc.annual_report_filed %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Responsible Officer</span><span class=\"val\">{{ doc.responsible_officer or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  {% if doc.notes %}\n  <div class=\"note-box\"><strong>\ud83d\udcdd Notes:</strong> {{ doc.notes }}</div>\n  {% endif %}\n\n  <div>\n    <div class=\"signature-box\">Responsible Officer<br><strong>{{ doc.responsible_officer or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83c\udf3f Environmental Compliance</span>\n  </div>\n</div>",
