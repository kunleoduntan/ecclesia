 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #b91c1c; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #b91c1c; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #b91c1c; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .confidential-box { background: #fef2f2; border: 1.5px solid #fca5a5; padding: 6px 12px; border-radius: 6px; font-size: 10px; color: #991b1b; text-align: center; margin-bottom: 10px; font-weight: 600; letter-spacing: 0.5px; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 35%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 65%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #b91c1c; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .description-box { padding: 10px 12px; background: #f8fafc; border-radius: 6px; font-size: 11px; color: #1e293b; border: 1px solid #e2e8f0; margin-bottom: 10px; line-height: 1.5; min-height: 60px; }\n  table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin: 4px 0 8px 0; }\n  table th { background: #f1f5f9; color: #1e3a5f; font-weight: 600; text-align: left; padding: 5px 8px; border: 1px solid #e2e8f0; }\n  table td { padding: 4px 8px; border: 1px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Draft { background: #f1f5f9; color: #475569; }\n  .status-Under { background: #fef9c3; color: #854d0e; }\n  .status-Submitted { background: #dbeafe; color: #1e40af; }\n  .status-Closed { background: #dcfce7; color: #166534; }\n  .status-Referred { background: #fee2e2; color: #991b1b; }\n  .signature-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 14px; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 80%; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udea8 Suspicious Transaction Report</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"confidential-box\">\ud83d\udd12 STRICTLY CONFIDENTIAL \u2014 Tipping off is a criminal offence under the Money Laundering (Prevention and Prohibition) Act 2022</div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">STR #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Title:</span> <span class=\"value\">{{ doc.str_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status.replace(' ', '') }}\">{{ doc.status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">NFIU:</span> <span class=\"value\">{% if doc.nfiu_submitted %}\u2705 Submitted{% else %}\u2b1c Pending{% endif %}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Report Type</span><span class=\"val\">{{ doc.report_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Report Date</span><span class=\"val\">{{ frappe.format_date(doc.report_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Transaction Date</span><span class=\"val\">{{ frappe.format_date(doc.transaction_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Transaction Amount</span><span class=\"val\" style=\"font-weight:700;color:#b91c1c;\">\u20a6{{ frappe.format_currency(doc.transaction_amount) }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Counterparty</span><span class=\"val\">{{ doc.party_name or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">KYC Record</span><span class=\"val\">{{ doc.kyc_record or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Suspicious Indicator</span><span class=\"val\">{{ doc.suspicious_indicators or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Transaction Type</span><span class=\"val\">{{ doc.transaction_type or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Transaction Ref</span><span class=\"val\">{{ doc.transaction_reference or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udcdd Description of Suspicious Activity</div>\n  <div class=\"description-box\">{{ doc.description or 'No description provided.' }}</div>\n\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Linked Payment</span><span class=\"val\">{{ doc.linked_payments or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Linked Receipt</span><span class=\"val\">{{ doc.linked_receipts or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Legal Counsel</span><span class=\"val\">{% if doc.legal_counsel_involved %}\u2705 Involved{% else %}\u2014{% endif %}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">NFIU Submission</span><span class=\"val\">{% if doc.nfiu_submitted %}\u2705 {{ frappe.format_date(doc.nfiu_submission_date) }}{% else %}\u2b1c Not Submitted{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">NFIU Reference</span><span class=\"val\">{{ doc.nfiu_reference or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Law Enforcement</span><span class=\"val\">{% if doc.law_enforcement_notified %}\u2705 Notified{% else %}\u2014{% endif %}</span></div>\n    </div>\n  </div>\n\n  <div class=\"signature-grid\">\n    <div><div class=\"signature-box\">Submitted By<br><strong>{{ doc.submitted_by or '________________________' }}</strong></div></div>\n    <div><div class=\"signature-box\">AMLCO Sign-off<br><strong>{{ doc.amlco_sign_off or '________________________' }}</strong></div></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udd12 Confidential \u2014 STR</span>\n  </div>\n</div>",
