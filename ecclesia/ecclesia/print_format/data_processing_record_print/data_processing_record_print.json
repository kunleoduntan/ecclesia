 "font_size": 14,
 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #2563eb; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #2563eb; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #2563eb; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #2563eb; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }\n  .section-title .count { font-size: 10px; font-weight: 400; color: #94a3b8; }\n  table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin: 4px 0 8px 0; }\n  table th { background: #f1f5f9; color: #1e3a5f; font-weight: 600; text-align: left; padding: 5px 8px; border: 1px solid #e2e8f0; }\n  table td { padding: 4px 8px; border: 1px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Active { background: #dcfce7; color: #166534; }\n  .status-Under { background: #fef9c3; color: #854d0e; }\n  .status-Discontinued { background: #e2e8f0; color: #475569; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udccb Data Processing Record</h1>\n    <span class=\"badge\">{{ doc.status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">DPR #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Title:</span> <span class=\"value\">{{ doc.processing_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.status }}\">{{ doc.status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">NITDA:</span> <span class=\"value\">{% if doc.nitda_registered %}\u2705 Registered{% else %}\u2b1c No{% endif %}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Data Controller</span><span class=\"val\">{{ doc.data_controller or doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">DPO</span><span class=\"val\">{{ doc.dpo or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Department</span><span class=\"val\">{{ doc.department or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Legal Basis</span><span class=\"val\">{{ doc.legal_basis }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Sensitive Data</span><span class=\"val\">{% if doc.is_sensitive_data %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Retention Period</span><span class=\"val\">{{ doc.retention_period }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Next Review</span><span class=\"val\">{{ frappe.format_date(doc.next_review_date) or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83c\udfaf Purpose of Processing</div>\n  <div style=\"padding:8px 12px;background:#f8fafc;border-radius:6px;font-size:10.5px;color:#1e293b;border:1px solid #e2e8f0;margin-bottom:10px;\">{{ doc.processing_purpose }}</div>\n\n  {% if doc.processing_activities %}\n  <div class=\"section-title\">\ud83d\udcbb Processing Activities <span class=\"count\">({{ doc.processing_activities|length }} activities)</span></div>\n  <table>\n    <tr>\n      <th style=\"width:18%;\">System</th>\n      <th style=\"width:18%;\">Data Category</th>\n      <th style=\"width:18%;\">Subjects</th>\n      <th style=\"width:28%;\">Purpose</th>\n      <th style=\"width:18%;\">Legal Basis</th>\n    </tr>\n    {% for row in doc.processing_activities[:4] %}\n    <tr>\n      <td>{{ row.system_name }}</td>\n      <td>{{ row.data_category }}</td>\n      <td>{{ row.data_subjects }}</td>\n      <td>{{ row.processing_purpose }}</td>\n      <td>{{ row.legal_basis }}</td>\n    </tr>\n    {% endfor %}\n    {% if doc.processing_activities|length > 4 %}\n    <tr><td colspan=\"5\" style=\"text-align:center;color:#94a3b8;font-size:10px;\">+ {{ doc.processing_activities|length - 4 }} more activities</td></tr>\n    {% endif %}\n  </table>\n  {% endif %}\n\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Third Parties Shared</span><span class=\"val\">{{ doc.third_parties_shared or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">International Transfer</span><span class=\"val\">{% if doc.international_transfer %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Transfer Countries</span><span class=\"val\">{{ doc.transfer_countries or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">DPIA Done</span><span class=\"val\">{% if doc.privacy_impact_done %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n  </div>\n\n  <div>\n    <div class=\"signature-box\">Data Protection Officer<br><strong>{{ doc.dpo or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udccb Data Processing Record</span>\n  </div>\n</div>",
