 "html": "<div class=\"official-receipt-container\">\r\n    <!-- LETTERHEAD SUPPORT (appears only once at the top of the page) -->\r\n    {{ letter_head }}\r\n    \r\n    <!-- FIRST RECEIPT -->\r\n    <div class=\"receipt-wrapper\">\r\n        <div class=\"official-receipt\">\r\n            <!-- Receipt Header with Logo and Company -->\r\n            <div class=\"receipt-header\">\r\n                <div class=\"company-branding\">\r\n                    <div class=\"logo-container\">\r\n                        <img src=\"/private/files/Lessafree.png\" alt=\"Company Logo\" class=\"company-logo\">\r\n                    </div>\r\n                    <div class=\"company-info\">\r\n                        <div class=\"company-name\">LESSAFREE</div>\r\n                        <div class=\"company-tagline\">Enterprise Solutions</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"receipt-title-section\">\r\n                    <div class=\"receipt-title\">OFFICIAL RECEIPT</div>\r\n                    <div class=\"receipt-number\">No: {{ doc.name }}</div>\r\n                </div>\r\n            </div>\r\n            \r\n            <!-- Receipt Body -->\r\n            <div class=\"receipt-body\">\r\n                <!-- Date and Reference -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Date:</div>\r\n                    <div class=\"receipt-value\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}</div>\r\n                    <div class=\"receipt-label\" style=\"margin-left: 20px;\">Ref No:</div>\r\n                    <div class=\"receipt-value\">{{ doc.reference_no or \"\u2014\" }}</div>\r\n                </div>\r\n                \r\n                <!-- Received From -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Received From:</div>\r\n                    <div class=\"receipt-value highlight\">\r\n                        {% if doc.trans_type in [\"Customer Receipt\", \"Receive from One-Off\", \"Customer Refund\"] and doc.customer_name %}\r\n                            {{ doc.customer_name }}\r\n                        {% else %}\r\n                            {{ doc.payer_name or \"\u2014\" }}\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Amount in Figures -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Amount:</div>\r\n                    <div class=\"receipt-value amount\">\r\n                        {% if doc.receipt_currency == 'NGN' %}\r\n                            {{ frappe.format_value(doc.amount_received, {'fieldtype': 'Currency', 'options': doc.receipt_currency}) }}\r\n                        {% else %}\r\n                            {{ frappe.format_value(doc.local_currency_amount, {'fieldtype': 'Currency', 'options': 'NGN'}) }}\r\n                            <span style=\"font-size: 9px; color: #666;\"> ({{ doc.receipt_currency }} {{ frappe.format_value(doc.amount_received_in_fc, {'fieldtype': 'Float'}) }})</span>\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Amount in Words -->\r\n                {% if doc.amount_in_words %}\r\n                <div class=\"receipt-row words-row\">\r\n                    <div class=\"receipt-label\">In Words:</div>\r\n                    <div class=\"receipt-value words\">{{ doc.amount_in_words }}</div>\r\n                </div>\r\n                {% endif %}\r\n                \r\n                <!-- Payment Mode -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Mode of Payment:</div>\r\n                    <div class=\"receipt-value\">{{ doc.mode_of_payment or \"\u2014\" }}</div>\r\n                </div>\r\n                \r\n                <!-- Purpose / Description -->\r\n                {% if doc.transaction_purposes %}\r\n                <div class=\"receipt-row purpose-row\">\r\n                    <div class=\"receipt-label\">Purpose:</div>\r\n                    <div class=\"receipt-value purpose\">{{ doc.transaction_purposes }}</div>\r\n                </div>\r\n                {% endif %}\r\n                \r\n                <!-- Bank Details (if applicable) -->\r\n                {% if doc.remittance_bank %}\r\n                <div class=\"receipt-row bank-row\">\r\n                    <div class=\"receipt-label\">Bank:</div>\r\n                    <div class=\"receipt-value\">{{ doc.remittance_bank }}</div>\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n            \r\n            <!-- Receipt Footer with Signatures -->\r\n            <div class=\"receipt-footer\">\r\n                <div class=\"signature-row\">\r\n                    <div class=\"signature-field\">\r\n                        <div class=\"signature-line\"></div>\r\n                        <div class=\"signature-label\">Received By</div>\r\n                    </div>\r\n                    <div class=\"signature-field\">\r\n                        <div class=\"signature-line\"></div>\r\n                        <div class=\"signature-label\">Authorized Signatory</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"stamp-area\">RECEIVED</div>\r\n                <div class=\"footer-note\">For LESSAFREE Enterprise Solutions</div>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- COPY INDICATOR -->\r\n        <div class=\"copy-indicator\">ORIGINAL COPY</div>\r\n    </div>\r\n    \r\n    <!-- SEPARATOR -->\r\n    <div class=\"receipt-separator\">\r\n        <span class=\"separator-text\">\u2726 \u2726 \u2726 \u2726 \u2726 CUT HERE \u2726 \u2726 \u2726 \u2726 \u2726</span>\r\n    </div>\r\n    \r\n    <!-- SECOND RECEIPT (DUPLICATE) -->\r\n    <div class=\"receipt-wrapper duplicate\">\r\n        <div class=\"official-receipt duplicate\">\r\n            <!-- Receipt Header with Logo and Company -->\r\n            <div class=\"receipt-header\">\r\n                <div class=\"company-branding\">\r\n                    <div class=\"logo-container\">\r\n                        <img src=\"/private/files/Lessafree.png\" alt=\"Company Logo\" class=\"company-logo\">\r\n                    </div>\r\n                    <div class=\"company-info\">\r\n                        <div class=\"company-name\">LESSAFREE</div>\r\n                        <div class=\"company-tagline\">Enterprise Solutions</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"receipt-title-section\">\r\n                    <div class=\"receipt-title\">OFFICIAL RECEIPT</div>\r\n                    <div class=\"receipt-number\">No: {{ doc.name }}</div>\r\n                </div>\r\n            </div>\r\n            \r\n            <!-- Receipt Body -->\r\n            <div class=\"receipt-body\">\r\n                <!-- Date and Reference -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Date:</div>\r\n                    <div class=\"receipt-value\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}</div>\r\n                    <div class=\"receipt-label\" style=\"margin-left: 20px;\">Ref No:</div>\r\n                    <div class=\"receipt-value\">{{ doc.reference_no or \"\u2014\" }}</div>\r\n                </div>\r\n                \r\n                <!-- Received From -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Received From:</div>\r\n                    <div class=\"receipt-value highlight\">\r\n                        {% if doc.trans_type in [\"Customer Receipt\", \"Receive from One-Off\", \"Customer Refund\"] and doc.customer_name %}\r\n                            {{ doc.customer_name }}\r\n                        {% else %}\r\n                            {{ doc.payer_name or \"\u2014\" }}\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Amount in Figures -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Amount:</div>\r\n                    <div class=\"receipt-value amount\">\r\n                        {% if doc.receipt_currency == 'NGN' %}\r\n                            {{ frappe.format_value(doc.amount_received, {'fieldtype': 'Currency', 'options': doc.receipt_currency}) }}\r\n                        {% else %}\r\n                            {{ frappe.format_value(doc.local_currency_amount, {'fieldtype': 'Currency', 'options': 'NGN'}) }}\r\n                            <span style=\"font-size: 9px; color: #666;\"> ({{ doc.receipt_currency }} {{ frappe.format_value(doc.amount_received_in_fc, {'fieldtype': 'Float'}) }})</span>\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Amount in Words -->\r\n                {% if doc.amount_in_words %}\r\n                <div class=\"receipt-row words-row\">\r\n                    <div class=\"receipt-label\">In Words:</div>\r\n                    <div class=\"receipt-value words\">{{ doc.amount_in_words }}</div>\r\n                </div>\r\n                {% endif %}\r\n                \r\n                <!-- Payment Mode -->\r\n                <div class=\"receipt-row\">\r\n                    <div class=\"receipt-label\">Mode of Payment:</div>\r\n                    <div class=\"receipt-value\">{{ doc.mode_of_payment or \"\u2014\" }}</div>\r\n                </div>\r\n                \r\n                <!-- Purpose / Description -->\r\n                {% if doc.transaction_purposes %}\r\n                <div class=\"receipt-row purpose-row\">\r\n                    <div class=\"receipt-label\">Purpose:</div>\r\n                    <div class=\"receipt-value purpose\">{{ doc.transaction_purposes }}</div>\r\n                </div>\r\n                {% endif %}\r\n                \r\n                <!-- Bank Details (if applicable) -->\r\n                {% if doc.remittance_bank %}\r\n                <div class=\"receipt-row bank-row\">\r\n                    <div class=\"receipt-label\">Bank:</div>\r\n                    <div class=\"receipt-value\">{{ doc.remittance_bank }}</div>\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n            \r\n            <!-- Receipt Footer with Signatures -->\r\n            <div class=\"receipt-footer\">\r\n                <div class=\"signature-row\">\r\n                    <div class=\"signature-field\">\r\n                        <div class=\"signature-line\"></div>\r\n                        <div class=\"signature-label\">Received By</div>\r\n                    </div>\r\n                    <div class=\"signature-field\">\r\n                        <div class=\"signature-line\"></div>\r\n                        <div class=\"signature-label\">Authorized Signatory</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"stamp-area duplicate\">DUPLICATE</div>\r\n                <div class=\"footer-note\">For LESSAFREE Enterprise Solutions</div>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- COPY INDICATOR -->\r\n        <div class=\"copy-indicator duplicate\">DUPLICATE COPY</div>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n.official-receipt-container {\r\n    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;\r\n    max-width: 820px;\r\n    margin: 0 auto;\r\n    color: #1e293b;\r\n    font-size: 11px;\r\n    padding: 10px;\r\n}\r\n\r\n/* Receipt Wrapper */\r\n.receipt-wrapper {\r\n    margin-bottom: 20px;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.receipt-wrapper.duplicate {\r\n    margin-top: 10px;\r\n}\r\n\r\n/* Official Receipt Card */\r\n.official-receipt {\r\n    border: 2px solid #000;\r\n    border-radius: 8px;\r\n    padding: 15px;\r\n    background: white;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.05);\r\n}\r\n\r\n.official-receipt.duplicate {\r\n    border-color: #4b5563;\r\n    background: #fafafa;\r\n}\r\n\r\n/* Receipt Header with Logo */\r\n.receipt-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 15px;\r\n    padding-bottom: 10px;\r\n    border-bottom: 2px solid #000;\r\n}\r\n\r\n.company-branding {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n}\r\n\r\n.logo-container {\r\n    width: 50px;\r\n    height: 50px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n\r\n.company-logo {\r\n    max-width: 50px;\r\n    max-height: 50px;\r\n    object-fit: contain;\r\n}\r\n\r\n.company-info {\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.company-name {\r\n    font-size: 16px;\r\n    font-weight: 800;\r\n    color: #000;\r\n    letter-spacing: 0.5px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.company-tagline {\r\n    font-size: 8px;\r\n    color: #4b5563;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.receipt-title-section {\r\n    text-align: right;\r\n}\r\n\r\n.receipt-title {\r\n    font-size: 20px;\r\n    font-weight: 800;\r\n    color: #000;\r\n    letter-spacing: 0.5px;\r\n}\r\n\r\n.receipt-number {\r\n    font-size: 10px;\r\n    font-weight: 600;\r\n    background: #000;\r\n    color: white;\r\n    padding: 3px 8px;\r\n    border-radius: 4px;\r\n    margin-top: 3px;\r\n    text-align: center;\r\n}\r\n\r\n/* Receipt Body */\r\n.receipt-body {\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.receipt-row {\r\n    display: flex;\r\n    margin-bottom: 6px;\r\n    padding-bottom: 4px;\r\n    border-bottom: 1px dotted #ddd;\r\n}\r\n\r\n.receipt-row:last-child {\r\n    border-bottom: none;\r\n}\r\n\r\n.receipt-label {\r\n    width: 90px;\r\n    color: #4b5563;\r\n    font-weight: 600;\r\n    font-size: 9px;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.receipt-value {\r\n    flex: 1;\r\n    color: #111827;\r\n    font-weight: 500;\r\n    font-size: 10px;\r\n}\r\n\r\n.receipt-value.highlight {\r\n    font-weight: 700;\r\n    color: #000;\r\n}\r\n\r\n.receipt-value.amount {\r\n    font-weight: 700;\r\n    color: #000;\r\n    font-size: 12px;\r\n}\r\n\r\n.receipt-value.words {\r\n    font-style: italic;\r\n    color: #4b5563;\r\n    text-transform: uppercase;\r\n    font-size: 9px;\r\n    letter-spacing: 0.2px;\r\n}\r\n\r\n.words-row {\r\n    background: #fff8e1;\r\n    padding: 4px 0;\r\n    margin: 6px 0;\r\n    border-left: 3px solid #f59e0b;\r\n    padding-left: 8px;\r\n}\r\n\r\n.purpose-row .receipt-value {\r\n    font-size: 9px;\r\n    line-height: 1.4;\r\n}\r\n\r\n.bank-row {\r\n    margin-top: 5px;\r\n    padding-top: 5px;\r\n    border-top: 1px dashed #ddd;\r\n}\r\n\r\n/* Receipt Footer */\r\n.receipt-footer {\r\n    margin-top: 15px;\r\n    padding-top: 10px;\r\n    border-top: 2px solid #000;\r\n}\r\n\r\n.signature-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: 20px;\r\n    margin-bottom: 8px;\r\n}\r\n\r\n.signature-field {\r\n    flex: 1;\r\n    text-align: center;\r\n}\r\n\r\n.signature-line {\r\n    border-top: 1px solid #000;\r\n    width: 100%;\r\n    margin-bottom: 4px;\r\n    padding-top: 15px;\r\n}\r\n\r\n.signature-label {\r\n    font-size: 8px;\r\n    color: #4b5563;\r\n    font-weight: 500;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.stamp-area {\r\n    text-align: right;\r\n    font-size: 12px;\r\n    font-weight: 800;\r\n    color: #000;\r\n    letter-spacing: 2px;\r\n    opacity: 0.8;\r\n    margin-top: 3px;\r\n}\r\n\r\n.stamp-area.duplicate {\r\n    color: #4b5563;\r\n    font-style: italic;\r\n}\r\n\r\n.footer-note {\r\n    text-align: center;\r\n    font-size: 7px;\r\n    color: #9ca3af;\r\n    margin-top: 5px;\r\n}\r\n\r\n/* Copy Indicator */\r\n.copy-indicator {\r\n    text-align: center;\r\n    font-size: 7px;\r\n    font-weight: 600;\r\n    color: #6b7280;\r\n    letter-spacing: 1px;\r\n    margin-top: 2px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.copy-indicator.duplicate {\r\n    color: #9ca3af;\r\n}\r\n\r\n/* Separator */\r\n.receipt-separator {\r\n    margin: 15px 0;\r\n    text-align: center;\r\n    position: relative;\r\n}\r\n\r\n.separator-text {\r\n    display: inline-block;\r\n    background: white;\r\n    padding: 0 10px;\r\n    color: #6b7280;\r\n    font-size: 8px;\r\n    font-weight: 600;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n.receipt-separator::before {\r\n    content: '';\r\n    position: absolute;\r\n    left: 0;\r\n    top: 50%;\r\n    width: 100%;\r\n    height: 1px;\r\n    background: repeating-linear-gradient(45deg, #000, #000 5px, transparent 5px, transparent 10px);\r\n    z-index: -1;\r\n}\r\n\r\n/* Print Styles */\r\n@media print {\r\n    .official-receipt-container {\r\n        max-width: 100%;\r\n        padding: 0;\r\n    }\r\n    \r\n    .receipt-wrapper {\r\n        page-break-inside: avoid;\r\n    }\r\n    \r\n    .receipt-separator {\r\n        page-break-after: avoid;\r\n    }\r\n    \r\n    .company-logo {\r\n        print-color-adjust: exact;\r\n        -webkit-print-color-adjust: exact;\r\n    }\r\n    \r\n    @page {\r\n        size: A4;\r\n        margin: 10mm 10mm;\r\n    }\r\n}\r\n</style>",
