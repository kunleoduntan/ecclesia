 "css": "body {\r\n  font-family: 'Segoe UI', 'Calibri', Arial, sans-serif;\r\n  font-size: 10.5px;\r\n  margin: 0;\r\n  padding: 2px; /* ultra compact */\r\n  color: #333;\r\n  line-height: 1.0; /* no extra spacing between lines */\r\n}\r\n\r\n/* Paragraphs & headings */\r\np, h1, h2, h3, h4, h5 {\r\n  margin: 1px 0; /* almost no vertical gap */\r\n  padding: 0;\r\n}\r\n\r\n/* Tables */\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse; /* no gaps */\r\n  border-spacing: 0;\r\n  margin: 0; /* remove extra space */\r\n  font-size: 10px;\r\n  line-height: 1.2; /* tight rows */\r\n  page-break-inside: avoid;\r\n}\r\n\r\nth, td {\r\n  border: 1px solid #999;\r\n  padding: 0.3px 0.8px; /* minimal padding */\r\n  vertical-align: middle;\r\n}\r\n\r\nth {\r\n  background-color: #f2fdf2;\r\n  font-weight: 600;\r\n  color: #226622;\r\n}\r\n\r\ntr:nth-child(even) td {\r\n  background-color: #f9f9f9;\r\n}\r\n\r\n/* Signature Section */\r\n.signature-section {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-top: 1px; /* much smaller */\r\n  border-top: 1px dashed #999;\r\n  padding-top: 1px; /* tighter */\r\n  font-size: 10px;\r\n  align-items: flex-start;\r\n  gap: 5px;\r\n}\r\n\r\n.signature-box {\r\n  flex: 1;\r\n  text-align: center;\r\n  min-width: 120px; /* smaller */\r\n}\r\n\r\n.signature-line {\r\n  height: 30px; /* reduced */\r\n  border: 1px solid #ccc;\r\n  border-radius: 2px;\r\n  margin-bottom: 1px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  font-style: italic;\r\n  color: #aaa;\r\n  font-size: 8.5px;\r\n}\r\n\r\n.designation-date-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 5px;\r\n  font-size: 8.5px;\r\n}\r\n\r\n.designation-date-row span {\r\n  border-top: 1px solid #111;\r\n  display: inline-block;\r\n  padding-top: 1px;\r\n  width: 48%;\r\n  text-align: center;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Force single page look */\r\n.container {\r\n  max-width: 100%;\r\n  overflow-x: hidden;\r\n  page-break-inside: avoid;\r\n}\r\n\r\n@media print {\r\n  body {\r\n    font-size: 9px;\r\n    padding: 0.2cm; /* minimal padding for print */\r\n  }\r\n\r\n  .signature-line {\r\n    color: #ddd !important;\r\n  }\r\n\r\n  table th, table td {\r\n    padding: 0.3px 0.8px; /* very tight print rows */\r\n  }\r\n\r\n  p {\r\n    margin: 0.5px 0; /* ultra compact between paragraphs */\r\n  }\r\n}\r\n",
