{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-03 10:36:50.140093",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Purchase Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Purchase Order</title>\r\n    <style>\r\n        /* ---- reset & base ---- */\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n        body {\r\n            font-family: 'Segoe UI', 'Roboto', 'Calibri', Arial, sans-serif;\r\n            font-size: 10px;\r\n            color: #1e2b3c;\r\n            background: #f4f7fc;\r\n            padding: 12px 16px;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n        }\r\n        .po-wrapper {\r\n            max-width: 1100px;\r\n            width: 100%;\r\n            background: #ffffff;\r\n            border-radius: 10px;\r\n            box-shadow: 0 8px 24px rgba(0,20,40,0.08);\r\n            padding: 18px 24px 14px 24px;\r\n        }\r\n\r\n        /* ---- letterhead wrapper ---- */\r\n        .letterhead-wrapper {\r\n            margin-bottom: 10px;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback {\r\n            border-bottom: 2px solid #1a3b5d;\r\n            padding-bottom: 6px;\r\n            margin-bottom: 10px;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback h2 {\r\n            font-size: 20px;\r\n            color: #0a2647;\r\n            margin: 0;\r\n        }\r\n        .letterhead-wrapper .letterhead-fallback p {\r\n            font-size: 10px;\r\n            color: #4a5b6e;\r\n            margin: 2px 0 0 0;\r\n        }\r\n\r\n        /* ---- title ---- */\r\n        .po-title {\r\n            text-align: center;\r\n            font-size: 20px;\r\n            font-weight: 700;\r\n            letter-spacing: 3px;\r\n            color: #1a3b5d;\r\n            text-transform: uppercase;\r\n            margin: 0 0 10px 0;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 4px;\r\n        }\r\n\r\n        /* ---- status badge ---- */\r\n        .status-badge {\r\n            display: inline-block;\r\n            padding: 2px 16px;\r\n            border-radius: 30px;\r\n            font-weight: 700;\r\n            font-size: 11px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n        }\r\n        .status-draft { background: #f3f4f6; color: #6b7280; }\r\n        .status-submitted { background: #dbeafe; color: #1e40af; }\r\n        .status-approved { background: #d1fae5; color: #065f46; }\r\n        .status-rejected { background: #fee2e2; color: #991b1b; }\r\n        .status-ordered { background: #dbeafe; color: #1e40af; }\r\n        .status-cancelled { background: #f3f4f6; color: #6b7280; }\r\n\r\n        /* ---- info grid ---- */\r\n        .info-grid {\r\n            display: flex;\r\n            gap: 16px;\r\n            margin-bottom: 10px;\r\n            flex-wrap: wrap;\r\n        }\r\n        .party-details {\r\n            flex: 1.2;\r\n            min-width: 200px;\r\n        }\r\n        .party-details .label {\r\n            font-weight: 700;\r\n            font-size: 10px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #1a3b5d;\r\n            padding-bottom: 2px;\r\n            margin-bottom: 4px;\r\n            display: inline-block;\r\n        }\r\n        .party-name {\r\n            font-size: 14px;\r\n            font-weight: 700;\r\n            color: #00337a;\r\n            margin: 3px 0 1px 0;\r\n        }\r\n        .party-phone {\r\n            font-size: 9px;\r\n            color: #4a5b6e;\r\n            margin-top: 2px;\r\n        }\r\n\r\n        .info-panel {\r\n            flex: 0.9;\r\n            min-width: 200px;\r\n            background: #f8fafc;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 12px 3px 12px;\r\n        }\r\n        .info-row {\r\n            display: flex;\r\n            justify-content: flex-start;\r\n            padding: 1px 0;\r\n            border-bottom: 1px dashed #dce4ed;\r\n            gap: 6px;\r\n            align-items: baseline;\r\n        }\r\n        .info-row:last-child { border-bottom: none; }\r\n        .info-row .ilabel {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            min-width: 85px;\r\n            font-size: 9px;\r\n        }\r\n        .info-row .ivalue {\r\n            font-weight: 500;\r\n            color: #00337a;\r\n            font-size: 9px;\r\n        }\r\n\r\n        /* ---- section headers ---- */\r\n        .section-header {\r\n            font-weight: 700;\r\n            font-size: 11px;\r\n            color: #1a3b5d;\r\n            background: #e3eaf2;\r\n            padding: 3px 12px;\r\n            margin: 8px 0 4px 0;\r\n            border-radius: 3px;\r\n            border-left: 3px solid #1a3b5d;\r\n        }\r\n\r\n        /* ---- table ---- */\r\n        .table-wrap {\r\n            margin: 6px 0 4px 0;\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            overflow: hidden;\r\n        }\r\n        .items-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .items-table th {\r\n            background: #e3eaf2;\r\n            color: #0a2647;\r\n            font-weight: 700;\r\n            padding: 3px 4px;\r\n            border: 1px solid #1f2e42;\r\n            text-align: center;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table td {\r\n            padding: 2px 4px;\r\n            border: 1px solid #1f2e42;\r\n            vertical-align: middle;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table .alt-row td { background: #f6f9fd; }\r\n        .text-center { text-align: center; }\r\n        .text-right { text-align: right; }\r\n        .text-left { text-align: left; }\r\n        .font-bold { font-weight: 700; }\r\n\r\n        /* ---- totals ---- */\r\n        .totals-section {\r\n            display: flex;\r\n            justify-content: flex-end;\r\n            margin-top: 4px;\r\n            padding: 0 2px;\r\n        }\r\n        .totals-box {\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            background: #f8fafc;\r\n            padding: 2px 14px 2px 14px;\r\n            width: 45%;\r\n            min-width: 280px;\r\n        }\r\n        .totals-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table td {\r\n            padding: 1px 3px;\r\n            border: none;\r\n            vertical-align: middle;\r\n            line-height: 1.2;\r\n        }\r\n        .totals-table .label {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            padding-right: 14px;\r\n            width: 60%;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .amount {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #00337a;\r\n            width: 40%;\r\n            padding-right: 2px;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .grand-total td {\r\n            font-size: 11px;\r\n            font-weight: 700;\r\n            color: #0a2647;\r\n            border-top: 2px solid #1a3b5d;\r\n            padding-top: 2px;\r\n        }\r\n\r\n        /* ---- in words ---- */\r\n        .in-words {\r\n            background: #f2f7ff;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 3px 14px;\r\n            margin: 4px 0 8px 0;\r\n            display: flex;\r\n            gap: 10px;\r\n            font-size: 9.5px;\r\n            align-items: center;\r\n            flex-wrap: wrap;\r\n        }\r\n        .in-words strong { color: #1a3b5d; }\r\n\r\n        /* ---- linked docs ---- */\r\n        .linked-docs {\r\n            display: flex;\r\n            gap: 20px;\r\n            flex-wrap: wrap;\r\n            background: #f8fafc;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 14px;\r\n            margin: 4px 0 6px 0;\r\n            font-size: 9px;\r\n        }\r\n        .linked-docs .ld-item {\r\n            display: flex;\r\n            align-items: baseline;\r\n            gap: 4px;\r\n        }\r\n        .linked-docs .ld-label {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n        }\r\n        .linked-docs .ld-value {\r\n            font-weight: 500;\r\n            color: #00337a;\r\n        }\r\n\r\n        /* ---- signatures ---- */\r\n        .signature-grid {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin: 12px 0 4px 0;\r\n            flex-wrap: wrap;\r\n        }\r\n        .sig-card {\r\n            flex: 1;\r\n            min-width: 120px;\r\n            border: 1px solid #1a3b5d;\r\n            border-radius: 5px;\r\n            padding: 4px 8px 3px 8px;\r\n            background: #fafdff;\r\n        }\r\n        .sig-card .sig-head {\r\n            font-weight: 700;\r\n            font-size: 8.5px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 1px;\r\n            margin-bottom: 3px;\r\n        }\r\n        .sig-card .sig-field {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            font-size: 8px;\r\n            margin: 1px 0;\r\n            color: #1e2b3c;\r\n        }\r\n        .sig-card .sig-field strong {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n        }\r\n        .sig-card .dash-line {\r\n            color: #7a8a9e;\r\n            letter-spacing: 0.5px;\r\n            font-weight: 300;\r\n        }\r\n        .sig-card .line-space {\r\n            height: 12px;\r\n            border-bottom: 1px dashed #b9cfe5;\r\n            margin: 1px 0 3px 0;\r\n        }\r\n\r\n        .footer-thank {\r\n            text-align: center;\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n            color: #1a3b5d;\r\n            padding: 6px 0 2px 0;\r\n            margin-top: 6px;\r\n            border-top: 2px solid #1a3b5d;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        /* ---- print ---- */\r\n        @media print {\r\n            body {\r\n                background: #fff;\r\n                padding: 4px 8px;\r\n                display: block;\r\n                min-height: auto;\r\n            }\r\n            .po-wrapper {\r\n                max-width: 100%;\r\n                box-shadow: none;\r\n                border-radius: 0;\r\n                padding: 6px 10px;\r\n            }\r\n            .sig-card { min-height: 38px; }\r\n            .items-table th { background: #e3eaf2 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\r\n            .in-words, .info-panel, .totals-box, .linked-docs {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n            .items-table th, .items-table td {\r\n                padding: 1px 3px;\r\n                line-height: 1.1;\r\n            }\r\n            .status-badge {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .info-grid { flex-direction: column; gap: 8px; }\r\n            .signature-grid { flex-direction: column; }\r\n            .sig-card { min-width: auto; }\r\n            .po-wrapper { padding: 12px 10px; }\r\n            .totals-box { width: 100%; min-width: auto; }\r\n            .linked-docs { flex-direction: column; gap: 4px; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"po-wrapper\">\r\n\r\n    <!-- ===== LETTERHEAD WRAPPER ===== -->\r\n    <div class=\"letterhead-wrapper\">\r\n        {% if doc.letter_head %}\r\n            {{ frappe.db.get_value(\"Letter Head\", doc.letter_head, \"content\") }}\r\n        {% else %}\r\n            <!-- Fallback if no letterhead is set -->\r\n            <div class=\"letterhead-fallback\">\r\n                <h2>{{ doc.company or 'Company Name' }}</h2>\r\n                <p>{{ doc.company_address or '' }}</p>\r\n            </div>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- ===== TITLE ===== -->\r\n    <div class=\"po-title\">\r\n        <span class=\"status-badge status-{{ doc.status|lower|replace(' ', '-') if doc.status else 'draft' }}\">\r\n            {{ doc.status or 'Draft' }}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- ===== INFO GRID ===== -->\r\n    <div class=\"info-grid\">\r\n\r\n        <!-- Supplier Details -->\r\n        <div class=\"party-details\">\r\n            <div class=\"label\">\ud83e\uddfe Supplier</div>\r\n            <div class=\"party-name\">{{ doc.supplier_name or doc.supplier or 'N/A' }}</div>\r\n            <div class=\"party-phone\">\ud83d\udcde {{ doc.supplier_phone or 'N/A' }}</div>\r\n            <div style=\"font-size:8px;color:#64748B;margin-top:4px;\">\r\n                Supplier ID: {{ doc.supplier or 'N/A' }}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Info Panel -->\r\n        <div class=\"info-panel\">\r\n            <div class=\"info-row\"><span class=\"ilabel\">Order #</span><span class=\"ivalue\">{{ doc.name or 'PO-2026-001' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Date</span><span class=\"ivalue\">{{ doc.transaction_date or frappe.utils.get_today() }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Company</span><span class=\"ivalue\">{{ doc.company or 'N/A' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Required By</span><span class=\"ivalue\">{{ doc.schedule_date or 'N/A' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Currency</span><span class=\"ivalue\">{{ doc.currency or 'NGN' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Price List</span><span class=\"ivalue\">{{ doc.buying_price_list or 'N/A' }}</span></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== ITEMS TABLE ===== -->\r\n    <div class=\"section-header\">\ud83d\udccb Items Ordered</div>\r\n    <div class=\"table-wrap\">\r\n        <table class=\"items-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width:15%;\">Code</th>\r\n                    <th style=\"width:28%;\">Item Name</th>\r\n                    <th style=\"width:10%;\">Qty</th>\r\n                    <th style=\"width:10%;\">UOM</th>\r\n                    <th style=\"width:17%;\">Rate</th>\r\n                    <th style=\"width:20%;\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for row in doc.items %}\r\n                <tr class=\"{{ 'alt-row' if loop.index % 2 == 0 else '' }}\">\r\n                    <td class=\"text-center\">{{ row.item_code }}</td>\r\n                    <td class=\"text-left\">{{ row.item_name or row.description or row.item_code }}</td>\r\n                    <td class=\"text-center\">{{ row.qty }}</td>\r\n                    <td class=\"text-center\">{{ row.uom or 'Nos' }}</td>\r\n                    <td class=\"text-right\">{{ row.get_formatted(\"rate\") or row.rate }}</td>\r\n                    <td class=\"text-right font-bold\">{{ row.get_formatted(\"amount\") or row.amount }}</td>\r\n                </tr>\r\n                {% else %}\r\n                <tr><td class=\"text-center\" colspan=\"6\">No items recorded</td></tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===== TOTALS ===== -->\r\n    <div class=\"totals-section\">\r\n        <div class=\"totals-box\">\r\n            <table class=\"totals-table\">\r\n                <tbody>\r\n                    <tr>\r\n                        <td class=\"label\">Total Items</td>\r\n                        <td class=\"amount\">{{ doc.items|length }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"label\">Total Quantity</td>\r\n                        <td class=\"amount\">\r\n                            {% set total_qty = 0 %}\r\n                            {% for row in doc.items %}\r\n                                {% set total_qty = total_qty + (row.qty|float) %}\r\n                            {% endfor %}\r\n                            {{ total_qty|round(2) }}\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"label\">Net Total</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"net_total\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"label\">Tax</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"total_taxes_and_charges\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                    <tr class=\"grand-total\">\r\n                        <td class=\"label\">Grand Total</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"grand_total\") or '\u20a6 0.00' }}</td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== IN WORDS ===== -->\r\n    {% if doc.in_words or doc.grand_total %}\r\n    <div class=\"in-words\">\r\n        <strong>In Words:</strong>\r\n        <span>\r\n            {% if doc.in_words %}\r\n                {{ doc.in_words }}\r\n            {% elif doc.grand_total %}\r\n                {{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}\r\n            {% else %}\r\n                Zero\r\n            {% endif %}\r\n        </span>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===== TAX BREAKDOWN ===== -->\r\n    {% if doc.taxes and doc.taxes|length > 0 %}\r\n    <div style=\"background:#fefce8;border:1px solid #fde68a;border-radius:5px;padding:4px 14px;margin:4px 0 6px 0;font-size:9px;\">\r\n        <strong>\ud83d\udccc Tax Breakdown:</strong>\r\n        {% for tax in doc.taxes %}\r\n        <span>{{ tax.description or tax.account_head }}: {{ tax.get_formatted(\"tax_amount\") }}</span>\r\n        {% if not loop.last %} | {% endif %}\r\n        {% endfor %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===== TERMS AND CONDITIONS ===== -->\r\n    {% if doc.tc_name or doc.terms %}\r\n    <div style=\"background:#f8fafc;border:1px solid #d0dbe8;border-radius:5px;padding:4px 14px;margin:4px 0 6px 0;font-size:9px;\">\r\n        <strong>\ud83d\udcdc Terms:</strong>\r\n        {% if doc.tc_name %}\r\n        <span>{{ doc.tc_name }}</span>\r\n        {% endif %}\r\n        {% if doc.terms %}\r\n        <div style=\"margin-top:2px;font-size:8px;color:#4a5b6e;\">{{ doc.terms }}</div>\r\n        {% endif %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ===== LINKED DOCUMENTS ===== -->\r\n    <div class=\"section-header\">\ud83d\udd17 Linked Documents</div>\r\n    <div class=\"linked-docs\">\r\n        {% if doc.material_request %}\r\n        <div class=\"ld-item\">\r\n            <span class=\"ld-label\">Material Request:</span>\r\n            <span class=\"ld-value\">{{ doc.material_request }}</span>\r\n        </div>\r\n        {% endif %}\r\n        {% if doc.supplier_quotation %}\r\n        <div class=\"ld-item\">\r\n            <span class=\"ld-label\">Supplier Quotation:</span>\r\n            <span class=\"ld-value\">{{ doc.supplier_quotation }}</span>\r\n        </div>\r\n        {% endif %}\r\n        <div class=\"ld-item\">\r\n            <span class=\"ld-label\">Currency:</span>\r\n            <span class=\"ld-value\">{{ doc.currency or 'NGN' }}</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== SIGNATURES ===== -->\r\n    <div class=\"signature-grid\">\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\u270d\ufe0f Prepared By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\u2705 Approved By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\ud83d\udce6 Received By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Designation:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== FOOTER ===== -->\r\n    <div class=\"footer-thank\">\r\n        \u2b50 Thank You For Your Business! \u2b50\r\n    </div>\r\n\r\n</div>\r\n<!-- end po-wrapper -->\r\n</body>\r\n</html>",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
