{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-13 16:45:22.816094",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "eRequest",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\r\n        \r\n        @media print {\r\n            @page {\r\n                margin: 12mm 8mm 12mm 8mm;\r\n                size: A4 portrait;\r\n            }\r\n            \r\n            body { \r\n                margin: 0;\r\n                padding: 0;\r\n                -webkit-print-color-adjust: exact;\r\n            }\r\n            \r\n            .no-print { display: none !important; }\r\n            .page-break { page-break-after: always; break-after: page; }\r\n        }\r\n        \r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: 'Inter', sans-serif;\r\n            background: white;\r\n            color: #1e293b;\r\n            line-height: 1.4;\r\n            font-size: 10px;\r\n        }\r\n\r\n        .request-container {\r\n            width: 100%;\r\n            max-width: 794px;\r\n            margin: 0 auto;\r\n            background: white;\r\n            padding: 15px;\r\n        }\r\n\r\n        /* Letterhead space - ERPNext will inject letterhead here */\r\n        .letter-head {\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        /* Header - Conditional display */\r\n        .header-section {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 12px;\r\n            padding-bottom: 8px;\r\n            border-bottom: 2px solid #000;\r\n        }\r\n\r\n        /* Only show company info if letterhead is not used */\r\n        .show-without-letterhead {\r\n            display: {% if print_settings and print_settings.with_letterhead %}none{% else %}block{% endif %};\r\n        }\r\n\r\n        .company-info {\r\n            flex: 1;\r\n        }\r\n\r\n        .company-name {\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            margin-bottom: 3px;\r\n        }\r\n\r\n        .company-details {\r\n            color: #4b5563;\r\n            font-size: 9px;\r\n            line-height: 1.4;\r\n        }\r\n\r\n        .request-title {\r\n            text-align: right;\r\n        }\r\n\r\n        .request-type-badge {\r\n            font-size: 22px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .request-id-badge {\r\n            background: #000;\r\n            color: white;\r\n            padding: 3px 10px;\r\n            border-radius: 4px;\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            margin-top: 4px;\r\n            display: inline-block;\r\n        }\r\n\r\n        /* Status Badges */\r\n        .status-badge {\r\n            display: inline-block;\r\n            padding: 4px 10px;\r\n            border-radius: 20px;\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .status-draft {\r\n            background: #f3f4f6;\r\n            color: #6b7280;\r\n        }\r\n\r\n        .status-pending-manager {\r\n            background: #fef3c7;\r\n            color: #92400e;\r\n        }\r\n\r\n        .status-pending-finance {\r\n            background: #fef3c7;\r\n            color: #92400e;\r\n        }\r\n\r\n        .status-pending-final {\r\n            background: #fef3c7;\r\n            color: #92400e;\r\n        }\r\n\r\n        .status-approved {\r\n            background: #dcfce7;\r\n            color: #166534;\r\n        }\r\n\r\n        .status-rejected {\r\n            background: #fee2e2;\r\n            color: #991b1b;\r\n        }\r\n\r\n        .status-cancelled {\r\n            background: #f3f4f6;\r\n            color: #6b7280;\r\n        }\r\n\r\n        /* Priority Badges */\r\n        .priority-badge {\r\n            display: inline-block;\r\n            padding: 3px 8px;\r\n            border-radius: 4px;\r\n            font-size: 8px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .priority-low {\r\n            background: #e6f7e6;\r\n            color: #2e7d32;\r\n        }\r\n\r\n        .priority-medium {\r\n            background: #fff8e1;\r\n            color: #b76e2e;\r\n        }\r\n\r\n        .priority-high {\r\n            background: #ffebee;\r\n            color: #c62828;\r\n        }\r\n\r\n        .priority-urgent {\r\n            background: #fce4ec;\r\n            color: #880e4f;\r\n            font-weight: 700;\r\n        }\r\n\r\n        /* Request Info Grid */\r\n        .info-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(4, 1fr);\r\n            gap: 8px;\r\n            margin-bottom: 12px;\r\n            background: #f9fafb;\r\n            padding: 10px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .info-box {\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .info-label {\r\n            font-size: 8px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.3px;\r\n            color: #6b7280;\r\n            margin-bottom: 2px;\r\n            font-weight: 600;\r\n        }\r\n\r\n        .info-value {\r\n            font-size: 11px;\r\n            color: #111827;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Section Titles */\r\n        .section-title {\r\n            font-size: 12px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            margin: 15px 0 8px 0;\r\n            padding-bottom: 4px;\r\n            border-bottom: 2px solid #000;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 6px;\r\n        }\r\n\r\n        .section-title i {\r\n            font-size: 10px;\r\n        }\r\n\r\n        /* Details Cards */\r\n        .details-card {\r\n            background: white;\r\n            padding: 12px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n            margin-bottom: 12px;\r\n        }\r\n\r\n        .details-row {\r\n            display: flex;\r\n            margin-bottom: 6px;\r\n            border-bottom: 1px dashed #f0f0f0;\r\n            padding-bottom: 4px;\r\n        }\r\n\r\n        .details-label {\r\n            width: 120px;\r\n            color: #6b7280;\r\n            font-size: 9px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .details-value {\r\n            flex: 1;\r\n            color: #111827;\r\n            font-size: 10px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        /* Two Column Layout */\r\n        .two-column {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 15px;\r\n            margin-bottom: 12px;\r\n        }\r\n\r\n        .column-card {\r\n            background: white;\r\n            padding: 12px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n        }\r\n\r\n        .column-header {\r\n            font-size: 10px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            margin-bottom: 8px;\r\n            padding-bottom: 4px;\r\n            border-bottom: 1px solid #e5e7eb;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Amount Summary */\r\n        .amount-summary {\r\n            background: #f8f9fa;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            border: 1px solid #e5e7eb;\r\n            margin: 12px 0;\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 15px;\r\n        }\r\n\r\n        .amount-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .amount-label {\r\n            font-size: 8px;\r\n            color: #6b7280;\r\n            margin-bottom: 4px;\r\n            font-weight: 500;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .amount-value {\r\n            font-size: 14px;\r\n            font-weight: 700;\r\n            color: #000;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        .amount-total {\r\n            background: #000;\r\n            color: white;\r\n            padding: 15px;\r\n            border-radius: 6px;\r\n        }\r\n\r\n        .amount-total .amount-label {\r\n            color: rgba(255, 255, 255, 0.8);\r\n        }\r\n\r\n        .amount-total .amount-value {\r\n            color: white;\r\n        }\r\n\r\n        /* Approval Chain */\r\n        .approval-chain {\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 10px;\r\n            margin: 15px 0;\r\n        }\r\n\r\n        .approval-card {\r\n            background: white;\r\n            padding: 12px;\r\n            border-radius: 6px;\r\n            border: 1px solid #e5e7eb;\r\n            text-align: center;\r\n        }\r\n\r\n        .approval-role {\r\n            font-size: 8px;\r\n            color: #6b7280;\r\n            margin-bottom: 4px;\r\n            font-weight: 500;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .approval-person {\r\n            font-size: 10px;\r\n            font-weight: 600;\r\n            color: #111827;\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n        .approval-status {\r\n            font-size: 8px;\r\n            padding: 3px 6px;\r\n            border-radius: 4px;\r\n            display: inline-block;\r\n        }\r\n\r\n        .status-pending {\r\n            background: #fef3c7;\r\n            color: #92400e;\r\n        }\r\n\r\n        .status-approved {\r\n            background: #dcfce7;\r\n            color: #166534;\r\n        }\r\n\r\n        .approval-date {\r\n            font-size: 7px;\r\n            color: #9ca3af;\r\n            margin-top: 4px;\r\n        }\r\n\r\n        /* Banking Details */\r\n        .banking-details {\r\n            background: #f0f9ff;\r\n            padding: 12px;\r\n            border-radius: 6px;\r\n            border: 1px solid #bae6fd;\r\n            margin: 12px 0;\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            gap: 10px;\r\n        }\r\n\r\n        .banking-item {\r\n            text-align: center;\r\n        }\r\n\r\n        .banking-label {\r\n            font-size: 7px;\r\n            color: #6b7280;\r\n            margin-bottom: 2px;\r\n            font-weight: 500;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .banking-value {\r\n            font-size: 9px;\r\n            font-weight: 600;\r\n            color: #111827;\r\n        }\r\n\r\n        /* Footer */\r\n        .footer-section {\r\n            margin-top: 20px;\r\n            padding-top: 12px;\r\n            border-top: 2px solid #e5e7eb;\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 30px;\r\n        }\r\n\r\n        .signature-box {\r\n            text-align: center;\r\n        }\r\n\r\n        .signature-line {\r\n            border-top: 1px solid #9ca3af;\r\n            padding-top: 6px;\r\n            margin-top: 20px;\r\n            position: relative;\r\n        }\r\n\r\n        .signature-label {\r\n            position: absolute;\r\n            top: -8px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            background: white;\r\n            padding: 0 6px;\r\n            font-size: 7px;\r\n            color: #6b7280;\r\n            font-weight: 500;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .print-info {\r\n            text-align: center;\r\n            color: #9ca3af;\r\n            font-size: 7px;\r\n            margin-top: 12px;\r\n            padding-top: 8px;\r\n            border-top: 1px solid #e5e7eb;\r\n            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;\r\n        }\r\n\r\n        /* In Words */\r\n        .in-words {\r\n            margin-top: 8px;\r\n            padding: 8px;\r\n            background: #fff8e1;\r\n            border-radius: 4px;\r\n            font-size: 8px;\r\n            color: #92400e;\r\n            font-style: italic;\r\n            border-left: 3px solid #f59e0b;\r\n        }\r\n\r\n        /* Tax ID Badge */\r\n        .tax-id-badge {\r\n            margin-top: 3px;\r\n            font-size: 8px;\r\n            color: #4b5563;\r\n        }\r\n        \r\n        .tax-id-badge strong {\r\n            color: #000;\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* Utility */\r\n        .text-right { text-align: right; }\r\n        .text-center { text-align: center; }\r\n        .text-mono { font-family: 'SF Mono', 'Monaco', 'Consolas', monospace; }\r\n        \r\n        .empty-state {\r\n            text-align: center;\r\n            color: #9ca3af;\r\n            font-style: italic;\r\n            padding: 20px;\r\n            background: #f9fafb;\r\n            border-radius: 6px;\r\n            margin: 15px 0;\r\n        }\r\n\r\n        /* Timeline */\r\n        .timeline-item {\r\n            display: flex;\r\n            align-items: center;\r\n            padding: 8px;\r\n            border-left: 2px solid #e5e7eb;\r\n            margin-left: 10px;\r\n            position: relative;\r\n        }\r\n\r\n        .timeline-dot {\r\n            width: 8px;\r\n            height: 8px;\r\n            border-radius: 50%;\r\n            background: #000;\r\n            position: absolute;\r\n            left: -5px;\r\n        }\r\n\r\n        /* Column widths for any tables */\r\n        .col-sn { width: 30px; text-align: center; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"request-container\">\r\n        <!-- ERPNext Letterhead will be automatically injected here -->\r\n        {{ letter_head }}\r\n        \r\n        <!-- Header - Only shows company info if no letterhead is selected -->\r\n        <div class=\"header-section\">\r\n            <div class=\"company-info show-without-letterhead\">\r\n                <div class=\"company-name\">{{ doc.company }}</div>\r\n                <div class=\"company-details\">\r\n                    {{ doc.company_address_display or \"\" | replace('\\n', '<br>') | safe }}\r\n                </div>\r\n                <!-- Company Tax ID -->\r\n                {% if doc.company_tax_id %}\r\n                <div class=\"tax-id-badge\">\r\n                    <strong>Tax ID:</strong> {{ doc.company_tax_id }}\r\n                </div>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"request-title\">\r\n                <div class=\"request-type-badge\">{{ doc.request_type or \"REQUEST\" }}</div>\r\n                <div class=\"request-id-badge\">{{ doc.name }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Basic Info Grid -->\r\n        <div class=\"info-grid\">\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Request Date</span>\r\n                <span class=\"info-value\">{{ frappe.format(doc.request_date, {'fieldtype': 'Date'}) }}</span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Due Date</span>\r\n                <span class=\"info-value\">{{ frappe.format(doc.payment_due_date, {'fieldtype': 'Date'}) if doc.payment_due_date else \"N/A\" }}</span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Priority</span>\r\n                <span class=\"info-value\">\r\n                    {% if doc.priority == 'Low' %}\r\n                        <span class=\"priority-badge priority-low\">{{ doc.priority }}</span>\r\n                    {% elif doc.priority == 'Medium' %}\r\n                        <span class=\"priority-badge priority-medium\">{{ doc.priority }}</span>\r\n                    {% elif doc.priority == 'High' %}\r\n                        <span class=\"priority-badge priority-high\">{{ doc.priority }}</span>\r\n                    {% elif doc.priority == 'Urgent' %}\r\n                        <span class=\"priority-badge priority-urgent\">{{ doc.priority }}</span>\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n            <div class=\"info-box\">\r\n                <span class=\"info-label\">Status</span>\r\n                <span class=\"info-value\">\r\n                    {% if doc.workflow_state == 'Draft' %}\r\n                        <span class=\"status-badge status-draft\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Pending Manager Approval' %}\r\n                        <span class=\"status-badge status-pending-manager\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Pending Finance Approval' %}\r\n                        <span class=\"status-badge status-pending-finance\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Pending Final Approval' %}\r\n                        <span class=\"status-badge status-pending-final\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Approved' %}\r\n                        <span class=\"status-badge status-approved\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Rejected' %}\r\n                        <span class=\"status-badge status-rejected\">{{ doc.workflow_state }}</span>\r\n                    {% elif doc.workflow_state == 'Cancelled' %}\r\n                        <span class=\"status-badge status-cancelled\">{{ doc.workflow_state }}</span>\r\n                    {% endif %}\r\n                </span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Basic Information Section -->\r\n        <div class=\"section-title\">\ud83d\udccb BASIC INFORMATION</div>\r\n        <div class=\"details-card\">\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Request Title:</span>\r\n                <span class=\"details-value\"><strong>{{ doc.title }}</strong></span>\r\n            </div>\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Requested By:</span>\r\n                <span class=\"details-value\">{{ doc.requested_by }}</span>\r\n            </div>\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Department:</span>\r\n                <span class=\"details-value\">{{ doc.department }}</span>\r\n            </div>\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Cost Center:</span>\r\n                <span class=\"details-value\">{{ doc.cost_center or \"Not specified\" }}</span>\r\n            </div>\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Project:</span>\r\n                <span class=\"details-value\">{{ doc.project or \"Not specified\" }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        {% if doc.request_type == 'Payment Request' %}\r\n        <!-- Payment Details Section -->\r\n        <div class=\"section-title\">\ud83d\udcb0 PAYMENT DETAILS</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Payment Information</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Payment Type:</span>\r\n                    <span class=\"details-value\">{{ doc.payment_type or \"Not specified\" }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Category:</span>\r\n                    <span class=\"details-value\">{{ doc.payment_category or \"Not specified\" }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Purpose:</span>\r\n                    <span class=\"details-value\">{{ doc.payment_purpose }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Amount Summary</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Currency:</span>\r\n                    <span class=\"details-value\">{{ doc.currency }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Payment Amount:</span>\r\n                    <span class=\"details-value\">{{ frappe.utils.fmt_money(doc.payment_amount, currency=doc.currency) }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Tax/Deduction:</span>\r\n                    <span class=\"details-value\">{{ frappe.utils.fmt_money(doc.tax_amount, currency=doc.currency) }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Total Amount -->\r\n        <div class=\"amount-summary\">\r\n            <div class=\"amount-item\">\r\n                <div class=\"amount-label\">Payment Amount</div>\r\n                <div class=\"amount-value\">{{ frappe.utils.fmt_money(doc.payment_amount, currency=doc.currency) }}</div>\r\n            </div>\r\n            <div class=\"amount-item\">\r\n                <div class=\"amount-label\">Tax/Deduction</div>\r\n                <div class=\"amount-value\">{{ frappe.utils.fmt_money(doc.tax_amount, currency=doc.currency) }}</div>\r\n            </div>\r\n            <div class=\"amount-item amount-total\">\r\n                <div class=\"amount-label\">Total Amount</div>\r\n                <div class=\"amount-value\">{{ frappe.utils.fmt_money(doc.total_amount, currency=doc.currency) }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Amount in Words -->\r\n        {% if doc.amount_in_words %}\r\n        <div class=\"in-words\">\r\n            <strong>Amount in Words:</strong> {{ doc.amount_in_words }}\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Beneficiary Details -->\r\n        <div class=\"section-title\">\ud83d\udc64 BENEFICIARY DETAILS</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Payee Information</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Payee Type:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_type }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Payee Name:</span>\r\n                    <span class=\"details-value\"><strong>{{ doc.payee_name }}</strong></span>\r\n                </div>\r\n                {% if doc.supplier %}\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Supplier:</span>\r\n                    <span class=\"details-value\">{{ doc.supplier }}</span>\r\n                </div>\r\n                {% endif %}\r\n                {% if doc.employee %}\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Employee:</span>\r\n                    <span class=\"details-value\">{{ doc.employee }}</span>\r\n                </div>\r\n                {% endif %}\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Email:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_email or \"Not provided\" }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Phone:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_phone or \"Not provided\" }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Banking Details</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Account Name:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_account_name }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Account Number:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_account_number }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Bank Name:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_bank_name }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Bank Code/SWIFT:</span>\r\n                    <span class=\"details-value\">{{ doc.payee_bank_code or \"Not provided\" }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Payment Method:</span>\r\n                    <span class=\"details-value\">{{ doc.payment_method or \"Not specified\" }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Invoice Details -->\r\n        {% if doc.invoice_reference or doc.purchase_order_reference %}\r\n        <div class=\"section-title\">\ud83d\udcc4 INVOICE DETAILS</div>\r\n        <div class=\"banking-details\">\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">Invoice Reference</div>\r\n                <div class=\"banking-value\">{{ doc.invoice_reference or \"N/A\" }}</div>\r\n            </div>\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">PO Reference</div>\r\n                <div class=\"banking-value\">{{ doc.purchase_order_reference or \"N/A\" }}</div>\r\n            </div>\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">Invoice Date</div>\r\n                <div class=\"banking-value\">{{ frappe.format(doc.invoice_date, {'fieldtype': 'Date'}) if doc.invoice_date else \"N/A\" }}</div>\r\n            </div>\r\n        </div>\r\n        {% endif %}\r\n        {% endif %}\r\n\r\n        {% if doc.request_type == 'Maintenance Request' %}\r\n        <!-- Maintenance Details Section -->\r\n        <div class=\"section-title\">\ud83d\udd27 MAINTENANCE DETAILS</div>\r\n        <div class=\"two-column\">\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Maintenance Information</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Maintenance Type:</span>\r\n                    <span class=\"details-value\">{{ doc.maintenance_type }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Category:</span>\r\n                    <span class=\"details-value\">{{ doc.maintenance_category }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Location:</span>\r\n                    <span class=\"details-value\">{{ doc.location }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Asset:</span>\r\n                    <span class=\"details-value\">{{ doc.asset or \"Not specified\" }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Schedule & Cost</div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Urgency Level:</span>\r\n                    <span class=\"details-value\">{{ doc.urgency_level }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Preferred Completion:</span>\r\n                    <span class=\"details-value\">{{ frappe.format(doc.preferred_completion_date, {'fieldtype': 'Date'}) if doc.preferred_completion_date else \"N/A\" }}</span>\r\n                </div>\r\n                <div class=\"details-row\">\r\n                    <span class=\"details-label\">Estimated Cost:</span>\r\n                    <span class=\"details-value\">{{ frappe.utils.fmt_money(doc.estimated_cost, currency=doc.currency or 'NGN') }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Issue Description -->\r\n        <div class=\"section-title\">\ud83d\udcdd ISSUE DESCRIPTION</div>\r\n        <div class=\"details-card\">\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Description:</span>\r\n                <span class=\"details-value\">{{ doc.issue_description | striptags | truncate(500) }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Vendor Information -->\r\n        {% if doc.recommended_vendor %}\r\n        <div class=\"section-title\">\ud83c\udfe2 VENDOR INFORMATION</div>\r\n        <div class=\"details-card\">\r\n            <div class=\"details-row\">\r\n                <span class=\"details-label\">Recommended Vendor:</span>\r\n                <span class=\"details-value\">{{ doc.recommended_vendor }}</span>\r\n            </div>\r\n        </div>\r\n        {% endif %}\r\n        {% endif %}\r\n\r\n        <!-- Description Section (for all request types) -->\r\n        {% if doc.description %}\r\n        <div class=\"section-title\">\ud83d\udcdd DETAILED DESCRIPTION</div>\r\n        <div class=\"details-card\">\r\n            <div class=\"details-value\">{{ doc.description | striptags | truncate(800) }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Approval Chain -->\r\n        <div class=\"section-title\">\u2705 APPROVAL CHAIN</div>\r\n        <div class=\"approval-chain\">\r\n            <div class=\"approval-card\">\r\n                <div class=\"approval-role\">Manager</div>\r\n                <div class=\"approval-person\">{{ doc.manager_approval or \"Pending\" }}</div>\r\n                <div class=\"approval-status {% if doc.manager_approval %}status-approved{% else %}status-pending{% endif %}\">\r\n                    {% if doc.manager_approval %}Approved{% else %}Pending{% endif %}\r\n                </div>\r\n                {% if doc.manager_approval_date %}\r\n                <div class=\"approval-date\">{{ frappe.format(doc.manager_approval_date, {'fieldtype': 'Datetime'}) }}</div>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"approval-card\">\r\n                <div class=\"approval-role\">Finance</div>\r\n                <div class=\"approval-person\">{{ doc.finance_approval or \"Pending\" }}</div>\r\n                <div class=\"approval-status {% if doc.finance_approval %}status-approved{% else %}status-pending{% endif %}\">\r\n                    {% if doc.finance_approval %}Approved{% else %}Pending{% endif %}\r\n                </div>\r\n                {% if doc.finance_approval_date %}\r\n                <div class=\"approval-date\">{{ frappe.format(doc.finance_approval_date, {'fieldtype': 'Datetime'}) }}</div>\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"approval-card\">\r\n                <div class=\"approval-role\">Final</div>\r\n                <div class=\"approval-person\">{{ doc.final_approval or \"Pending\" }}</div>\r\n                <div class=\"approval-status {% if doc.final_approval %}status-approved{% else %}status-pending{% endif %}\">\r\n                    {% if doc.final_approval %}Approved{% else %}Pending{% endif %}\r\n                </div>\r\n                {% if doc.final_approval_date %}\r\n                <div class=\"approval-date\">{{ frappe.format(doc.final_approval_date, {'fieldtype': 'Datetime'}) }}</div>\r\n                {% endif %}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Comments Section -->\r\n        {% if doc.manager_comments or doc.finance_comments or doc.final_comments %}\r\n        <div class=\"section-title\">\ud83d\udcac APPROVAL COMMENTS</div>\r\n        <div class=\"two-column\">\r\n            {% if doc.manager_comments %}\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Manager Comments</div>\r\n                <div class=\"details-value\">{{ doc.manager_comments }}</div>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.finance_comments %}\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Finance Comments</div>\r\n                <div class=\"details-value\">{{ doc.finance_comments }}</div>\r\n            </div>\r\n            {% endif %}\r\n            {% if doc.final_comments %}\r\n            <div class=\"column-card\">\r\n                <div class=\"column-header\">Final Comments</div>\r\n                <div class=\"details-value\">{{ doc.final_comments }}</div>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Rejection Reason -->\r\n        {% if doc.rejection_reason %}\r\n        <div class=\"section-title\">\u274c REJECTION REASON</div>\r\n        <div class=\"details-card\" style=\"background: #fee2e2; border-color: #fecaca;\">\r\n            <div class=\"details-value\">{{ doc.rejection_reason }}</div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Payment Processing Section -->\r\n        {% if doc.request_type == 'Payment Request' and doc.workflow_state == 'Approved' %}\r\n        <div class=\"section-title\">\ud83d\udcb3 PAYMENT PROCESSING</div>\r\n        <div class=\"banking-details\">\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">Payment Status</div>\r\n                <div class=\"banking-value\">{{ doc.payment_status or \"Not Started\" }}</div>\r\n            </div>\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">Payment Reference</div>\r\n                <div class=\"banking-value\">{{ doc.payment_reference or \"N/A\" }}</div>\r\n            </div>\r\n            <div class=\"banking-item\">\r\n                <div class=\"banking-label\">Transaction ID</div>\r\n                <div class=\"banking-value\">{{ doc.payment_transaction_id or \"N/A\" }}</div>\r\n            </div>\r\n        </div>\r\n        {% endif %}\r\n\r\n        <!-- Footer with Signatures -->\r\n        <div class=\"footer-section\">\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">REQUESTED BY</span>\r\n                </div>\r\n                <div class=\"signature-name\" style=\"margin-top: 3px; font-size: 8px; color: #4b5563;\">{{ doc.requested_by }}</div>\r\n            </div>\r\n            <div class=\"signature-box\">\r\n                <div class=\"signature-line\">\r\n                    <span class=\"signature-label\">AUTHORIZED BY</span>\r\n                </div>\r\n                <div class=\"signature-name\" style=\"margin-top: 3px; font-size: 8px; color: #4b5563;\">\r\n                    {% if doc.final_approval %}{{ doc.final_approval }}{% else %}____________________{% endif %}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Audit Info -->\r\n        <div class=\"print-info\">\r\n            Created by {{ doc.created_by or doc.owner }} on {{ frappe.format(doc.creation, {'fieldtype': 'Datetime'}) }} \u2022 Last modified: {{ frappe.format(doc.modified, {'fieldtype': 'Datetime'}) }}\r\n        </div>\r\n\r\n        <!-- Print Info -->\r\n        <div class=\"print-info\">\r\n            Generated \u2022 {{ doc.name }} \u2022 {{ frappe.utils.now_datetime().strftime('%Y-%m-%d %H:%M') }}\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>",
