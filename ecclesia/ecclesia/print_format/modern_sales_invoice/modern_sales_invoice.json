 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Sales Invoice \u00b7 Professional Print</title>\r\n    <style>\r\n        /* ---- reset & base ---- */\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n        body {\r\n            font-family: 'Segoe UI', 'Roboto', 'Calibri', Arial, sans-serif;\r\n            font-size: 10px;\r\n            color: #1e2b3c;\r\n            background: #f4f7fc;\r\n            padding: 12px 16px;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n        }\r\n        .invoice-wrapper {\r\n            max-width: 1100px;\r\n            width: 100%;\r\n            background: #ffffff;\r\n            border-radius: 10px;\r\n            box-shadow: 0 8px 24px rgba(0,20,40,0.08);\r\n            padding: 18px 24px 14px 24px;\r\n        }\r\n\r\n        /* ---- letterhead (logo + company name) ---- */\r\n        .letterhead {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            border-bottom: 2px solid #1a3b5d;\r\n            padding-bottom: 6px;\r\n            margin-bottom: 10px;\r\n            flex-wrap: wrap;\r\n        }\r\n        .brand {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n        .brand img {\r\n            height: 42px;\r\n            width: auto;\r\n            object-fit: contain;\r\n        }\r\n        .brand .company {\r\n            font-size: 22px;\r\n            font-weight: 700;\r\n            letter-spacing: 1.5px;\r\n            color: #0a2647;\r\n            text-transform: uppercase;\r\n        }\r\n        .head-details {\r\n            text-align: right;\r\n            font-size: 9px;\r\n            line-height: 1.4;\r\n            color: #2c3e50;\r\n        }\r\n\r\n        /* ---- title ---- */\r\n        .invoice-title {\r\n            text-align: center;\r\n            font-size: 20px;\r\n            font-weight: 700;\r\n            letter-spacing: 3px;\r\n            color: #1a3b5d;\r\n            text-transform: uppercase;\r\n            margin: 0 0 10px 0;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 4px;\r\n        }\r\n\r\n        /* ---- info grid ---- */\r\n        .info-grid {\r\n            display: flex;\r\n            gap: 16px;\r\n            margin-bottom: 10px;\r\n            flex-wrap: wrap;\r\n        }\r\n        .bill-to {\r\n            flex: 1.2;\r\n            min-width: 180px;\r\n        }\r\n        .bill-to .label {\r\n            font-weight: 700;\r\n            font-size: 10px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #1a3b5d;\r\n            padding-bottom: 2px;\r\n            margin-bottom: 4px;\r\n            display: inline-block;\r\n        }\r\n        .customer-name {\r\n            font-size: 14px;\r\n            font-weight: 700;\r\n            color: #00337a;\r\n            margin: 3px 0 1px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n            flex-wrap: wrap;\r\n        }\r\n        .cash-badge {\r\n            background: #f5a623;\r\n            color: #fff;\r\n            font-size: 8px;\r\n            font-weight: 700;\r\n            padding: 1px 10px;\r\n            border-radius: 30px;\r\n            letter-spacing: 0.4px;\r\n            text-transform: uppercase;\r\n        }\r\n        .address-line, .phone { display: none; }\r\n\r\n        .info-panel {\r\n            flex: 0.9;\r\n            min-width: 180px;\r\n            background: #f8fafc;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 12px 3px 12px;\r\n        }\r\n        .info-row {\r\n            display: flex;\r\n            justify-content: flex-start;\r\n            padding: 1px 0;\r\n            border-bottom: 1px dashed #dce4ed;\r\n            gap: 6px;\r\n            align-items: baseline;\r\n        }\r\n        .info-row:last-child { border-bottom: none; }\r\n        .info-row .ilabel {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            min-width: 82px;\r\n            font-size: 9px;\r\n        }\r\n        .info-row .ivalue {\r\n            font-weight: 500;\r\n            color: #00337a;\r\n            font-size: 9px;\r\n        }\r\n\r\n        .consigned {\r\n            margin: 4px 0 10px 0;\r\n            font-size: 10px;\r\n            font-weight: 500;\r\n            color: #1a3b5d;\r\n            background: #eef4fa;\r\n            padding: 2px 16px;\r\n            border-radius: 40px;\r\n            display: inline-block;\r\n            border: 1px solid #cbdae9;\r\n        }\r\n        .consigned strong { color: #00337a; }\r\n\r\n        /* ---- table (ultra compact) ---- */\r\n        .table-wrap {\r\n            margin: 8px 0 4px 0;\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            overflow: hidden;\r\n        }\r\n        .items-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .items-table th {\r\n            background: #e3eaf2;\r\n            color: #0a2647;\r\n            font-weight: 700;\r\n            padding: 2px 3px;\r\n            border: 1px solid #1f2e42;\r\n            text-align: center;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table td {\r\n            padding: 1px 3px;\r\n            border: 1px solid #1f2e42;\r\n            vertical-align: middle;\r\n            line-height: 1.2;\r\n        }\r\n        .items-table .alt-row td { background: #f6f9fd; }\r\n        .text-center { text-align: center; }\r\n        .text-right { text-align: right; }\r\n        .text-left { text-align: left; }\r\n        .font-bold { font-weight: 700; }\r\n\r\n        /* ---- totals section (extremely tight) ---- */\r\n        .totals-section {\r\n            display: flex;\r\n            justify-content: flex-end;\r\n            margin-top: 4px;\r\n            padding: 0 2px;\r\n        }\r\n        .totals-box {\r\n            border: 1px solid #1f2e42;\r\n            border-radius: 4px;\r\n            background: #f8fafc;\r\n            padding: 1px 10px 0px 10px;\r\n            width: 38%;\r\n            min-width: 250px;\r\n        }\r\n        .totals-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table td {\r\n            padding: 0px 3px;\r\n            border: none;\r\n            vertical-align: middle;\r\n            line-height: 1.1;\r\n        }\r\n        .totals-table .label {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n            padding-right: 14px;\r\n            width: 60%;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .amount {\r\n            text-align: right;\r\n            font-weight: 600;\r\n            color: #00337a;\r\n            width: 40%;\r\n            padding-right: 2px;\r\n            font-size: 9px;\r\n        }\r\n        .totals-table .total-row td {\r\n            border-top: 1px solid #d0dbe8;\r\n            padding-top: 1px;\r\n        }\r\n        .totals-table .grand-total td {\r\n            font-size: 10.5px;\r\n            font-weight: 700;\r\n            color: #0a2647;\r\n            border-top: 2px solid #1a3b5d;\r\n            padding-top: 1px;\r\n        }\r\n        .totals-table .grand-total .amount {\r\n            font-size: 11px;\r\n            color: #00337a;\r\n        }\r\n        .totals-table .tax-row td {\r\n            border-bottom: 1px dashed #dce4ed;\r\n            padding-bottom: 0px;\r\n        }\r\n\r\n        /* in words */\r\n        .in-words {\r\n            background: #f2f7ff;\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 3px 14px;\r\n            margin: 4px 0 8px 0;\r\n            display: flex;\r\n            gap: 10px;\r\n            font-size: 9.5px;\r\n            align-items: center;\r\n            flex-wrap: wrap;\r\n        }\r\n        .in-words strong { color: #1a3b5d; }\r\n\r\n        /* terms */\r\n        .terms-box {\r\n            border: 1px solid #d0dbe8;\r\n            border-radius: 5px;\r\n            padding: 4px 14px;\r\n            margin: 4px 0 10px 0;\r\n            background: #f8fbfe;\r\n        }\r\n        .terms-box h5 {\r\n            font-size: 9.5px;\r\n            font-weight: 700;\r\n            color: #1a3b5d;\r\n            margin-bottom: 1px;\r\n        }\r\n        .terms-box p {\r\n            font-size: 9px;\r\n            color: #1e2b3c;\r\n            line-height: 1.4;\r\n        }\r\n\r\n        /* signatures \u2014 only Prepared By and Received By */\r\n        .signature-grid {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin: 12px 0 4px 0;\r\n            flex-wrap: wrap;\r\n        }\r\n        .sig-card {\r\n            flex: 1;\r\n            min-width: 120px;\r\n            border: 1px solid #1a3b5d;\r\n            border-radius: 5px;\r\n            padding: 4px 8px 3px 8px;\r\n            background: #fafdff;\r\n        }\r\n        .sig-card .sig-head {\r\n            font-weight: 700;\r\n            font-size: 8.5px;\r\n            color: #1a3b5d;\r\n            border-bottom: 1px solid #d0dbe8;\r\n            padding-bottom: 1px;\r\n            margin-bottom: 3px;\r\n        }\r\n        .sig-card .sig-field {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            font-size: 8px;\r\n            margin: 1px 0;\r\n            color: #1e2b3c;\r\n        }\r\n        .sig-card .sig-field strong {\r\n            font-weight: 600;\r\n            color: #1a3b5d;\r\n        }\r\n        .sig-card .dash-line {\r\n            color: #7a8a9e;\r\n            letter-spacing: 0.5px;\r\n            font-weight: 300;\r\n        }\r\n        .sig-card .line-space {\r\n            height: 12px;\r\n            border-bottom: 1px dashed #b9cfe5;\r\n            margin: 1px 0 3px 0;\r\n        }\r\n\r\n        .footer-thank {\r\n            text-align: center;\r\n            font-size: 13px;\r\n            font-weight: 700;\r\n            color: #1a3b5d;\r\n            padding: 6px 0 2px 0;\r\n            margin-top: 6px;\r\n            border-top: 2px solid #1a3b5d;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        /* ---- print ---- */\r\n        @media print {\r\n            body {\r\n                background: #fff;\r\n                padding: 4px 8px;\r\n                display: block;\r\n                min-height: auto;\r\n            }\r\n            .invoice-wrapper {\r\n                max-width: 100%;\r\n                box-shadow: none;\r\n                border-radius: 0;\r\n                padding: 6px 10px;\r\n            }\r\n            .sig-card { min-height: 38px; }\r\n            .items-table th { background: #e3eaf2 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\r\n            .in-words, .terms-box, .info-panel, .totals-box {\r\n                -webkit-print-color-adjust: exact;\r\n                print-color-adjust: exact;\r\n            }\r\n            .totals-table td {\r\n                padding: 0px 3px;\r\n                line-height: 1;\r\n            }\r\n            .totals-box {\r\n                padding: 0px 10px 0px 10px;\r\n            }\r\n            .items-table th, .items-table td {\r\n                padding: 1px 3px;\r\n                line-height: 1.1;\r\n            }\r\n        }\r\n\r\n        @media (max-width: 700px) {\r\n            .info-grid { flex-direction: column; gap: 8px; }\r\n            .signature-grid { flex-direction: column; }\r\n            .sig-card { min-width: auto; }\r\n            .invoice-wrapper { padding: 12px 10px; }\r\n            .totals-box { width: 100%; min-width: auto; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"invoice-wrapper\">\r\n\r\n    <!-- ===== LETTERHEAD \u2014 logo + company name ===== -->\r\n    <div class=\"letterhead\">\r\n        <div class=\"brand\">\r\n            <img src=\"/files/Plumes Logo.png\" alt=\"Company Logo\" />\r\n            <span class=\"company\">{{ doc.company or 'Company Name' }}</span>\r\n        </div>\r\n        <div class=\"head-details\"></div>\r\n    </div>\r\n\r\n    <!-- ===== TITLE ===== -->\r\n    <div class=\"invoice-title\">Sales Invoice</div>\r\n\r\n    <!-- ===== INFO GRID ===== -->\r\n    <div class=\"info-grid\">\r\n        <div class=\"bill-to\">\r\n            <div class=\"label\">\ud83d\udcc4 Bill To</div>\r\n            <div class=\"customer-name\">\r\n                {% if doc.customer == \"Walk-in Customer\" %}\r\n                    {{ doc.custom_cash_customer_name or doc.customer_name }}\r\n                    <span class=\"cash-badge\">\ud83d\udcb5 Cash</span>\r\n                {% else %}\r\n                    {{ doc.customer_name }}\r\n                {% endif %}\r\n            </div>\r\n            <div class=\"address-line\"></div>\r\n            <div class=\"phone\"></div>\r\n        </div>\r\n\r\n        <div class=\"info-panel\">\r\n            <div class=\"info-row\"><span class=\"ilabel\">Invoice #</span><span class=\"ivalue\">{{ doc.name }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Invoice Date</span><span class=\"ivalue\">{{ doc.get_formatted(\"posting_date\") }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Due Date</span><span class=\"ivalue\">{{ doc.get_formatted(\"due_date\") }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Payment Terms</span><span class=\"ivalue\">{{ doc.payment_terms_template or 'Net 15' }}</span></div>\r\n            <div class=\"info-row\"><span class=\"ilabel\">Currency</span><span class=\"ivalue\">{{ doc.currency or 'NGN' }}</span></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- CONSIGNED -->\r\n    <div class=\"consigned\">\r\n        <strong>\ud83d\ude9a Consigned To:</strong> {{ doc.department or 'Sales Department' }}\r\n    </div>\r\n\r\n    <!-- ===== ITEMS TABLE ===== -->\r\n    <div class=\"table-wrap\">\r\n        <table class=\"items-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width:16%;\">Item Code</th>\r\n                    <th style=\"width:34%;\">Description</th>\r\n                    <th style=\"width:10%;\">UOM</th>\r\n                    <th style=\"width:10%;\">Qty</th>\r\n                    <th style=\"width:14%;\">Price ({{ doc.currency or 'NGN' }})</th>\r\n                    <th style=\"width:16%;\">Amount ({{ doc.currency or 'NGN' }})</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {%- for row in doc.items -%}\r\n                <tr class=\"{{ 'alt-row' if loop.index % 2 == 0 else '' }}\">\r\n                    <td class=\"text-center\">{{ row.item_code }}</td>\r\n                    <td class=\"text-left\">{{ row.description }}</td>\r\n                    <td class=\"text-center\">{{ row.uom }}</td>\r\n                    <td class=\"text-center\">{{ row.qty }}</td>\r\n                    <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\r\n                    <td class=\"text-right font-bold\">{{ row.get_formatted(\"amount\") }}</td>\r\n                </tr>\r\n                {%- endfor -%}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===== TOTALS SECTION ===== -->\r\n    <div class=\"totals-section\">\r\n        <div class=\"totals-box\">\r\n            <table class=\"totals-table\">\r\n                <tbody>\r\n                    <tr>\r\n                        <td class=\"label\">Subtotal</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"total\") }}</td>\r\n                    </tr>\r\n                    {% if doc.discount_amount %}\r\n                    <tr>\r\n                        <td class=\"label\">Discount ({{ doc.discount_percentage or '' }}%)</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"discount_amount\") }}</td>\r\n                    </tr>\r\n                    {% endif %}\r\n                    <tr>\r\n                        <td class=\"label\">Net Total</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"net_total\") }}</td>\r\n                    </tr>\r\n                    <tr class=\"tax-row\">\r\n                        <td class=\"label\">Value Added Tax</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"total_taxes_and_charges\") if doc.total_taxes_and_charges else '0.00' }}</td>\r\n                    </tr>\r\n                    <tr class=\"grand-total\">\r\n                        <td class=\"label\">Total Due</td>\r\n                        <td class=\"amount\">{{ doc.get_formatted(\"grand_total\") }}</td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== IN WORDS ===== -->\r\n    <div class=\"in-words\">\r\n        <strong>In Words:</strong>\r\n        <span>{{ doc.in_words or 'Zero' }}</span>\r\n    </div>\r\n\r\n    <!-- ===== TERMS ===== -->\r\n    <div class=\"terms-box\">\r\n        <h5>\ud83d\udccb Terms & Conditions</h5>\r\n        <p>{{ doc.terms or 'Payment due within 15 days from invoice date. Please quote invoice number when making payment.' }}</p>\r\n    </div>\r\n\r\n    <!-- ===== SIGNATURES \u2014 only Prepared By and Received By ===== -->\r\n    <div class=\"signature-grid\">\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\u270d\ufe0f Prepared By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Rank:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n        <div class=\"sig-card\">\r\n            <div class=\"sig-head\">\ud83d\udce6 Received By</div>\r\n            <div class=\"line-space\"></div>\r\n            <div class=\"sig-field\"><strong>Sign & Date</strong> <span class=\"dash-line\">__________________</span></div>\r\n            <div class=\"sig-field\"><strong>Rank:</strong> <span class=\"dash-line\">__________________</span></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===== FOOTER ===== -->\r\n    <div class=\"footer-thank\">\r\n        \u2b50 Thank You For Your Business! \u2b50\r\n    </div>\r\n\r\n</div>\r\n<!-- end invoice-wrapper -->\r\n</body>\r\n</html>",
