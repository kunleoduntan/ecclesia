 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"sales-invoice\">\r\n    <!-- DYNAMIC HEADER WITH LOGO -->\r\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;\">\r\n        <div>\r\n            <h1 style=\"margin: 0 0 5px 0; font-size: 22px; color: #111;\">TAX INVOICE</h1>\r\n            <div style=\"font-size: 12px; color: #666;\">\r\n                <strong>Invoice No:</strong> {{ doc.name }} | \r\n                <strong>Date:</strong> {{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}\r\n            </div>\r\n        </div>\r\n        <div style=\"text-align: right;\">\r\n            <img src=\"/private/files/Lessafree.png\" alt=\"Company Logo\" style=\"height: 60px; margin-bottom: 5px;\">\r\n            <div style=\"font-size: 14px; font-weight: bold; color: #333;\">\r\n                {{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}\r\n            </div>\r\n            <div style=\"font-size: 11px; color: #777; margin-top: 2px;\">\r\n                {% if doc.company_tax_id %}\r\n                <strong>Tax ID:</strong> {{ doc.company_tax_id }}\r\n                {% endif %}\r\n            </div>\r\n            <div style=\"font-size: 10px; color: #999; margin-top: 2px;\">\r\n                Printed: {{ frappe.utils.now_datetime().strftime(\"%d-%m-%Y %H:%M\") }}\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- COMPACT INVOICE DETAILS -->\r\n    <table style=\"width: 100%; margin: 10px 0; font-size: 12px; background: #f8f9fa; border-radius: 5px; padding: 8px;\">\r\n        <tr>\r\n            <td width=\"33%\"><strong>Customer:</strong> {{ doc.customer_name }}</td>\r\n            <td width=\"33%\"><strong>Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date, \"dd-MM-yyyy\") if doc.due_date else \"N/A\" }}</td>\r\n            <td width=\"34%\"><strong>Currency:</strong> {{ doc.currency }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- CUSTOMER DETAILS ONLY -->\r\n    <div style=\"border: 1px solid #ddd; border-radius: 5px; padding: 12px; margin-bottom: 15px;\">\r\n        <div style=\"font-weight: bold; font-size: 13px; color: #333; margin-bottom: 8px;\">Bill To</div>\r\n        <table style=\"width: 100%; font-size: 12px;\">\r\n            <tr>\r\n                <td style=\"width: 100px; vertical-align: top;\"><strong>Name:</strong></td>\r\n                <td>{{ doc.customer_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"vertical-align: top;\"><strong>Address:</strong></td>\r\n                <td>{{ doc.address_display or \"\" }}</td>\r\n            </tr>\r\n            {% if doc.tax_id %}\r\n            <tr>\r\n                <td><strong>Tax ID:</strong></td>\r\n                <td>{{ doc.tax_id }}</td>\r\n            </tr>\r\n            {% endif %}\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ITEMS TABLE -->\r\n    <div style=\"margin-bottom: 20px; page-break-inside: avoid;\">\r\n        <div style=\"font-weight: bold; font-size: 13px; color: #333; margin-bottom: 8px;\">Items & Services</div>\r\n        <table style=\"width: 100%; font-size: 11px; border-collapse: collapse; border: 1px solid #ddd;\">\r\n            <thead>\r\n                <tr style=\"background: #e9ecef;\">\r\n                    <th style=\"text-align: left; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">#</th>\r\n                    <th style=\"text-align: left; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">Item Code</th>\r\n                    <th style=\"text-align: left; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">Description</th>\r\n                    <th style=\"text-align: center; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">Qty</th>\r\n                    <th style=\"text-align: center; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">UOM</th>\r\n                    <th style=\"text-align: right; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">Rate</th>\r\n                    <th style=\"text-align: right; padding: 6px 8px; border: 1px solid #ccc; font-weight: bold;\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.items %}\r\n                <tr>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee; text-align: center;\">{{ loop.index }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee;\">{{ item.item_code }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee;\">{{ item.description or item.item_name }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee; text-align: center;\">{{ item.qty }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee; text-align: center;\">{{ item.uom }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee; text-align: right;\">{{ frappe.format_value(item.rate, {'fieldtype': 'Currency', 'options': doc.currency}) }}</td>\r\n                    <td style=\"padding: 6px 8px; border: 1px solid #eee; text-align: right;\">{{ frappe.format_value(item.amount, {'fieldtype': 'Currency', 'options': doc.currency}) }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- TOTALS & TAXES -->\r\n    <div style=\"display: flex; gap: 15px; margin-bottom: 15px;\">\r\n        <!-- TAX CALCULATION -->\r\n        <div style=\"flex: 1; border: 1px solid #ddd; border-radius: 5px; padding: 10px;\">\r\n            <div style=\"font-weight: bold; font-size: 13px; color: #333; margin-bottom: 8px;\">Tax Calculation</div>\r\n            <table style=\"width: 100%; font-size: 12px;\">\r\n                <tr>\r\n                    <td><strong>Net Total:</strong></td>\r\n                    <td style=\"text-align: right;\">{{ frappe.format_value(doc.net_total, {'fieldtype': 'Currency', 'options': doc.currency}) }}</td>\r\n                </tr>\r\n                {% for tax in doc.taxes %}\r\n                <tr>\r\n                    <td>{{ tax.account_head }} ({{ tax.rate }}%):</td>\r\n                    <td style=\"text-align: right;\">+ {{ frappe.format_value(tax.tax_amount, {'fieldtype': 'Currency', 'options': doc.currency}) }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n                {% if doc.discount_amount %}\r\n                <tr>\r\n                    <td><strong>Discount:</strong></td>\r\n                    <td style=\"text-align: right; color: #c62828;\">- {{ frappe.format_value(doc.discount_amount, {'fieldtype': 'Currency', 'options': doc.currency}) }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                <tr style=\"border-top: 1px solid #ccc;\">\r\n                    <td style=\"padding-top: 5px;\"><strong>Grand Total:</strong></td>\r\n                    <td style=\"text-align: right; padding-top: 5px; font-weight: bold; font-size: 14px; color: #2e7d32;\">\r\n                        {{ frappe.format_value(doc.grand_total, {'fieldtype': 'Currency', 'options': doc.currency}) }}\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n\r\n        <!-- AMOUNT IN WORDS -->\r\n        <div style=\"flex: 1; border: 1px solid #cce0ff; border-radius: 5px; padding: 10px; background: #f0f7ff;\">\r\n            <div style=\"font-weight: bold; font-size: 13px; color: #333; margin-bottom: 8px;\">Amount in Words</div>\r\n            <div style=\"font-size: 12px; line-height: 1.4; min-height: 80px;\">\r\n                {{ doc.in_words or \"Not specified\" }}\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- SIGNATURE -->\r\n    <div style=\"margin-top: 30px; page-break-inside: avoid;\">\r\n        <div style=\"text-align: center; font-size: 11px;\">\r\n            <div style=\"border-top: 1px solid #444; width: 60%; margin: 0 auto 8px; padding-top: 20px;\"></div>\r\n            <strong>Authorized Signatory</strong><br>\r\n            For {{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}<br>\r\n            <span style=\"color: #666;\">________________</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER NOTE -->\r\n    <div style=\"border-top: 1px solid #ccc; margin-top: 40px; padding-top: 8px; text-align: center; color: #666; font-size: 10px;\">\r\n        <p style=\"margin: 2px 0;\">This is a computer-generated tax invoice. No physical signature is required.</p>\r\n        <p style=\"margin: 2px 0; font-style: italic;\">Invoice: {{ doc.name }} | Company: {{ doc.company }} | Printed on: {{ frappe.utils.now_datetime().strftime(\"%d-%m-%Y %H:%M\") }}</p>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n.sales-invoice {\r\n    font-family: \"Segoe UI\", Arial, sans-serif;\r\n    color: #222;\r\n    line-height: 1.4;\r\n    font-size: 12px;\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n    padding: 5mm;\r\n}\r\n\r\n/* PRINT STYLES */\r\n@media print {\r\n    .sales-invoice {\r\n        max-width: 100%;\r\n        padding: 0;\r\n    }\r\n    \r\n    @page {\r\n        size: A4 portrait;\r\n        margin: 15mm;\r\n    }\r\n    \r\n    @page :first {\r\n        margin-top: 15mm;\r\n    }\r\n    \r\n    /* Page break handling */\r\n    .page-break {\r\n        page-break-before: always;\r\n    }\r\n    \r\n    /* Prevent breaking inside important sections */\r\n    h1, h2, h3, h4 {\r\n        page-break-after: avoid;\r\n    }\r\n    \r\n    table {\r\n        page-break-inside: avoid;\r\n    }\r\n    \r\n    /* Ensure content flows beyond one page */\r\n    body, html {\r\n        height: auto;\r\n        overflow: visible;\r\n    }\r\n    \r\n    .sales-invoice {\r\n        height: auto;\r\n        min-height: 100%;\r\n    }\r\n    \r\n    /* Print optimizations */\r\n    * {\r\n        -webkit-print-color-adjust: exact !important;\r\n        print-color-adjust: exact !important;\r\n    }\r\n    \r\n    /* Hide unnecessary elements when printing */\r\n    .no-print {\r\n        display: none !important;\r\n    }\r\n    \r\n    /* Force table headers on each page */\r\n    thead {\r\n        display: table-header-group;\r\n    }\r\n    \r\n    tfoot {\r\n        display: table-footer-group;\r\n    }\r\n    \r\n    /* Add continuation notice for multi-page tables */\r\n    table {\r\n        page-break-inside: auto;\r\n    }\r\n    \r\n    tr {\r\n        page-break-inside: avoid;\r\n        page-break-after: auto;\r\n    }\r\n}\r\n\r\n/* Responsive adjustments */\r\n@media screen and (max-width: 768px) {\r\n    .sales-invoice {\r\n        font-size: 11px;\r\n        padding: 10px;\r\n    }\r\n}\r\n</style>",
