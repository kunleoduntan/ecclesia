{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-18 18:22:48.734675",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Fixed Asset Purchase",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"fixed-asset-purchase\">\r\n    <!-- LETTERHEAD SUPPORT -->\r\n    {{ letter_head }}\r\n    \r\n    <!-- DOCUMENT HEADER -->\r\n    <div class=\"doc-header\">\r\n        <div class=\"header-top\">\r\n            <div class=\"header-left\">\r\n                <h1>FIXED ASSET PURCHASE</h1>\r\n                <div class=\"doc-ref\">\r\n                    <span class=\"ref-label\">Document No:</span> \r\n                    <span class=\"ref-value\">{{ doc.name }}</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"header-right\">\r\n                <div class=\"status-badge status-{{ doc.status|lower|replace(' ', '-') if doc.status else 'draft' }}\">\r\n                    {{ doc.status or \"DRAFT\" }}\r\n                </div>\r\n                <div class=\"doc-date\">Posted: {{ frappe.utils.formatdate(doc.posting_date, \"dd MMM yyyy\") }}</div>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- PURCHASE TYPE BADGE -->\r\n        <div class=\"purchase-type-row\">\r\n            <div class=\"type-badge type-{{ doc.purchase_type|lower|replace(' ', '-') if doc.purchase_type else '' }}\">\r\n                {{ doc.purchase_type or \"Purchase Type\" }}\r\n            </div>\r\n            {% if doc.payment_type %}\r\n            <div class=\"payment-badge\">{{ doc.payment_type }}</div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- KEY PARTIES - COMPACT -->\r\n    <div class=\"parties-grid\">\r\n        <div class=\"party-item\">\r\n            <div class=\"party-label\">Company</div>\r\n            <div class=\"party-value\">{{ doc.company or \"\u2014\" }}</div>\r\n        </div>\r\n        \r\n        {% if doc.purchase_type == \"Supplier Purchase\" %}\r\n        <div class=\"party-item\">\r\n            <div class=\"party-label\">Supplier</div>\r\n            <div class=\"party-value\">{{ doc.supplier_name or doc.supplier or \"\u2014\" }}</div>\r\n            {% if doc.supplier_invoice_number %}\r\n            <div class=\"party-ref\">Invoice: {{ doc.supplier_invoice_number }}</div>\r\n            {% endif %}\r\n        </div>\r\n        {% endif %}\r\n        \r\n        {% if doc.purchase_type == \"Cash Purchase\" and doc.bank_account %}\r\n        <div class=\"party-item\">\r\n            <div class=\"party-label\">Bank Account</div>\r\n            <div class=\"party-value\">{{ doc.bank_account }}</div>\r\n            {% if doc.payment_reference %}\r\n            <div class=\"party-ref\">Ref: {{ doc.payment_reference }}</div>\r\n            {% endif %}\r\n        </div>\r\n        {% endif %}\r\n        \r\n        <div class=\"party-item\">\r\n            <div class=\"party-label\">Cost Center</div>\r\n            <div class=\"party-value\">{{ doc.cost_center or \"\u2014\" }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- KEY METRICS CARDS -->\r\n    <div class=\"metrics-cards\">\r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Total Assets</div>\r\n            <div class=\"metric-value\">{{ doc.total_qty or \"0\" }}</div>\r\n            <div class=\"metric-sub\">Quantity</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Asset Value</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.total, currency='NGN') }}</div>\r\n            <div class=\"metric-sub\">Before Add-ons</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card\">\r\n            <div class=\"metric-label\">Add. Costs</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.total_additional_costs or 0, currency='NGN') }}</div>\r\n            <div class=\"metric-sub\">+ Taxes: {{ frappe.utils.fmt_money(doc.total_taxes_and_charges or 0, currency='NGN') }}</div>\r\n        </div>\r\n        \r\n        <div class=\"metric-card highlight\">\r\n            <div class=\"metric-label\">Grand Total</div>\r\n            <div class=\"metric-value\">{{ frappe.utils.fmt_money(doc.grand_total, currency='NGN') }}</div>\r\n            {% if doc.outstanding_amount > 0 %}\r\n            <div class=\"metric-sub outstanding\">Outstanding: {{ frappe.utils.fmt_money(doc.outstanding_amount, currency='NGN') }}</div>\r\n            {% elif doc.payment_status == \"Paid\" %}\r\n            <div class=\"metric-sub paid\">\u2713 Paid</div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- DATES SECTION -->\r\n    <div class=\"details-section\">\r\n        <div class=\"section-header\">DATES</div>\r\n        <div class=\"details-grid\">\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Purchase Date:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.purchase_date, \"dd MMM yyyy\") if doc.purchase_date else \"\u2014\" }}</span>\r\n            </div>\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Posting Date:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.posting_date, \"dd MMM yyyy\") if doc.posting_date else \"\u2014\" }}</span>\r\n            </div>\r\n            {% if doc.expected_delivery_date %}\r\n            <div class=\"detail-item\">\r\n                <span class=\"detail-label\">Expected Delivery:</span>\r\n                <span class=\"detail-value\">{{ frappe.utils.formatdate(doc.expected_delivery_date, \"dd MMM yyyy\") }}</span>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ASSET PURCHASE DETAILS TABLE - ONLY IMPORTANT COLUMNS -->\r\n    {% if doc.asset_purchase_details and doc.asset_purchase_details|length > 0 %}\r\n    <div class=\"table-section\">\r\n        <div class=\"section-header\">ASSET PURCHASE DETAILS</div>\r\n        \r\n        <table class=\"compact-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>#</th>\r\n                    <th>Category</th>\r\n                    <th>Asset Name</th>\r\n                    <th class=\"text-center\">Qty</th>\r\n                    <th class=\"text-right\">Rate</th>\r\n                    <th class=\"text-right\">Amount</th>\r\n                    <th class=\"text-center\">Loc</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set total_qty = 0 %}\r\n                {% set total_amount = 0 %}\r\n                \r\n                {% for row in doc.asset_purchase_details %}\r\n                    {% set total_qty = total_qty + row.qty|float %}\r\n                    {% set total_amount = total_amount + row.amount|float %}\r\n                <tr>\r\n                    <td>{{ loop.index }}</td>\r\n                    <td><strong>{{ row.asset_category or \"\u2014\" }}</strong></td>\r\n                    <td>{{ row.asset_name or row.description or \"\u2014\" }}</td>\r\n                    <td class=\"text-center\">{{ row.qty }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.rate, currency='NGN') }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.amount, currency='NGN') }}</td>\r\n                    <td class=\"text-center\">{{ row.location or \"\u2014\" }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n            <tfoot>\r\n                <tr>\r\n                    <td colspan=\"3\"><strong>TOTALS</strong></td>\r\n                    <td class=\"text-center\"><strong>{{ total_qty }}</strong></td>\r\n                    <td></td>\r\n                    <td class=\"text-right\"><strong>{{ frappe.utils.fmt_money(total_amount, currency='NGN') }}</strong></td>\r\n                    <td></td>\r\n                </tr>\r\n            </tfoot>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ADDITIONAL COSTS TABLE -->\r\n    {% if doc.additional_costs and doc.additional_costs|length > 0 %}\r\n    <div class=\"table-section\">\r\n        <div class=\"section-header\">ADDITIONAL COSTS</div>\r\n        \r\n        <table class=\"compact-table small-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>Description</th>\r\n                    <th class=\"text-right\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set total_costs = 0 %}\r\n                {% for row in doc.additional_costs %}\r\n                    {% set total_costs = total_costs + row.amount|float %}\r\n                <tr>\r\n                    <td>{{ row.description or \"\u2014\" }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.amount, currency='NGN') }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n            <tfoot>\r\n                <tr>\r\n                    <td><strong>Total</strong></td>\r\n                    <td class=\"text-right\"><strong>{{ frappe.utils.fmt_money(total_costs, currency='NGN') }}</strong></td>\r\n                </tr>\r\n            </tfoot>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- TAXES TABLE -->\r\n    {% if doc.taxes_and_charges_table and doc.taxes_and_charges_table|length > 0 %}\r\n    <div class=\"table-section\">\r\n        <div class=\"section-header\">TAXES</div>\r\n        \r\n        <table class=\"compact-table small-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>Description</th>\r\n                    <th class=\"text-center\">Rate %</th>\r\n                    <th class=\"text-right\">Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set total_taxes = 0 %}\r\n                {% for row in doc.taxes_and_charges_table %}\r\n                    {% set total_taxes = total_taxes + row.tax_amount|float %}\r\n                <tr>\r\n                    <td>{{ row.description or row.account_head or \"\u2014\" }}</td>\r\n                    <td class=\"text-center\">{{ row.rate|round(2) if row.rate else \"\u2014\" }}%</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.tax_amount, currency='NGN') }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n            <tfoot>\r\n                <tr>\r\n                    <td colspan=\"2\"><strong>Total</strong></td>\r\n                    <td class=\"text-right\"><strong>{{ frappe.utils.fmt_money(total_taxes, currency='NGN') }}</strong></td>\r\n                </tr>\r\n            </tfoot>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- PAYMENT SCHEDULE TABLE -->\r\n    {% if doc.payment_schedule and doc.payment_schedule|length > 0 %}\r\n    <div class=\"table-section\">\r\n        <div class=\"section-header\">PAYMENT SCHEDULE</div>\r\n        \r\n        <table class=\"compact-table small-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>Due Date</th>\r\n                    <th class=\"text-right\">Amount</th>\r\n                    <th class=\"text-center\">Status</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% set total_payments = 0 %}\r\n                {% for row in doc.payment_schedule %}\r\n                    {% set total_payments = total_payments + row.payment_amount|float %}\r\n                <tr>\r\n                    <td>{{ frappe.utils.formatdate(row.due_date, \"dd MMM yyyy\") if row.due_date else \"\u2014\" }}</td>\r\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(row.payment_amount, currency='NGN') }}</td>\r\n                    <td class=\"text-center\">\r\n                        <span class=\"status-indicator {{ row.payment_status|lower|replace(' ', '-') if row.payment_status else 'unpaid' }}\">\r\n                            {{ row.payment_status or \"Unpaid\" }}\r\n                        </span>\r\n                    </td>\r\n                </tr>\r\n                {% endfor %}\r\n            </tbody>\r\n            <tfoot>\r\n                <tr>\r\n                    <td><strong>Total</strong></td>\r\n                    <td class=\"text-right\"><strong>{{ frappe.utils.fmt_money(total_payments, currency='NGN') }}</strong></td>\r\n                    <td></td>\r\n                </tr>\r\n            </tfoot>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- ASSET CREATION STATUS -->\r\n    <div class=\"status-section\">\r\n        <div class=\"status-grid\">\r\n            <div class=\"status-item\">\r\n                <span class=\"status-item-label\">Assets Created:</span>\r\n                <span class=\"status-item-value {% if doc.assets_created %}success{% else %}warning{% endif %}\">\r\n                    {{ \"\u2713 Yes\" if doc.assets_created else \"\u2717 No\" }}\r\n                </span>\r\n            </div>\r\n            \r\n            {% if doc.purchase_invoice_created %}\r\n            <div class=\"status-item\">\r\n                <span class=\"status-item-label\">Purchase Invoice:</span>\r\n                <span class=\"status-item-value success\">\u2713 Created</span>\r\n                {% if doc.purchase_invoice %}\r\n                <span class=\"status-item-ref\">{{ doc.purchase_invoice }}</span>\r\n                {% endif %}\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.journal_entry %}\r\n            <div class=\"status-item\">\r\n                <span class=\"status-item-label\">Journal Entry:</span>\r\n                <span class=\"status-item-value success\">\u2713 Created</span>\r\n                <span class=\"status-item-ref\">{{ doc.journal_entry }}</span>\r\n            </div>\r\n            {% endif %}\r\n            \r\n            {% if doc.item_linked_code %}\r\n            <div class=\"status-item\">\r\n                <span class=\"status-item-label\">Item Code:</span>\r\n                <span class=\"status-item-value\">{{ doc.item_linked_code }}</span>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- NOTES -->\r\n    {% if doc.remarks %}\r\n    <div class=\"notes-section\">\r\n        <div class=\"notes-title\">Remarks</div>\r\n        <div class=\"notes-content\">{{ doc.remarks }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- SIGNATURES -->\r\n    <div class=\"signatures-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"sig-line\"></div>\r\n            <div class=\"sig-label\">Prepared By</div>\r\n            <div class=\"sig-name\">{{ doc.owner or \"____________________\" }}</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"sig-line\"></div>\r\n            <div class=\"sig-label\">Authorized By</div>\r\n            <div class=\"sig-name\">{{ doc.modified_by or \"____________________\" }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n    <div class=\"footer\">\r\n        <span>Generated: {{ frappe.utils.now_datetime().strftime(\"%d %b %Y %H:%M\") }}</span>\r\n        <span> | Document: {{ doc.name }}</span>\r\n        <span> | Company: {{ doc.company }}</span>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n.fixed-asset-purchase {\r\n    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;\r\n    max-width: 780px;\r\n    margin: 0 auto;\r\n    color: #1e293b;\r\n    font-size: 10px;\r\n    padding: 12px;\r\n}\r\n\r\n/* Document Header */\r\n.doc-header {\r\n    margin-bottom: 12px;\r\n    padding-bottom: 8px;\r\n    border-bottom: 2px solid #0f3b5e;\r\n}\r\n\r\n.header-top {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.header-left h1 {\r\n    margin: 0;\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    color: #0f3b5e;\r\n}\r\n\r\n.doc-ref {\r\n    font-size: 10px;\r\n    color: #4b5563;\r\n    margin-top: 2px;\r\n}\r\n\r\n.ref-label {\r\n    font-weight: 500;\r\n    color: #6b7280;\r\n}\r\n\r\n.ref-value {\r\n    font-weight: 600;\r\n    color: #0f3b5e;\r\n}\r\n\r\n.header-right {\r\n    text-align: right;\r\n}\r\n\r\n.status-badge {\r\n    display: inline-block;\r\n    padding: 4px 12px;\r\n    border-radius: 20px;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.status-draft { background: #f3f4f6; color: #6b7280; }\r\n.status-submitted { background: #10b981; color: white; }\r\n.status-cancelled { background: #ef4444; color: white; }\r\n\r\n.doc-date {\r\n    font-size: 9px;\r\n    color: #4b5563;\r\n    margin-top: 2px;\r\n}\r\n\r\n.purchase-type-row {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin-top: 5px;\r\n}\r\n\r\n.type-badge {\r\n    display: inline-block;\r\n    padding: 4px 12px;\r\n    border-radius: 16px;\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    background: white;\r\n    border: 1px solid;\r\n}\r\n\r\n.type-cash-purchase { border-color: #10b981; color: #10b981; }\r\n.type-supplier-purchase { border-color: #3b82f6; color: #3b82f6; }\r\n\r\n.payment-badge {\r\n    display: inline-block;\r\n    padding: 4px 10px;\r\n    border-radius: 12px;\r\n    font-size: 8px;\r\n    font-weight: 600;\r\n    background: #f3f4f6;\r\n    color: #4b5563;\r\n}\r\n\r\n/* Parties Grid */\r\n.parties-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 10px;\r\n    margin-bottom: 15px;\r\n    background: #f8fafc;\r\n    padding: 10px;\r\n    border-radius: 6px;\r\n    border: 1px solid #e2e8f0;\r\n}\r\n\r\n.party-item {\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.party-label {\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    color: #64748b;\r\n    font-weight: 600;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.party-value {\r\n    font-size: 10px;\r\n    font-weight: 600;\r\n    color: #0f172a;\r\n    margin: 2px 0;\r\n}\r\n\r\n.party-ref {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n}\r\n\r\n/* Metrics Cards */\r\n.metrics-cards {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 8px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.metric-card {\r\n    background: white;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 8px;\r\n    text-align: center;\r\n}\r\n\r\n.metric-card.highlight {\r\n    background: #f0f7ff;\r\n    border-color: #0f3b5e;\r\n}\r\n\r\n.metric-label {\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    color: #64748b;\r\n    font-weight: 600;\r\n    margin-bottom: 2px;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.metric-value {\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    color: #0f172a;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n.metric-sub {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n}\r\n\r\n.metric-sub.outstanding {\r\n    color: #dc2626;\r\n    font-weight: 600;\r\n}\r\n\r\n.metric-sub.paid {\r\n    color: #059669;\r\n    font-weight: 600;\r\n}\r\n\r\n/* Details Section */\r\n.details-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.section-header {\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    color: #0f3b5e;\r\n    margin-bottom: 8px;\r\n    padding-bottom: 3px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.details-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 6px;\r\n}\r\n\r\n.detail-item {\r\n    display: flex;\r\n    padding: 3px 0;\r\n    border-bottom: 1px dashed #e2e8f0;\r\n}\r\n\r\n.detail-label {\r\n    width: 100px;\r\n    color: #64748b;\r\n    font-weight: 500;\r\n    font-size: 9px;\r\n}\r\n\r\n.detail-value {\r\n    flex: 1;\r\n    text-align: right;\r\n    font-weight: 600;\r\n    font-size: 9px;\r\n    color: #0f172a;\r\n}\r\n\r\n/* Tables */\r\n.table-section {\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.compact-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    font-size: 8px;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    overflow: hidden;\r\n}\r\n\r\n.compact-table thead {\r\n    background: #0f3b5e;\r\n}\r\n\r\n.compact-table th {\r\n    padding: 5px 4px;\r\n    color: white;\r\n    font-weight: 600;\r\n    font-size: 7px;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.3px;\r\n}\r\n\r\n.compact-table td {\r\n    padding: 4px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.compact-table tbody tr:nth-child(even) {\r\n    background-color: #f8fafc;\r\n}\r\n\r\n.compact-table tfoot {\r\n    background: #f1f5f9;\r\n    font-weight: 600;\r\n}\r\n\r\n.compact-table tfoot td {\r\n    padding: 5px 4px;\r\n}\r\n\r\n.compact-table.small-table td {\r\n    padding: 3px 4px;\r\n}\r\n\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n\r\n/* Status Section */\r\n.status-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.status-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 8px;\r\n}\r\n\r\n.status-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 5px;\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.status-item-label {\r\n    font-size: 8px;\r\n    color: #64748b;\r\n    font-weight: 500;\r\n}\r\n\r\n.status-item-value {\r\n    font-size: 8px;\r\n    font-weight: 600;\r\n    padding: 2px 6px;\r\n    border-radius: 10px;\r\n}\r\n\r\n.status-item-value.success {\r\n    background: #dcfce7;\r\n    color: #166534;\r\n}\r\n\r\n.status-item-value.warning {\r\n    background: #fef3c7;\r\n    color: #92400e;\r\n}\r\n\r\n.status-item-ref {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n    font-family: monospace;\r\n}\r\n\r\n.status-indicator {\r\n    display: inline-block;\r\n    padding: 2px 6px;\r\n    border-radius: 10px;\r\n    font-size: 7px;\r\n    font-weight: 600;\r\n}\r\n\r\n.status-indicator.paid {\r\n    background: #dcfce7;\r\n    color: #166534;\r\n}\r\n\r\n.status-indicator.unpaid {\r\n    background: #fee2e2;\r\n    color: #991b1b;\r\n}\r\n\r\n.status-indicator.partially-paid {\r\n    background: #fef3c7;\r\n    color: #92400e;\r\n}\r\n\r\n/* Notes Section */\r\n.notes-section {\r\n    background: #f8fafc;\r\n    border: 1px solid #e2e8f0;\r\n    border-radius: 6px;\r\n    padding: 10px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.notes-title {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #0f3b5e;\r\n    margin-bottom: 4px;\r\n    padding-bottom: 2px;\r\n    border-bottom: 1px solid #e2e8f0;\r\n}\r\n\r\n.notes-content {\r\n    font-size: 9px;\r\n    color: #4b5563;\r\n    line-height: 1.4;\r\n}\r\n\r\n/* Signatures */\r\n.signatures-section {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 20px;\r\n    margin: 15px 0 8px;\r\n}\r\n\r\n.signature-box {\r\n    text-align: center;\r\n}\r\n\r\n.sig-line {\r\n    border-top: 1px solid #94a3b8;\r\n    width: 100%;\r\n    margin-bottom: 4px;\r\n    padding-top: 15px;\r\n}\r\n\r\n.sig-label {\r\n    font-size: 7px;\r\n    color: #64748b;\r\n    font-weight: 500;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n.sig-name {\r\n    font-size: 9px;\r\n    font-weight: 600;\r\n    color: #0f172a;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* Footer */\r\n.footer {\r\n    border-top: 1px solid #e2e8f0;\r\n    margin-top: 10px;\r\n    padding-top: 5px;\r\n    text-align: center;\r\n    color: #64748b;\r\n    font-size: 7px;\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: 10px;\r\n}\r\n\r\n/* Print Styles */\r\n@media print {\r\n    .fixed-asset-purchase {\r\n        max-width: 100%;\r\n        padding: 0;\r\n    }\r\n    \r\n    @page {\r\n        size: A4;\r\n        margin: 10mm 8mm;\r\n   