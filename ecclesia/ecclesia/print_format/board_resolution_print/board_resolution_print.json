 "html": "<style>\n  @page { margin: 12mm 10mm 10mm 10mm; }\n  * { box-sizing: border-box; }\n  .container { max-width: 100%; font-family: 'Inter', -apple-system, sans-serif; color: #1a1a2e; background: #ffffff; }\n  .header { border-bottom: 3px solid #7c3aed; padding-bottom: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }\n  .header h1 { font-size: 18px; font-weight: 700; color: #7c3aed; margin: 0; letter-spacing: 0.3px; }\n  .header .badge { background: #7c3aed; color: #fff; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }\n  .doc-info { display: flex; gap: 20px; background: #f8fafc; padding: 7px 14px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #e2e8f0; font-size: 11px; flex-wrap: wrap; }\n  .doc-info .item { display: flex; align-items: center; gap: 5px; }\n  .doc-info .label { color: #64748b; font-weight: 500; }\n  .doc-info .value { font-weight: 600; color: #0f172a; }\n  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; margin-bottom: 12px; }\n  .field-row { display: flex; padding: 3px 0; border-bottom: 1px solid #f1f5f9; }\n  .field-row .lbl { width: 38%; font-size: 11px; color: #64748b; font-weight: 500; }\n  .field-row .val { width: 62%; font-size: 12px; color: #0f172a; font-weight: 500; }\n  .section-title { font-size: 13px; font-weight: 700; color: #7c3aed; margin: 12px 0 6px 0; padding-bottom: 4px; border-bottom: 2px solid #e2e8f0; }\n  .status-badge { display: inline-block; padding: 1px 10px; border-radius: 12px; font-size: 10px; font-weight: 600; }\n  .status-Pending { background: #fef9c3; color: #854d0e; }\n  .status-In { background: #dbeafe; color: #1e40af; }\n  .status-Implemented { background: #dcfce7; color: #166534; }\n  .resolution-box { padding: 12px 16px; background: #f8fafc; border-radius: 6px; font-size: 12px; color: #1e293b; border: 1px solid #e2e8f0; margin-bottom: 10px; line-height: 1.6; font-style: italic; border-left: 4px solid #7c3aed; }\n  .signature-box { border-top: 1.5px solid #94a3b8; padding-top: 5px; font-size: 10.5px; color: #475569; text-align: center; width: 60%; margin-top: 14px; }\n  .signature-box strong { font-size: 12px; color: #0f172a; }\n  .footer { margin-top: 16px; padding-top: 8px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }\n</style>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>\ud83d\udcdc Board Resolution</h1>\n    <span class=\"badge\">{{ doc.implementation_status }}</span>\n  </div>\n  \n  <div class=\"doc-info\">\n    <span class=\"item\"><span class=\"label\">Resolution #:</span> <span class=\"value\">{{ doc.name }}</span></span>\n    <span class=\"item\"><span class=\"label\">Title:</span> <span class=\"value\">{{ doc.resolution_title }}</span></span>\n    <span class=\"item\"><span class=\"label\">Status:</span> <span class=\"value\"><span class=\"status-badge status-{{ doc.implementation_status.replace(' ', '') }}\">{{ doc.implementation_status }}</span></span></span>\n    <span class=\"item\"><span class=\"label\">CAC Filing:</span> <span class=\"value\">{% if doc.cac_filed %}\u2705 Filed{% else %}\u2b1c Pending{% endif %}</span></span>\n  </div>\n  \n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Company</span><span class=\"val\">{{ doc.company }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Meeting Type</span><span class=\"val\">{{ doc.meeting_type }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Meeting Date</span><span class=\"val\">{{ frappe.format_date(doc.meeting_date) }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Resolution Number</span><span class=\"val\">{{ doc.resolution_number or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Category</span><span class=\"val\">{{ doc.resolution_category }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Quorum Met</span><span class=\"val\">{% if doc.quorum_met %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Directors Present</span><span class=\"val\">{{ doc.directors_present or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Responsible Officer</span><span class=\"val\">{{ doc.responsible_officer or '\u2014' }}</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udccb Resolution Text</div>\n  <div class=\"resolution-box\">{{ doc.resolution_text or 'No resolution text provided.' }}</div>\n\n  <div class=\"grid-2\">\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Moved By</span><span class=\"val\">{{ doc.resolved_by or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">Seconded By</span><span class=\"val\">{{ doc.seconded_by or '\u2014' }}</span></div>\n    </div>\n    <div>\n      <div class=\"field-row\"><span class=\"lbl\">Implementation Date</span><span class=\"val\">{{ frappe.format_date(doc.implementation_date) or '\u2014' }}</span></div>\n      <div class=\"field-row\"><span class=\"lbl\">CAC Filing Required</span><span class=\"val\">{% if doc.cac_filing_required %}\u2705 Yes{% else %}\u2b1c No{% endif %}</span></div>\n    </div>\n  </div>\n\n  <div>\n    <div class=\"signature-box\">Responsible Officer<br><strong>{{ doc.responsible_officer or '________________________' }}</strong></div>\n  </div>\n\n  <div class=\"footer\">\n    <span>Generated: {{ frappe.utils.nowdate() }}</span>\n    <span>Document: {{ doc.name }}</span>\n    <span>\ud83d\udcdc Board Resolution</span>\n  </div>\n</div>",
