 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"print-format\" style=\"font-family: 'Segoe UI', Arial, sans-serif; width: 100%; padding: 8px; color: #333; font-size: 11px;\">\r\n    \r\n    <!-- Header - Compact -->\r\n    <div style=\"border-bottom: 2px solid #4A90E2; padding-bottom: 8px; margin-bottom: 12px; display: flex; justify-content: space-between;\">\r\n        <div>\r\n            {% if letter_head and doc.letter_head %}\r\n                {{ letter_head }}\r\n            {% else %}\r\n                <h2 style=\"margin: 0; color: #4A90E2; font-size: 18px;\">{{ doc.company }}</h2>\r\n                <p style=\"margin: 2px 0; color: #666; font-size: 9px;\">{{ doc.company_address_display or \"\" }}</p>\r\n            {% endif %}\r\n        </div>\r\n        <div style=\"text-align: right;\">\r\n            <h3 style=\"margin: 0; color: #4A90E2; font-size: 16px;\">Sales Invoice</h3>\r\n            <p style=\"margin: 2px 0; font-size: 11px; font-weight: bold;\">{{ doc.name }}</p>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Info Grid - Two columns side by side -->\r\n    <div style=\"display: flex; gap: 15px; margin-bottom: 12px;\">\r\n        <!-- Customer Info -->\r\n        <div style=\"flex: 1; background: #F8F9FA; padding: 8px; border-radius: 4px; border-left: 3px solid #4A90E2;\">\r\n            <strong style=\"font-size: 11px; color: #4A90E2;\">\ud83d\udc64 Customer</strong>\r\n            <p style=\"margin: 3px 0; font-weight: bold; font-size: 11px;\">{{ doc.customer_name }}</p>\r\n            <p style=\"margin: 2px 0; color: #666; font-size: 9px; line-height: 1.3;\">{{ doc.customer_address or doc.address_display or \"\" }}</p>\r\n            {% if doc.contact_person %}\r\n            <p style=\"margin: 2px 0; font-size: 9px;\"><strong>Contact:</strong> {{ doc.contact_person }}</p>\r\n            {% endif %}\r\n            {% if doc.customer_group %}\r\n            <p style=\"margin: 2px 0; font-size: 8px; color: #666;\"><strong>Group:</strong> {{ doc.customer_group }}</p>\r\n            {% endif %}\r\n        </div>\r\n\r\n        <!-- Invoice Info -->\r\n        <div style=\"flex: 1; background: #F8F9FA; padding: 8px; border-radius: 4px; border-left: 3px solid #28A745;\">\r\n            <strong style=\"font-size: 11px; color: #28A745;\">\ud83d\udccb Invoice Info</strong>\r\n            <table style=\"width: 100%; font-size: 9px; margin-top: 5px;\">\r\n                <tr><td style=\"padding: 1px 0;\"><strong>Date:</strong></td><td>{{ doc.get_formatted(\"transaction_date\") }}</td></tr>\r\n                <tr><td style=\"padding: 1px 0;\"><strong>Due Date:</strong></td><td>{{ doc.get_formatted(\"due_date\") if doc.due_date else doc.get_formatted(\"posting_date\") }}</td></tr>\r\n                {% if doc.po_no %}<tr><td style=\"padding: 1px 0;\"><strong>PO No:</strong></td><td>{{ doc.po_no }}</td></tr>{% endif %}\r\n                {% if doc.tax_id %}<tr><td style=\"padding: 1px 0;\"><strong>Tax ID:</strong></td><td>{{ doc.tax_id }}</td></tr>{% endif %}\r\n                <tr><td style=\"padding: 1px 0;\"><strong>Status:</strong></td><td><span style=\"background: #28A745; color: white; padding: 1px 6px; border-radius: 8px; font-size: 8px;\">{{ doc.status }}</span></td></tr>\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Items Table - Compact -->\r\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 9px; margin-bottom: 10px;\">\r\n        <thead>\r\n            <tr style=\"background: #4A90E2; color: white;\">\r\n                <th style=\"padding: 5px 4px; text-align: left;\">#</th>\r\n                <th style=\"padding: 5px 4px; text-align: left;\">Item / Account</th>\r\n                <th style=\"padding: 5px 4px; text-align: center;\">Qty</th>\r\n                <th style=\"padding: 5px 4px; text-align: right;\">Rate</th>\r\n                <th style=\"padding: 5px 4px; text-align: right;\">Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr style=\"border-bottom: 1px solid #E0E0E0;\">\r\n                <td style=\"padding: 4px 4px;\">{{ loop.index }}</td>\r\n                <td style=\"padding: 4px 4px;\">\r\n                    <strong>{{ item.item_name }}</strong>\r\n                    {% if item.description and item.description != item.item_name %}\r\n                    <br><span style=\"color: #666; font-size: 8px;\">{{ item.description|truncate(50) }}</span>\r\n                    {% endif %}\r\n                    <br><span style=\"color: #4A90E2; font-size: 7px;\">Account: {{ item.income_account or item.expense_account or item.account or 'N/A' }}</span>\r\n                    {% if item.cost_center %}\r\n                    <br><span style=\"color: #999; font-size: 7px;\">Cost Center: {{ item.cost_center }}</span>\r\n                    {% endif %}\r\n                </td>\r\n                <td style=\"padding: 4px 4px; text-align: center;\">{{ item.get_formatted(\"qty\") }} {{ item.uom or item.stock_uom }}</td>\r\n                <td style=\"padding: 4px 4px; text-align: right;\">{{ item.get_formatted(\"rate\") }}</td>\r\n                <td style=\"padding: 4px 4px; text-align: right; font-weight: bold;\">{{ item.get_formatted(\"amount\") }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Totals Section with Terms & Conditions Side by Side -->\r\n    <div style=\"display: flex; gap: 15px; margin-bottom: 10px;\">\r\n        \r\n        <!-- Terms & Conditions Section (Left Side) -->\r\n        <div style=\"flex: 1; background: #FFF9E6; padding: 8px; border-radius: 4px; border-left: 3px solid #FFC107;\">\r\n            <strong style=\"font-size: 10px; color: #F57C00;\">\ud83d\udcdd Terms & Conditions</strong>\r\n            <div style=\"color: #555; font-size: 8px; line-height: 1.4; margin-top: 6px; max-height: 150px; overflow-y: auto;\">\r\n                {{ doc.terms or \"No terms specified\" }}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Totals (Right Side) -->\r\n        <div style=\"width: 280px; background: #F8F9FA; padding: 8px; border-radius: 4px;\">\r\n            <table style=\"width: 100%; font-size: 9px;\">\r\n                <tr><td style=\"padding: 3px 0;\">Subtotal:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"total\") }}</td></tr>\r\n                \r\n                <!-- Itemized Taxes - Each on its own row -->\r\n                {% if doc.taxes %}\r\n                    {% for tax in doc.taxes %}\r\n                        {% if tax.tax_amount != 0 %}\r\n                        <tr>\r\n                            <td style=\"padding: 2px 0; color: \r\n                                {% if 'VAT' in tax.description|upper or 'TAX' in tax.description|upper %}#DC3545\r\n                                {% elif 'CAUTION' in tax.description|upper or 'DEPOSIT' in tax.description|upper %}#17A2B8\r\n                                {% else %}#666{% endif %}\">\r\n                                {% if 'VAT' in tax.description|upper %}\ud83c\udfdb\ufe0f VAT{% elif 'CAUTION' in tax.description|upper %}\ud83d\udd12 Caution Fee{% elif 'DEPOSIT' in tax.description|upper %}\ud83d\udcb0 Deposit{% elif 'DISCOUNT' in tax.description|upper %}\ud83c\udff7\ufe0f Discount{% else %}{{ tax.description|truncate(25) }}{% endif %}:\r\n                                <br><span style=\"font-size: 7px; color: #999;\">(Account: {{ tax.account_head }})</span>\r\n                            </td>\r\n                            <td style=\"text-align: right; {% if 'DISCOUNT' in tax.description|upper %}color: #28A745;{% endif %}\">\r\n                                {% if 'DISCOUNT' in tax.description|upper %}-{% endif %}{{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency'}) }}\r\n                            </td>\r\n                        </tr>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n                {% elif doc.total_taxes_and_charges %}\r\n                <tr><td style=\"padding: 2px 0; color: #DC3545;\">\ud83c\udfdb\ufe0f Taxes:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td></tr>\r\n                {% endif %}\r\n                \r\n                {% if doc.discount_amount %}\r\n                <tr><td style=\"padding: 2px 0; color: #28A745;\">\ud83c\udff7\ufe0f Discount:</td><td style=\"text-align: right; color: #28A745;\">-{{ doc.get_formatted(\"discount_amount\") }}</td></tr>\r\n                {% endif %}\r\n                \r\n                {% if doc.rounding_adjustment %}\r\n                <tr><td style=\"padding: 2px 0; color: #666;\">Rounding Adjustment:</td><td style=\"text-align: right;\">{{ doc.get_formatted(\"rounding_adjustment\") }}</td></tr>\r\n                {% endif %}\r\n                \r\n                {% if doc.outstanding_amount and doc.outstanding_amount > 0 and doc.docstatus == 1 %}\r\n                <tr style=\"border-top: 1px dashed #ddd;\">\r\n                    <td style=\"padding: 4px 0 2px 0; color: #DC3545; font-weight: bold;\">Outstanding:</td>\r\n                    <td style=\"padding: 4px 0 2px 0; text-align: right; color: #DC3545; font-weight: bold;\">{{ doc.get_formatted(\"outstanding_amount\") }}</td>\r\n                </tr>\r\n                {% endif %}\r\n                \r\n                <tr style=\"border-top: 2px solid #4A90E2;\">\r\n                    <td style=\"padding: 6px 0 2px 0; font-weight: bold; font-size: 12px;\">Grand Total:</td>\r\n                    <td style=\"padding: 6px 0 2px 0; text-align: right; font-weight: bold; font-size: 12px; color: #4A90E2;\">{{ doc.get_formatted(\"grand_total\") }}</td>\r\n                </tr>\r\n                \r\n                {% if doc.in_words %}\r\n                <tr>\r\n                    <td colspan=\"2\" style=\"padding: 5px 0 0 0; font-size: 8px; color: #666; border-top: 1px dashed #ddd;\">\r\n                        <strong>In Words:</strong> {{ doc.in_words }}\r\n                    </td>\r\n                </tr>\r\n                {% endif %}\r\n            </table>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Bank Account Details Section -->\r\n    {% if doc.company_bank_account or doc.company_bank_account_no %}\r\n    <div style=\"margin-bottom: 8px; padding: 6px; background: #E8F4FD; border-radius: 4px; border-left: 3px solid #4A90E2;\">\r\n        <strong style=\"font-size: 9px;\">\ud83c\udfe6 Bank Account Details</strong>\r\n        <table style=\"width: 100%; font-size: 8px; margin-top: 4px;\">\r\n            <tr>\r\n                {% if doc.company_bank_account %}\r\n                <td style=\"width: 33%;\"><strong>Bank:</strong> {{ doc.company_bank_account }}</td>\r\n                {% endif %}\r\n                {% if doc.company_bank_account_no %}\r\n                <td style=\"width: 33%;\"><strong>Account No:</strong> {{ doc.company_bank_account_no }}</td>\r\n                {% endif %}\r\n                {% if doc.company_bank_iban %}\r\n                <td style=\"width: 34%;\"><strong>IBAN:</strong> {{ doc.company_bank_iban }}</td>\r\n                {% endif %}\r\n            </tr>\r\n            <tr>\r\n                {% if doc.company_bank_swift_code %}\r\n                <td><strong>SWIFT/BIC:</strong> {{ doc.company_bank_swift_code }}</td>\r\n                {% endif %}\r\n                {% if doc.bank_account_holder_name %}\r\n                <td><strong>Holder:</strong> {{ doc.bank_account_holder_name }}</td>\r\n                {% endif %}\r\n                {% if doc.bank_branch %}\r\n                <td><strong>Branch:</strong> {{ doc.bank_branch }}</td>\r\n                {% endif %}\r\n            </tr>\r\n        </table>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Shipping Address (if exists) -->\r\n    {% if doc.shipping_address_name %}\r\n    <div style=\"margin-bottom: 8px; padding: 6px; background: #E8F4FD; border-radius: 4px;\">\r\n        <strong style=\"font-size: 9px;\">\ud83d\ude9a Shipping Address</strong>\r\n        <div style=\"color: #666; font-size: 8px; line-height: 1.3; margin-top: 4px;\">{{ doc.shipping_address or doc.customer_address or \"\" }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Caution Fee Note - Compact -->\r\n    {% set has_caution = false %}\r\n    {% for tax in doc.taxes %}\r\n        {% if 'CAUTION' in tax.description|upper or 'DEPOSIT' in tax.description|upper %}\r\n            {% set has_caution = true %}\r\n        {% endif %}\r\n    {% endfor %}\r\n    \r\n    {% if has_caution %}\r\n    <div style=\"margin-bottom: 6px; padding: 4px 6px; background: #E8F8F5; border-left: 2px solid #17A2B8; font-size: 8px;\">\r\n        <strong>\u2139\ufe0f Caution Fee:</strong> Refundable upon completion of obligations.\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Payment Instructions -->\r\n    {% if doc.payment_terms_template %}\r\n    <div style=\"margin-bottom: 6px; padding: 4px 6px; background: #FFF3E0; border-left: 2px solid #FF9800; font-size: 8px;\">\r\n        <strong>\ud83d\udcb0 Payment Terms:</strong> {{ doc.payment_terms_template }}\r\n    </div>\r\n    {% elif doc.payment_terms %}\r\n    <div style=\"margin-bottom: 6px; padding: 4px 6px; background: #FFF3E0; border-left: 2px solid #FF9800; font-size: 8px;\">\r\n        <strong>\ud83d\udcb0 Payment Terms:</strong> {{ doc.payment_terms }}\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Footer - Compact Signatures -->\r\n    <div style=\"margin-top: 8px; padding-top: 6px; border-top: 1px solid #E0E0E0; display: flex; justify-content: space-between; text-align: center;\">\r\n        <div>\r\n            <div style=\"border-top: 1px solid #999; width: 140px; padding-top: 3px;\"></div>\r\n            <p style=\"margin: 2px 0 0 0; font-size: 8px; color: #666;\">Authorized Signature</p>\r\n        </div>\r\n        <div>\r\n            <div style=\"border-top: 1px solid #999; width: 140px; padding-top: 3px;\"></div>\r\n            <p style=\"margin: 2px 0 0 0; font-size: 8px; color: #666;\">Customer Signature</p>\r\n        </div>\r\n    </div>\r\n    \r\n    <div style=\"text-align: center; margin-top: 5px;\">\r\n        <p style=\"margin: 0; color: #999; font-size: 7px;\">Generated on {{ frappe.utils.now_datetime().strftime('%Y-%m-%d %H:%M') }} | {{ doc.name }}</p>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n@media print {\r\n    body { margin: 0; padding: 0; }\r\n    .print-format { padding: 5mm; margin: 0; }\r\n    @page { size: A4; margin: 8mm; }\r\n}\r\n</style>",
